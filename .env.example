APP_NAME=Stacks
APP_ENV=development
APP_KEY=
APP_URL=stacks.localhost
APP_MAINTENANCE=false

PORT=3000
DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE_PATH=database/stacks.sqlite

STRIPE_SECRET_KEY=""

AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_PASSWORD=
AWS_REGION=us-east-1
AWS_PROFILE=stacks

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADDRESS="no-reply@stacksjs.org"

SEARCH_ENGINE_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# FRONTEND_* variables should not contain any sensitive information
FRONTEND_APP_ENV="${APP_ENV}"
FRONTEND_APP_URL="${APP_URL}"

FRONTEND_STRIPE_PUBLIC_KEY=

# Token/NFT Configuration
# Set TOKENS_MOCK_MODE=true to test without Solana setup
TOKENS_MOCK_MODE=true

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
STORAGE_PROVIDER=arweave
ARWEAVE_GATEWAY=https://arweave.net

# Platform Fee Configuration
PLATFORM_FEE_ENABLED=true
PLATFORM_FEE_BPS=100
PLATFORM_FEE_WALLET=

# Admin Configuration
ADMIN_WALLETS=
