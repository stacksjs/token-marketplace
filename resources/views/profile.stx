<script server>
const pageTitle = 'My Profile | Naked NFTs'
</script>

@layout('default')
@section('title', pageTitle)
@section('content')
  <div class="min-h-screen bg-white">
    <!-- Not connected state -->
    <div class="flex flex-col items-center justify-center py-24">
      <svg class="h-16 w-16 text-gray-3 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
      <h2 class="text-2xl font-bold text-gray-8 mb-2">Connect Your Wallet</h2>
      <p class="text-gray-5 mb-6">Connect your wallet to view your portfolio</p>
      <button onclick="profileConnect(this)" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-8 py-3 rounded-xl transition">
        Connect Wallet
      </button>
    </div>

    <!-- Connected state -->
    <div style="display:none">
      <!-- Profile Header -->
      <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <div class="h-16 w-16 rounded-full bg-gradient-to-br from-pink-8 to-purple-600 flex items-center justify-center">
                <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div>
                <h1 class="text-2xl font-bold text-gray-9 profile-addr"></h1>
                <p class="text-sm text-gray-5 profile-bal"></p>
              </div>
            </div>
            <button onclick="profileDisconnect(this)" class="text-sm text-gray-5 hover:text-pink-8 transition font-medium">
              Disconnect
            </button>
          </div>
          <!-- Portfolio Stats -->
          <div id="portfolio-stats" class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4" style="display:none">
            <div class="bg-gray-1 rounded-lg p-3">
              <div class="text-xs text-gray-4 mb-1">Owned</div>
              <div class="text-lg font-bold text-gray-9" id="stat-owned">0</div>
            </div>
            <div class="bg-gray-1 rounded-lg p-3">
              <div class="text-xs text-gray-4 mb-1">Listed</div>
              <div class="text-lg font-bold text-gray-9" id="stat-listed">0</div>
            </div>
            <div class="bg-gray-1 rounded-lg p-3">
              <div class="text-xs text-gray-4 mb-1">Est. Value</div>
              <div class="text-lg font-bold text-gray-9" id="stat-value">— SOL</div>
            </div>
            <div class="bg-gray-1 rounded-lg p-3">
              <div class="text-xs text-gray-4 mb-1">Total P&amp;L</div>
              <div class="text-lg font-bold" id="stat-pnl">—</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <nav class="flex space-x-8 -mb-px">
            <button onclick="profileSwitchTab(0, this)" class="border-b-2 border-pink-8 text-pink-8 py-4 px-1 text-sm font-medium">My NFTs</button>
            <button onclick="profileSwitchTab(1, this)" class="border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium">My Listings</button>
            <button onclick="profileSwitchTab(2, this)" class="border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium">My Offers</button>
            <button onclick="profileSwitchTab(3, this)" class="border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium">Auctions</button>
            <button onclick="profileSwitchTab(4, this)" class="border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium">History</button>
            <button onclick="profileSwitchTab(5, this)" class="border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium">Escrows</button>
          </nav>
        </div>
      </div>

      <!-- Tab Content -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Loading -->
        <div style="display:none" class="flex justify-center py-12">
          <div class="spinner h-8 w-8 border-4 border-pink-8 border-t-transparent rounded-full"></div>
        </div>

        <!-- Tab content container -->
        <div></div>
      </div>
    </div>

  </div>

  <script client>
    {
      var PROFILE_API = window.API_BASE || 'http://localhost:3008'
      var _profileRoot = document.currentScript.previousElementSibling
      var profileData = null
      var profileWalletAddr = ''
      var activeTab = 0

      // DOM elements found by position:
      // _profileRoot = div.min-h-screen
      //   children[0] = disconnected state
      //   children[1] = connected state
      function getProfileEls() {
        if (!_profileRoot) return null
        var disconnected = _profileRoot.children[0]
        var connected = _profileRoot.children[1]
        if (!connected) return null
        // connected > header(0) > max-w > flex.justify-between > flex(0) > avatar(0) + info(1)
        var headerWrap = connected.children[0]
        var headerInner = headerWrap ? headerWrap.children[0] : null
        var headerFlex = headerInner ? headerInner.children[0] : null
        var leftSide = headerFlex ? headerFlex.children[0] : null
        var infoDiv = leftSide ? leftSide.children[1] : null
        // tabs nav: connected > children[1] > max-w > nav
        var tabsWrap = connected.children[1]
        var tabsInner = tabsWrap ? tabsWrap.children[0] : null
        var tabsNav = tabsInner ? tabsInner.children[0] : null
        // content area: connected > children[2]
        var contentArea = connected.children[2]
        var loadingEl = contentArea ? contentArea.children[0] : null
        var contentEl = contentArea ? contentArea.children[1] : null

        return {
          disconnected: disconnected,
          connected: connected,
          addrEl: infoDiv ? infoDiv.children[0] : null,
          balEl: infoDiv ? infoDiv.children[1] : null,
          tabsNav: tabsNav,
          loadingEl: loadingEl,
          contentEl: contentEl
        }
      }

      function profileShowConnected(show) {
        var els = getProfileEls()
        if (!els) return
        if (els.disconnected) els.disconnected.style.display = show ? 'none' : ''
        if (els.connected) els.connected.style.display = show ? '' : 'none'
      }

      function getProfileProvider() {
        if (window.phantom?.solana) return window.phantom.solana
        if (window.solana?.isPhantom) return window.solana
        if (window.solflare) return window.solflare
        if (window.backpack) return window.backpack
        if (window.solana) return window.solana
        return null
      }

      function nftCard(nft, extraHtml) {
        return '<div class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-md transition cursor-pointer">'
          + '<div class="aspect-square"><img src="' + (nft.image_url || nft.imageUrl || '/assets/images/anonymouse.png') + '" alt="' + nft.name + '" class="w-full h-full object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" /></div>'
          + '<div class="p-3">'
          + '<p class="font-semibold text-gray-9 truncate">' + nft.name + '</p>'
          + (nft.price ? '<p class="text-sm font-semibold text-pink-8 mt-1">' + nft.price + ' SOL</p>' : '')
          + (nft.rarity_rank ? '<p class="text-xs text-gray-5">Rank #' + nft.rarity_rank + '</p>' : '')
          + (nft.is_for_sale ? '<span class="inline-block mt-1 text-xs bg-pink-100 text-pink-700 py-0.5 px-2 rounded">For Sale</span>' : '')
          + (extraHtml || '')
          + '</div></div>'
      }

      function emptyState(msg) {
        return '<div class="text-center py-12"><svg class="mx-auto h-12 w-12 text-gray-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg><p class="mt-4 text-gray-5">' + msg + '</p></div>'
      }

      function renderTabContent() {
        var els = getProfileEls()
        if (!els || !els.contentEl) return
        if (!profileData) { els.contentEl.innerHTML = ''; return }

        if (activeTab === 0) {
          if (profileData.ownedNfts && profileData.ownedNfts.length > 0) {
            els.contentEl.innerHTML = '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">' + profileData.ownedNfts.map(function(nft) {
              var extra = '<button onclick="profileListNft(' + nft.id + ', this)" class="mt-2 w-full bg-pink-8 hover:bg-pink-9 text-white text-xs font-semibold py-2 rounded transition">List for Sale</button>'
              extra += '<button onclick="profileToggleAuctionForm(this)" class="mt-1 w-full bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold py-2 rounded transition">Create Auction</button>'
              extra += '<div style="display:none" class="mt-2 p-2 bg-gray-50 rounded">'
                + '<select class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-auction-type"><option value="english">English</option><option value="dutch">Dutch</option></select>'
                + '<input type="number" step="0.01" min="0" placeholder="Start Price (SOL)" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-auction-start" />'
                + '<input type="number" step="0.01" min="0" placeholder="Reserve Price (SOL)" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-auction-reserve" />'
                + '<input type="number" min="1" placeholder="Duration (hours)" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-auction-duration" />'
                + '<button onclick="profileCreateAuction(' + nft.id + ', this)" class="w-full bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold py-1.5 rounded transition">Submit Auction</button>'
                + '</div>'
              extra += '<button onclick="profileToggleEscrowForm(this)" class="mt-1 w-full bg-gray-600 hover:bg-gray-700 text-white text-xs font-semibold py-2 rounded transition">Create Escrow</button>'
              extra += '<div style="display:none" class="mt-2 p-2 bg-gray-50 rounded">'
                + '<input type="text" placeholder="Buyer Wallet" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-escrow-buyer" />'
                + '<input type="number" step="0.01" min="0" placeholder="Price (SOL)" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-escrow-price" />'
                + '<button onclick="profileCreateEscrow(' + nft.id + ', this)" class="w-full bg-gray-600 hover:bg-gray-700 text-white text-xs font-semibold py-1.5 rounded transition">Submit Escrow</button>'
                + '</div>'
              return nftCard(nft, extra)
            }).join('') + '</div>'
          } else {
            els.contentEl.innerHTML = emptyState('No NFTs in your wallet yet')
          }
        } else if (activeTab === 1) {
          if (profileData.listings && profileData.listings.length > 0) {
            els.contentEl.innerHTML = '<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">' + profileData.listings.map(function(nft) {
              var extra = '<button onclick="profileDelistNft(' + nft.id + ', this)" class="mt-2 w-full bg-gray-7 hover:bg-gray-8 text-white text-xs font-semibold py-2 rounded transition">Delist</button>'
              extra += '<button onclick="profileToggleOfferForm(this)" class="mt-1 w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-2 rounded transition">Make Offer</button>'
              extra += '<div style="display:none" class="mt-2 p-2 bg-gray-50 rounded">'
                + '<input type="number" step="0.01" min="0" placeholder="Amount (SOL)" class="w-full h-7 rounded border border-gray-300 px-1 text-xs mb-1 profile-offer-amount" />'
                + '<button onclick="profileMakeOffer(' + nft.id + ', this)" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-1.5 rounded transition">Submit Offer</button>'
                + '</div>'
              return nftCard(nft, extra)
            }).join('') + '</div>'
          } else {
            els.contentEl.innerHTML = emptyState('No active listings')
          }
        } else if (activeTab === 2) {
          var html = ''
          if (profileData.sentOffers && profileData.sentOffers.length > 0) {
            html += '<h3 class="text-lg font-semibold text-gray-8 mb-3">Sent Offers</h3><div class="space-y-2 mb-8">'
            profileData.sentOffers.forEach(function(o) {
              var sol = (Number(o.amount) / 1e9).toFixed(4)
              var nftName = o.nft_name || ('NFT #' + o.nft_id)
              var imgSrc = o.nft_image_url || '/assets/images/anonymouse.png'
              var statusClass = o.status === 'accepted' ? 'bg-emerald-100 text-emerald-700' : o.status === 'rejected' || o.status === 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'
              var badge = '<span class="text-xs font-medium px-2 py-1 rounded-full ' + statusClass + '">' + o.status + '</span>'
              html += '<div class="bg-white rounded-lg p-4 flex items-center justify-between shadow-sm">'
                + '<div class="flex items-center space-x-3">'
                + '<img src="' + imgSrc + '" alt="' + nftName + '" class="h-10 w-10 rounded-lg object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" />'
                + '<div><p class="font-medium text-gray-8">' + nftName + '</p><p class="text-sm text-gray-5">' + sol + ' SOL</p></div>'
                + '</div>'
                + badge
                + '</div>'
            })
            html += '</div>'
          }
          if (profileData.receivedOffers && profileData.receivedOffers.length > 0) {
            html += '<h3 class="text-lg font-semibold text-gray-8 mb-3">Received Offers</h3><div class="space-y-2">'
            profileData.receivedOffers.forEach(function(o) {
              var addr = o.buyer_wallet_address || ''
              var sol = (Number(o.amount) / 1e9).toFixed(4)
              var nftName = o.nft_name || ('NFT #' + o.nft_id)
              var imgSrc = o.nft_image_url || '/assets/images/anonymouse.png'
              var statusClass = o.status === 'accepted' ? 'bg-emerald-100 text-emerald-700' : o.status === 'rejected' || o.status === 'cancelled' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'
              var badge = '<span class="text-xs font-medium px-2 py-1 rounded-full ' + statusClass + '">' + o.status + '</span>'
              html += '<div class="bg-white rounded-lg p-4 flex items-center justify-between shadow-sm">'
                + '<div class="flex items-center space-x-3">'
                + '<img src="' + imgSrc + '" alt="' + nftName + '" class="h-10 w-10 rounded-lg object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" />'
                + '<div><p class="font-medium text-gray-8">' + nftName + '</p><p class="text-sm text-gray-5">' + sol + ' SOL from ' + addr.slice(0,4) + '...' + addr.slice(-4) + '</p></div>'
                + '</div>'
                + '<div class="flex items-center space-x-2">' + badge + '<button onclick="profileAcceptOffer(\'' + o.uuid + '\', this)" class="bg-pink-8 hover:bg-pink-9 text-white text-xs font-semibold py-2 px-4 rounded transition">Accept</button></div>'
                + '</div>'
            })
            html += '</div>'
          }
          els.contentEl.innerHTML = html || emptyState('No offers yet')
        } else if (activeTab === 3) {
          if (profileData.auctions && profileData.auctions.length > 0) {
            var html = '<div class="space-y-3">'
            profileData.auctions.forEach(function(a) {
              var bid = Number(a.current_bid || a.starting_price).toFixed(4)
              var info = a.status === 'active' ? 'Ends: ' + new Date(a.end_time).toLocaleString() : a.status
              var cancelBtn = a.status === 'active' ? '<button onclick="profileCancelAuction(\'' + a.uuid + '\', this)" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold py-2 px-4 rounded transition">Cancel</button>' : ''
              var bidSection = a.status === 'active' ? '<div class="mt-3 flex items-center space-x-2"><input type="number" step="0.01" min="0" placeholder="Bid (SOL)" class="h-8 w-32 rounded border border-gray-300 px-2 text-xs focus:border-pink-8 focus:ring-pink-8 profile-bid-amount" /><button onclick="profilePlaceBid(\'' + a.uuid + '\', this)" class="bg-pink-8 hover:bg-pink-9 text-white text-xs font-semibold py-2 px-4 rounded transition">Place Bid</button></div>' : ''
              html += '<div class="bg-white rounded-lg p-4 shadow-sm"><div class="flex items-center justify-between"><div><p class="font-medium text-gray-8">NFT #' + a.nft_id + '</p><p class="text-sm text-gray-5">' + a.auction_type + ' &middot; ' + a.status + '</p></div><div class="flex items-center space-x-3"><div class="text-right"><p class="font-semibold text-gray-9">' + bid + ' SOL</p><p class="text-xs text-gray-5">' + info + '</p></div>' + cancelBtn + '</div></div>' + bidSection + '</div>'
            })
            html += '</div>'
            els.contentEl.innerHTML = html
          } else {
            els.contentEl.innerHTML = emptyState('No auctions')
          }
        } else if (activeTab === 4) {
          if (profileData.transactions && profileData.transactions.length > 0) {
            var html = '<div class="bg-white rounded-lg shadow-sm overflow-hidden"><table class="w-full"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left text-xs font-medium text-gray-5 uppercase">Date</th><th class="px-4 py-3 text-left text-xs font-medium text-gray-5 uppercase">Type</th><th class="px-4 py-3 text-left text-xs font-medium text-gray-5 uppercase">Status</th><th class="px-4 py-3 text-left text-xs font-medium text-gray-5 uppercase">Mint</th></tr></thead><tbody class="divide-y divide-gray-100">'
            profileData.transactions.forEach(function(t) {
              var statusClass = t.status === 'confirmed' ? 'bg-emerald-100 text-emerald-700' : t.status === 'failed' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'
              html += '<tr><td class="px-4 py-3 text-sm text-gray-7">' + new Date(t.created_at).toLocaleDateString() + '</td><td class="px-4 py-3 text-sm text-gray-7">Mint</td><td class="px-4 py-3"><span class="text-xs font-medium px-2 py-1 rounded-full ' + statusClass + '">' + t.status + '</span></td><td class="px-4 py-3 text-sm text-gray-5 font-mono">' + (t.mint_address || '').slice(0,8) + '...</td></tr>'
            })
            html += '</tbody></table></div>'
            els.contentEl.innerHTML = html
          } else {
            els.contentEl.innerHTML = emptyState('No transaction history')
          }
        } else if (activeTab === 5) {
          if (profileData.escrows && profileData.escrows.length > 0) {
            var html = '<div class="space-y-3">'
            profileData.escrows.forEach(function(e) {
              var price = Number(e.price || 0).toFixed(4)
              var buyer = e.buyer_wallet_address || ''
              var shortBuyer = buyer ? buyer.slice(0, 4) + '...' + buyer.slice(-4) : ''
              var actions = ''
              if (e.status === 'pending') {
                actions = '<button onclick="profileSettleEscrow(\'' + e.uuid + '\', this)" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-2 px-4 rounded transition">Settle</button>'
                  + '<button onclick="profileCancelEscrow(\'' + e.uuid + '\', this)" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold py-2 px-4 rounded transition ml-2">Cancel</button>'
              }
              html += '<div class="bg-white rounded-lg p-4 shadow-sm"><div class="flex items-center justify-between"><div><p class="font-medium text-gray-8">NFT #' + e.nft_id + '</p><p class="text-sm text-gray-5">' + price + ' SOL &middot; Buyer: ' + shortBuyer + ' &middot; ' + e.status + '</p></div><div class="flex items-center space-x-2">' + actions + '</div></div></div>'
            })
            html += '</div>'
            els.contentEl.innerHTML = html
          } else {
            els.contentEl.innerHTML = emptyState('No escrows')
          }
        }
      }

      window.profileSwitchTab = function(tab, btn) {
        activeTab = tab
        var nav = btn.parentNode
        if (nav) {
          var buttons = nav.children
          for (var i = 0; i < buttons.length; i++) {
            if (i === tab) {
              buttons[i].className = 'border-b-2 border-pink-8 text-pink-8 py-4 px-1 text-sm font-medium'
            } else {
              buttons[i].className = 'border-b-2 border-transparent text-gray-5 hover:text-gray-7 hover:border-gray-300 py-4 px-1 text-sm font-medium'
            }
          }
        }
        renderTabContent()
      }

      window.profileDisconnect = async function(btn) {
        try {
          await fetch(PROFILE_API + '/wallet/disconnect', { method: 'POST' })
        } catch (_) {}
        var provider = getProfileProvider()
        if (provider) { try { await provider.disconnect() } catch (_) {} }
        profileWalletAddr = ''
        profileData = null
        localStorage.removeItem('wallet_addr')
        profileShowConnected(false)
      }

      async function fetchProfileBalance(addr) {
        var els = getProfileEls()
        if (els && els.balEl) els.balEl.textContent = 'Loading balance...'
        try {
          var res = await fetch(PROFILE_API + '/wallet/balance/' + addr)
          var data = await res.json()
          if (data.balance !== undefined) {
            if (els && els.balEl) els.balEl.textContent = Number(data.balance).toFixed(4) + ' SOL'
          }
        } catch (_) {
          if (els && els.balEl) els.balEl.textContent = ''
        }
      }

      window.profileConnect = async function(btn) {
        var provider = getProfileProvider()
        if (!provider) {
          window.open('https://phantom.app/', '_blank')
          return
        }
        try {
          var resp = await provider.connect()
          var addr = resp.publicKey.toString()
          var res = await fetch(PROFILE_API + '/wallet/connect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ walletAddress: addr }),
          })
          var data = await res.json()
          if (data.success) {
            profileWalletAddr = data.address
            var els = getProfileEls()
            if (els && els.addrEl) els.addrEl.textContent = addr.slice(0, 6) + '...' + addr.slice(-4)
            if (els && els.balEl) els.balEl.textContent = ''
            profileShowConnected(true)
            loadProfileData(data.address)
          }
        } catch (err) {
          console.error('Profile wallet connect failed:', err)
        }
      }

      async function loadProfileData(address) {
        var els = getProfileEls()
        if (els && els.loadingEl) els.loadingEl.style.display = ''
        if (els && els.contentEl) els.contentEl.innerHTML = ''
        try {
          var res = await fetch(PROFILE_API + '/marketplace/profile/' + address)
          profileData = await res.json()
        } catch (err) {
          console.error('Failed to load profile:', err)
        } finally {
          if (els && els.loadingEl) els.loadingEl.style.display = 'none'
          renderTabContent()
        }
        // Fetch portfolio data in parallel
        try {
          var portfolioRes = await fetch(PROFILE_API + '/marketplace/profile/' + address + '/portfolio')
          if (portfolioRes.ok) {
            var portfolio = await portfolioRes.json()
            var statsEl = document.getElementById('portfolio-stats')
            if (statsEl) statsEl.style.display = ''
            var ownedEl = document.getElementById('stat-owned')
            var listedEl = document.getElementById('stat-listed')
            var valueEl = document.getElementById('stat-value')
            var pnlEl = document.getElementById('stat-pnl')
            if (ownedEl) ownedEl.textContent = portfolio.ownedCount || 0
            if (listedEl) listedEl.textContent = portfolio.listedCount || 0
            if (valueEl) valueEl.textContent = (portfolio.estimatedValue || 0).toFixed(2) + ' SOL'
            if (pnlEl) {
              var pnl = portfolio.totalPnl || 0
              pnlEl.textContent = (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + ' SOL'
              pnlEl.className = 'text-lg font-bold ' + (pnl >= 0 ? 'text-green-6' : 'text-red-6')
            }
          }
        } catch (_) {}
      }

      // Check if wallet already connected on page load
      function initProfile(addr) {
        profileWalletAddr = addr
        var els = getProfileEls()
        if (els && els.addrEl) els.addrEl.textContent = addr.slice(0, 6) + '...' + addr.slice(-4)
        if (els && els.balEl) els.balEl.textContent = ''
        profileShowConnected(true)
        loadProfileData(addr)
        fetchProfileBalance(addr)
      }

      window.profileListNft = async function(nftId, btn) {
        var price = prompt('Enter listing price in SOL:')
        if (!price || isNaN(Number(price)) || Number(price) <= 0) return
        btn.disabled = true
        btn.textContent = 'Listing...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/list', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nftId: nftId, price: Number(price), sellerWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) { if (window.Toast) Toast.error(data.error); btn.disabled = false; btn.textContent = 'List for Sale'; return }
          if (window.Toast) Toast.info('Please approve in your wallet...')
          var signature = await WalletManager.signAndSend(data.transaction.serializedTransaction)
          var confirmRes = await fetch(PROFILE_API + '/nfts/confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signature: signature, nftId: nftId, action: 'list', metadata: { price: Number(price) } })
          })
          var confirmData = await confirmRes.json()
          if (confirmData.success) {
            if (window.Toast) Toast.success('NFT listed for ' + price + ' SOL')
            loadProfileData(profileWalletAddr)
          } else {
            if (window.Toast) Toast.error(confirmData.error || 'Listing failed')
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to list NFT')
        }
        btn.disabled = false
        btn.textContent = 'List for Sale'
      }

      window.profileDelistNft = async function(nftId, btn) {
        btn.disabled = true
        btn.textContent = 'Delisting...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/delist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nftId: nftId, sellerWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) { if (window.Toast) Toast.error(data.error); btn.disabled = false; btn.textContent = 'Delist'; return }
          if (window.Toast) Toast.info('Please approve in your wallet...')
          var signature = await WalletManager.signAndSend(data.transaction.serializedTransaction)
          var confirmRes = await fetch(PROFILE_API + '/nfts/confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signature: signature, nftId: nftId, action: 'delist' })
          })
          var confirmData = await confirmRes.json()
          if (confirmData.success) {
            if (window.Toast) Toast.success('NFT delisted')
            loadProfileData(profileWalletAddr)
          } else {
            if (window.Toast) Toast.error(confirmData.error || 'Delist failed')
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to delist NFT')
        }
        btn.disabled = false
        btn.textContent = 'Delist'
      }

      window.profileAcceptOffer = async function(offerId, btn) {
        btn.disabled = true
        btn.textContent = 'Accepting...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/offer/accept', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ offerId: offerId, sellerWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) { if (window.Toast) Toast.error(data.error); btn.disabled = false; btn.textContent = 'Accept'; return }
          if (window.Toast) Toast.info('Please approve in your wallet...')
          var signature = await WalletManager.signAndSend(data.transaction.serializedTransaction)
          var confirmRes = await fetch(PROFILE_API + '/nfts/confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ signature: signature, nftId: null, action: 'accept_offer', metadata: { offerId: offerId } })
          })
          var confirmData = await confirmRes.json()
          if (confirmData.success) {
            if (window.Toast) Toast.success('Offer accepted!')
            loadProfileData(profileWalletAddr)
          } else {
            if (window.Toast) Toast.error(confirmData.error || 'Accept failed')
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to accept offer')
        }
        btn.disabled = false
        btn.textContent = 'Accept'
      }

      window.profileCancelAuction = async function(auctionId, btn) {
        if (!confirm('Are you sure you want to cancel this auction?')) return
        btn.disabled = true
        btn.textContent = 'Cancelling...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/auction/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ auctionId: auctionId, sellerWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.success) {
            if (window.Toast) Toast.success('Auction cancelled')
            loadProfileData(profileWalletAddr)
          } else {
            if (window.Toast) Toast.error(data.error || 'Cancel failed')
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to cancel auction')
        }
        btn.disabled = false
        btn.textContent = 'Cancel'
      }

      window.profileToggleOfferForm = function(btn) {
        var form = btn.nextElementSibling
        if (form) form.style.display = form.style.display === 'none' ? '' : 'none'
      }

      window.profileMakeOffer = async function(nftId, btn) {
        var amountInput = btn.previousElementSibling
        var amount = amountInput ? amountInput.value : ''
        if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) {
          if (window.Toast) Toast.error('Enter a valid offer amount')
          return
        }
        btn.disabled = true
        btn.textContent = 'Submitting...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/offer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nftId: Number(nftId), amount: Number(amount), bidderWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Offer submitted!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to submit offer')
        }
        btn.disabled = false
        btn.textContent = 'Submit Offer'
      }

      window.profileToggleAuctionForm = function(btn) {
        var form = btn.nextElementSibling
        if (form) form.style.display = form.style.display === 'none' ? '' : 'none'
      }

      window.profileCreateAuction = async function(nftId, btn) {
        var form = btn.parentNode
        var typeEl = form.children[0]
        var startEl = form.children[1]
        var reserveEl = form.children[2]
        var durationEl = form.children[3]
        var auctionType = typeEl ? typeEl.value : 'english'
        var startPrice = startEl ? startEl.value : ''
        var reservePrice = reserveEl ? reserveEl.value : ''
        var duration = durationEl ? durationEl.value : ''
        if (!startPrice || !duration) {
          if (window.Toast) Toast.error('Start price and duration are required')
          return
        }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/auction', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nftId: Number(nftId),
              auctionType: auctionType,
              startingPrice: Number(startPrice),
              reservePrice: reservePrice ? Number(reservePrice) : undefined,
              durationHours: Number(duration),
              sellerWalletAddress: profileWalletAddr
            })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Auction created!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to create auction')
        }
        btn.disabled = false
        btn.textContent = 'Submit Auction'
      }

      window.profilePlaceBid = async function(auctionId, btn) {
        var amountInput = btn.previousElementSibling
        var amount = amountInput ? amountInput.value : ''
        if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) {
          if (window.Toast) Toast.error('Enter a valid bid amount')
          return
        }
        btn.disabled = true
        btn.textContent = 'Bidding...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/auction/bid', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ auctionId: auctionId, amount: Number(amount), bidderWalletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Bid placed!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to place bid')
        }
        btn.disabled = false
        btn.textContent = 'Place Bid'
      }

      window.profileToggleEscrowForm = function(btn) {
        var form = btn.nextElementSibling
        if (form) form.style.display = form.style.display === 'none' ? '' : 'none'
      }

      window.profileCreateEscrow = async function(nftId, btn) {
        var form = btn.parentNode
        var buyerInput = form.children[0]
        var priceInput = form.children[1]
        var buyer = buyerInput ? buyerInput.value.trim() : ''
        var price = priceInput ? priceInput.value : ''
        if (!buyer || !price) {
          if (window.Toast) Toast.error('Buyer wallet and price are required')
          return
        }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/escrow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nftId: Number(nftId), sellerWalletAddress: profileWalletAddr, buyerWalletAddress: buyer, price: Number(price) })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Escrow created!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to create escrow')
        }
        btn.disabled = false
        btn.textContent = 'Submit Escrow'
      }

      window.profileSettleEscrow = async function(escrowId, btn) {
        btn.disabled = true
        btn.textContent = 'Settling...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/escrow/settle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ escrowId: escrowId, walletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Escrow settled!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to settle escrow')
        }
        btn.disabled = false
        btn.textContent = 'Settle'
      }

      window.profileCancelEscrow = async function(escrowId, btn) {
        btn.disabled = true
        btn.textContent = 'Cancelling...'
        try {
          var res = await fetch(PROFILE_API + '/nfts/escrow/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ escrowId: escrowId, walletAddress: profileWalletAddr })
          })
          var data = await res.json()
          if (data.error) {
            if (window.Toast) Toast.error(data.error)
          } else {
            if (window.Toast) Toast.success('Escrow cancelled!')
            loadProfileData(profileWalletAddr)
          }
        } catch (err) {
          if (window.Toast) Toast.error('Failed to cancel escrow')
        }
        btn.disabled = false
        btn.textContent = 'Cancel'
      }

      var initProvider = getProfileProvider()
      if (initProvider && initProvider.isConnected && initProvider.publicKey) {
        initProfile(initProvider.publicKey.toString())
      } else {
        var _savedAddr = localStorage.getItem('wallet_addr')
        if (_savedAddr) {
          initProfile(_savedAddr)
        }
      }
    }
  </script>
@endsection
