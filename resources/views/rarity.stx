<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Check the rarity of your NFTs on Naked NFTs marketplace">
  <title>Rarity | Naked NFTs - Cross-Chain NFT Marketplace</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script>
    // Site Information
    export const siteInfo = {
      name: "NAKED /NFTs",
      tagline: "Discover & collect NFTs in the world's first cross-chain marketplace",
      year: 2022
    };
  </script>
</head>
<body class="antialiased font-sans bg-white text-gray-9">
  <div class="min-h-screen w-full">

    <!-- Header -->
    <header>
      <nav class="border-b border-gray-7 bg-gray-9">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-20 justify-between">
            <div class="flex justify-between">
              <div class="flex shrink-0 items-center">
                <a href="/" class="rounded-md focus:bg-pink-custom-2 focus:outline-none lg:px-2">
                  <h1 class="font-serif text-xl uppercase text-gray-50 md:text-2xl font-medium">
                    Naked <span class="text-pink-8"> /NFT<span class="lowercase">s</span> </span>
                  </h1>
                </a>
              </div>

              <div class="font-gilroy hidden md:ml-6 md:flex md:items-center lg:space-x-4">
                <a href="/" class="rounded-md px-3 py-2 font-bold text-gray-100 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none">
                  Home
                </a>
                <a href="/collections" class="rounded-md px-3 py-2 font-bold text-gray-100 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none">
                  Explore
                </a>
                <a href="/rarity" class="rounded-md px-3 py-2 font-bold text-pink-8 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none">
                  Rarity
                </a>
                <a href="#" data-tippy-content="Coming soon" class="rounded-md px-3 py-2 font-bold text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none">
                  Staking
                </a>
                <a href="#" data-tippy-content="Our DAO & DAO framework. Coming soon." class="rounded-md px-3 py-2 font-bold text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none">
                  Grassroots
                </a>
              </div>
            </div>

            <div class="hidden items-center md:flex">
              <div class="shrink-0">
                <button type="button" class="inline-flex items-center justify-center rounded-md border border-transparent bg-pink-8 px-4 py-2 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9 focus:outline-none focus:ring-2 focus:ring-pink-700 focus:ring-offset-2">
                  Connect Wallet
                </button>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-4">
      <!-- Page Header -->
      <div class="items-baseline block pt-16 pb-6 border-b border-gray-200 lg:flex">
        <h1 class="text-4xl font-extrabold tracking-tight w-100 text-gray-8">What's Your Rarity?</h1>

        <div class="flex items-center justify-between w-full pt-6 lg:pt-0">
          <!-- Search Input -->
          <div class="lg:pl-12">
            <label for="search" class="hidden text-sm font-medium text-gray-7">Quick search</label>
            <div class="relative flex items-center w-64 mx-auto">
              <input
                type="text"
                name="search"
                id="search"
                class="block w-full h-12 pl-4 pr-12 transition duration-150 ease-in-out border-none rounded-md bg-gray-0.25 cursor-pointer placeholder:text-gray-3 focus:ring-2 focus:ring-pink-8 sm:text-sm"
                placeholder="Search Collections..."
              />
              <div class="absolute inset-y-0 right-0 flex py-1.5 pr-1.5">
                <kbd class="inline-flex items-center px-2 mr-2 font-sans text-sm font-medium text-gray-400 border border-gray-200 rounded">
                  ⌘K
                </kbd>
              </div>
            </div>
          </div>

          <!-- Sort & Filter -->
          <div class="flex items-center justify-end space-x-4">
            <!-- Sort Dropdown -->
            <div class="relative">
              <button type="button" class="inline-flex items-center justify-end text-sm font-medium text-gray-7 hover:text-gray-900">
                Relevant
                <svg class="flex-shrink-0 w-5 h-5 ml-1 -mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
            </div>

            <!-- Currency Selector -->
            <div class="relative">
              <button type="button" class="inline-flex items-center justify-center text-sm font-medium text-gray-7 hover:text-gray-900">
                ◎
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Collections Grid -->
      <section aria-labelledby="collections-heading" class="pt-6">
        <h2 id="collections-heading" class="sr-only">Collections</h2>

        <div class="max-w-2xl px-4 py-16 mx-auto sm:py-12 sm:px-6 lg:max-w-full lg:px-2">
          <div class="grid grid-cols-1 mt-6 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
            @foreach(rarityCollections as collection)
              <div>
                <a href="/rarity/{{ collection.slug }}" class="group">
                  <div class="w-full overflow-hidden transition duration-150 ease-in-out bg-gray-200 rounded-md min-h-80 aspect-w-1 aspect-h-1 group-hover:opacity-75 lg:aspect-none lg:h-80">
                    <img
                      src="{{ collection.profile_image }}"
                      alt="{{ collection.name }}"
                      class="object-cover object-center w-full h-full lg:h-full lg:w-full"
                    />
                  </div>
                </a>

                <div class="flex justify-between mt-4">
                  <div class="flex items-center w-11/12">
                    <sub class="text-gray-5">{{ collection.symbol }}</sub>
                    <p class="pt-2 pl-1 text-lg font-semibold truncate text-gray-6">{{ collection.name }}</p>
                  </div>

                  @if(collection.twitter)
                    <a href="{{ collection.twitter }}" target="_blank" class="pt-2 text-gray-3 hover:text-pink-8">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9.31 18.25C14.7819 18.25 17.7744 13.4403 17.7744 9.26994C17.7744 9.03682 17.9396 8.83015 18.152 8.73398C18.8803 8.40413 19.8249 7.49943 18.8494 5.97828C18.2031 6.32576 17.6719 6.51562 16.9603 6.74448C15.834 5.47393 13.9495 5.41269 12.7514 6.60761C11.9785 7.37819 11.651 8.52686 11.8907 9.62304C9.49851 9.49618 6.69788 7.73566 5.1875 5.76391C4.39814 7.20632 4.80107 9.05121 6.10822 9.97802C5.63461 9.96302 5.1716 9.82741 4.75807 9.58305V9.62304C4.75807 11.1255 5.75654 12.4191 7.1444 12.7166C6.70672 12.8435 6.24724 12.8622 5.80131 12.771C6.19128 14.0565 7.87974 15.4989 9.15272 15.5245C8.09887 16.4026 6.79761 16.8795 5.45806 16.8782C5.22126 16.8776 4.98504 16.8626 4.75 16.8326C6.11076 17.7588 7.69359 18.25 9.31 18.2475V18.25Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </a>
                  @elseif(collection.discord)
                    <a href="{{ collection.discord }}" target="_blank" class="pt-2 text-gray-3 hover:text-pink-8">
                      <svg width="24" height="24" viewBox="0 0 22 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18.98 2.69C17.3 1.35 14.9 0.98 13.86 0.87H13.82C13.66 0.87 13.51 0.96 13.46 1.11C13.37 1.34 13.51 1.59 13.74 1.63C14.91 1.87 16.26 2.29 17.49 3.06C17.74 3.21 17.8 3.55 17.6 3.78C17.44 3.96 17.17 3.98 16.96 3.86C14.56 2.38 11.58 2.3 11 2.3C10.42 2.3 7.44 2.38 5.04 3.86C4.83 3.98 4.56 3.96 4.4 3.78C4.2 3.55 4.26 3.21 4.51 3.06C5.74 2.29 7.09 1.87 8.26 1.63C8.49 1.59 8.63 1.34 8.54 1.11C8.49 0.96 8.34 0.87 8.18 0.87H8.14C7.1 0.98 4.7 1.35 3.02 2.69C2.04 3.6 0.09 8.83 0 13.46C0 13.77 0.08 14.08 0.26 14.33C1.43 15.98 3.97 16.97 5.89 17.11C6.18 17.13 6.46 17 6.63 16.76L6.65 16.74C7 16.26 6.79 15.58 6.23 15.37C4.63 14.78 3.81 14.08 3.76 14.03C3.56 13.85 3.54 13.55 3.71 13.35C3.89 13.15 4.19 13.13 4.39 13.31C4.42 13.33 6.64 15.22 11 15.22C15.36 15.22 17.58 13.33 17.61 13.31C17.81 13.13 18.11 13.15 18.29 13.35C18.46 13.55 18.44 13.85 18.24 14.03C18.19 14.08 17.37 14.78 15.77 15.37C15.21 15.58 15 16.26 15.35 16.74L15.37 16.76C15.54 17 15.82 17.13 16.11 17.11C18.03 16.97 20.57 15.98 21.74 14.33C21.92 14.08 22 13.77 22 13.46C21.91 8.83 19.96 3.6 18.98 2.69ZM7.89 11.87C6.97 11.87 6.22 11.01 6.22 9.96C6.22 8.9 6.97 8.04 7.89 8.04C8.82 8.04 9.56 8.9 9.56 9.96C9.56 11.01 8.82 11.87 7.89 11.87ZM14.11 11.87C13.18 11.87 12.44 11.01 12.44 9.96C12.44 8.9 13.18 8.04 14.11 8.04C15.03 8.04 15.78 8.9 15.78 9.96C15.78 11.01 15.03 11.87 14.11 11.87Z" fill="currentColor"/>
                      </svg>
                    </a>
                  @elseif(collection.website)
                    <a href="{{ collection.website }}" target="_blank" class="pt-2 text-gray-3 hover:text-pink-8">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M3.6 9H20.4M3.6 15H20.4M11.5 3C9.81 5.69 9 8.77 9 12C9 15.23 9.81 18.31 11.5 21M12.5 3C14.19 5.69 15 8.77 15 12C15 15.23 14.19 18.31 12.5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  @endif
                </div>
              </div>
            @endforeach
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-gray-7 bg-gray-9" aria-labelledby="footer-heading">
      <h2 id="footer-heading" class="sr-only">Footer</h2>
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16 lg:px-8">
        <div class="xl:grid xl:grid-cols-3 xl:gap-8">
          <!-- Logo and Description -->
          <div class="space-y-8 xl:col-span-1">
            <h1 class="font-serif text-2xl uppercase text-gray-50 md:text-3xl lg:text-4xl">
              <a href="/" class="rounded-md focus:bg-pink-custom-2 focus:outline-none lg:px-2">
                Naked <span class="text-pink-8"> /NFT<span class="lowercase">s</span> </span>
              </a>
            </h1>
            <p class="text-base text-gray-5">
              Discover & collect NFTs in—what will be—the world's first cross-chain marketplace, supporting SOL, ETH, ADA, and more. Coming 2022.
            </p>
          </div>

          <!-- Footer Links -->
          <div class="mt-12 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
            <div class="md:grid md:grid-cols-2 md:gap-8">
              <!-- Collections -->
              <div>
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-6 lg:px-2">Collections</h3>
                <ul role="list" class="mt-4 space-y-4">
                  <li>
                    <a href="/collections" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      All NFTs
                    </a>
                  </li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Popular</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Trending</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Recent</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">New</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Our Picks</span></li>
                </ul>
              </div>

              <!-- Tools -->
              <div class="mt-12 md:mt-0">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-6 lg:px-2">Tools</h3>
                <ul role="list" class="mt-4 space-y-4">
                  <li>
                    <a href="/rarity" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Rarity
                    </a>
                  </li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Staking</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Grassroots</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Activity</span></li>
                  <li><span class="select-none text-base text-gray-5 opacity-50 lg:p-2">Meema</span></li>
                </ul>
              </div>
            </div>

            <div class="md:grid md:grid-cols-2 md:gap-8">
              <!-- Social -->
              <div>
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-6 lg:px-2">Social</h3>
                <ul role="list" class="mt-4 space-y-4">
                  <li>
                    <a href="https://www.instagram.com/nakednfts/" target="_blank" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Instagram
                    </a>
                  </li>
                  <li>
                    <a href="https://twitter.com/nakednfts/" target="_blank" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Twitter
                    </a>
                  </li>
                  <li>
                    <a href="https://discord.gg/hoodies" target="_blank" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Discord
                    </a>
                  </li>
                  <li>
                    <a href="https://hoodiez.xyz" target="_blank" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Hoodiez.xyz
                    </a>
                  </li>
                </ul>
              </div>

              <!-- Legal -->
              <div class="mt-12 md:mt-0">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-6 lg:px-2">Legal</h3>
                <ul role="list" class="mt-4 space-y-4">
                  <li>
                    <a href="/privacy-policy" class="rounded-md text-base text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none lg:p-2">
                      Privacy Policy
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Section -->
        <div class="mt-12 flex items-center justify-between border-t border-gray-6 pt-8">
          <p class="text-base text-gray-4 xl:text-left">&copy; 2022 Naked NFTs</p>

          <!-- Social Icons -->
          <div>
            <ul class="flex items-center space-x-8">
              <!-- Instagram -->
              <li>
                <a class="rounded-md text-gray-7 transition duration-150 ease-in-out hover:text-gray-5 focus:text-gray-5 focus:outline-none lg:p-2" target="_blank" href="https://www.instagram.com/nakednfts/">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.99805 0C3.13905 0 0 3.14195 0 7.00195V17.002C0 20.861 3.14195 24 7.00195 24H17.002C20.861 24 24 20.858 24 16.998V6.99805C24 3.13905 20.858 0 16.998 0H6.99805ZM19 4C19.552 4 20 4.448 20 5C20 5.552 19.552 6 19 6C18.448 6 18 5.552 18 5C18 4.448 18.448 4 19 4ZM12 6C15.309 6 18 8.691 18 12C18 15.309 15.309 18 12 18C8.691 18 6 15.309 6 12C6 8.691 8.691 6 12 6ZM12 8C10.9391 8 9.92172 8.42143 9.17157 9.17157C8.42143 9.92172 8 10.9391 8 12C8 13.0609 8.42143 14.0783 9.17157 14.8284C9.92172 15.5786 10.9391 16 12 16C13.0609 16 14.0783 15.5786 14.8284 14.8284C15.5786 14.0783 16 13.0609 16 12C16 10.9391 15.5786 9.92172 14.8284 9.17157C14.0783 8.42143 13.0609 8 12 8Z" fill="currentColor"/>
                  </svg>
                </a>
              </li>
              <!-- Twitter -->
              <li>
                <a class="rounded-md text-gray-7 duration-150 ease-in-out hover:text-gray-5 focus:text-gray-5 focus:outline-none lg:p-2" href="https://twitter.com/nakednfts/" target="_blank">
                  <svg width="28" height="24" viewBox="0 0 24 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.55016 19.7502C16.6045 19.7502 21.5583 12.2469 21.5583 5.74211C21.5583 5.53117 21.5536 5.31554 21.5442 5.1046C22.5079 4.40771 23.3395 3.5445 24 2.55554C23.1025 2.95484 22.1496 3.21563 21.1739 3.32898C22.2013 2.71315 22.9705 1.74572 23.3391 0.606011C22.3726 1.1788 21.3156 1.58286 20.2134 1.80085C19.4708 1.01181 18.489 0.48936 17.4197 0.314295C16.3504 0.13923 15.2532 0.321295 14.2977 0.832341C13.3423 1.34339 12.5818 2.15495 12.1338 3.14156C11.6859 4.12816 11.5754 5.23486 11.8195 6.29054C9.86249 6.19233 7.94794 5.68395 6.19998 4.79834C4.45203 3.91274 2.90969 2.66968 1.67297 1.14976C1.0444 2.23349 0.852057 3.51589 1.13503 4.73634C1.418 5.95678 2.15506 7.02369 3.19641 7.72023C2.41463 7.69541 1.64998 7.48492 0.965625 7.10617V7.1671C0.964925 8.30439 1.3581 9.40683 2.07831 10.287C2.79852 11.1672 3.80132 11.7708 4.91625 11.9952C4.19206 12.1934 3.43198 12.2222 2.69484 12.0796C3.00945 13.0577 3.62157 13.9131 4.44577 14.5266C5.26997 15.14 6.26512 15.4808 7.29234 15.5015C5.54842 16.8714 3.39417 17.6144 1.17656 17.6109C0.783287 17.6103 0.390399 17.5861 0 17.5387C2.25286 18.984 4.87353 19.7516 7.55016 19.7502Z" fill="currentColor"/>
                  </svg>
                </a>
              </li>
              <!-- Discord -->
              <li>
                <a class="rounded-md text-gray-7 duration-150 ease-in-out hover:text-gray-5 focus:text-gray-5 focus:outline-none lg:p-2" href="https://discord.gg/hoodies" target="_blank">
                  <svg width="32" height="24" viewBox="0 0 22 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.98 2.69012C17.3 1.35012 14.9 0.980117 13.86 0.870117H13.82C13.66 0.870117 13.51 0.960117 13.46 1.11012C13.37 1.34012 13.51 1.59012 13.74 1.63012C14.91 1.87012 16.26 2.29012 17.49 3.06012C17.74 3.21012 17.8 3.55012 17.6 3.78012C17.44 3.96012 17.17 3.98012 16.96 3.86012C14.56 2.38012 11.58 2.30012 11 2.30012C10.42 2.30012 7.44 2.38012 5.04 3.86012C4.83 3.98012 4.56 3.96012 4.4 3.78012C4.2 3.55012 4.26 3.21012 4.51 3.06012C5.74 2.29012 7.09 1.87012 8.26 1.63012C8.49 1.59012 8.63 1.34012 8.54 1.11012C8.49 0.960117 8.34 0.870117 8.18 0.870117H8.14C7.1 0.980117 4.7 1.35012 3.02 2.69012C2.04 3.60012 0.09 8.83012 0 13.4601C0 13.7701 0.08 14.0801 0.26 14.3301C1.43 15.9801 3.97 16.9701 5.89 17.1101C6.18 17.1301 6.46 17.0001 6.63 16.7601C6.64 16.7601 6.64 16.7501 6.65 16.7401C7 16.2601 6.79 15.5801 6.23 15.3701C4.63 14.7801 3.81 14.0801 3.76 14.0301C3.56 13.8501 3.54 13.5501 3.71 13.3501C3.89 13.1501 4.19 13.1301 4.39 13.3101C4.42 13.3301 6.64 15.2201 11 15.2201C15.36 15.2201 17.58 13.3301 17.61 13.3101C17.81 13.1301 18.11 13.1501 18.29 13.3501C18.46 13.5501 18.44 13.8501 18.24 14.0301C18.19 14.0801 17.37 14.7801 15.77 15.3701C15.21 15.5801 15 16.2601 15.35 16.7401C15.36 16.7501 15.36 16.7601 15.37 16.7601C15.54 17.0001 15.82 17.1301 16.11 17.1101C18.03 16.9701 20.57 15.9801 21.74 14.3301C21.92 14.0801 22 13.7701 22 13.4601C21.91 8.83012 19.96 3.60012 18.98 2.69012ZM7.89 11.8701C6.97 11.8701 6.22 11.0101 6.22 9.96012C6.22 8.90012 6.97 8.04012 7.89 8.04012C8.82 8.04012 9.56 8.90012 9.56 9.96012C9.56 11.0101 8.82 11.8701 7.89 11.8701ZM14.11 11.8701C13.18 11.8701 12.44 11.0101 12.44 9.96012C12.44 8.90012 13.18 8.04012 14.11 8.04012C15.03 8.04012 15.78 8.90012 15.78 9.96012C15.78 11.0101 15.03 11.8701 14.11 11.8701Z" fill="currentColor"/>
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

  </div>
</body>
</html>
