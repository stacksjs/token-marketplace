<script server>
const pageTitle = 'Rarity | Naked NFTs'
const API_URL = 'http://localhost:3008'
let rarityCollections = []

try {
  const res = await fetch(`${API_URL}/marketplace/rarity`)
  if (res.ok) {
    const data = await res.json()
    rarityCollections = data.collections || []
  }
} catch (err) {
  console.error('Failed to fetch rarity data:', err)
}
</script>

@layout('default')
@section('content')
