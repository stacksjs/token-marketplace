<script server>
const pageTitle = 'Rarity | Naked NFTs'
const API_URL = 'http://localhost:3008'
let rarityCollections = []

try {
  const res = await fetch(`${API_URL}/marketplace/rarity`)
  if (res.ok) {
    const data = await res.json()
    rarityCollections = data.collections || []
  }
} catch (err) {
  console.error('Failed to fetch rarity data:', err)
}
</script>

@layout('default')
@section('content')
  <!-- Main Content -->
  <main class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-4">
    <!-- Page Header -->
    <div class="items-baseline block pt-16 pb-6 border-b border-gray-200 lg:flex">
      <h1 class="text-4xl font-extrabold tracking-tight w-100 text-gray-8">What's Your Rarity?</h1>

      <div class="flex items-center justify-between w-full pt-6 lg:pt-0">
        <!-- Search Input -->
        <div class="lg:pl-12">
          <label for="rarity-search" class="hidden text-sm font-medium text-gray-7">Quick search</label>
          <div class="relative flex items-center w-64 mx-auto">
            <input
              type="text"
              name="search"
              id="rarity-search"
              ref="raritySearch"
              class="block w-full h-12 pl-4 pr-12 transition duration-150 ease-in-out border-none rounded-md bg-gray-0.25 cursor-pointer placeholder:text-gray-3 focus:ring-2 focus:ring-pink-8 sm:text-sm"
              placeholder="Search Collections..."
            />
            <div class="absolute inset-y-0 right-0 flex py-1.5 pr-1.5">
              <kbd class="inline-flex items-center px-2 mr-2 font-sans text-sm font-medium text-gray-400 border border-gray-200 rounded">
                ⌘K
              </kbd>
            </div>
          </div>
        </div>

        <!-- Sort & Filter -->
        <div class="flex items-center justify-end space-x-4">
          <select ref="raritySort" class="h-10 rounded-md border border-gray-300 px-3 text-sm text-gray-7 focus:border-pink-8 focus:ring-pink-8">
            <option value="name">Name</option>
            <option value="recent">Recent</option>
            <option value="popular">Popular</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Collections Grid -->
    <section aria-labelledby="collections-heading" class="pt-6">
      <h2 id="collections-heading" class="sr-only">Collections</h2>

      <div class="max-w-2xl px-4 py-16 mx-auto sm:py-12 sm:px-6 lg:max-w-full lg:px-2">
        <div ref="rarityGrid" class="grid grid-cols-1 mt-6 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
          @foreach(rarityCollections as collection)
            <div>
              <a href="/rarity/{{ collection.slug }}" class="group">
                <div class="w-full overflow-hidden transition duration-150 ease-in-out bg-gray-200 rounded-md min-h-80 aspect-w-1 aspect-h-1 group-hover:opacity-75 lg:aspect-none lg:h-80">
                  <img
                    src="{{ collection.imageUrl || '/assets/images/placeholder.png' }}"
                    alt="{{ collection.name }}"
                    class="object-cover object-center w-full h-full lg:h-full lg:w-full"
                  />
                </div>
              </a>

              <div class="flex justify-between mt-4">
                <div class="flex items-center w-11/12">
                  <p class="pt-2 text-lg font-semibold truncate text-gray-6">{{ collection.name }}</p>
                </div>

                @if(collection.website)
                  <a href="{{ collection.website }}" target="_blank" class="pt-2 text-gray-3 hover:text-pink-8">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3.6 9H20.4M3.6 15H20.4M11.5 3C9.81 5.69 9 8.77 9 12C9 15.23 9.81 18.31 11.5 21M12.5 3C14.19 5.69 15 8.77 15 12C15 15.23 14.19 18.31 12.5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                @endif
              </div>
            </div>
          @endforeach
        </div>
      </div>
    </section>
  </main>

  <script client>
    {
      const searchInput = STX.useRef('raritySearch')
      const sortSelect = STX.useRef('raritySort')
      const gridContainer = STX.useRef('rarityGrid')
      let debounceTimer = null

      async function searchRarity() {
        const search = searchInput?.value || ''
        const sort = sortSelect?.value || 'name'
        try {
          const res = await fetch(`${API_URL}/marketplace/rarity?search=${encodeURIComponent(search)}&sort=${sort}`)
          const data = await res.json()
          const collections = data.collections || []
          if (!gridContainer) return

          gridContainer.innerHTML = collections.map(c => `
            <div>
              <a href="/rarity/${c.slug}" class="group">
                <div class="w-full overflow-hidden transition duration-150 ease-in-out bg-gray-200 rounded-md min-h-80 aspect-w-1 aspect-h-1 group-hover:opacity-75 lg:aspect-none lg:h-80">
                  <img src="${c.imageUrl || '/assets/images/placeholder.png'}" alt="${c.name}" class="object-cover object-center w-full h-full lg:h-full lg:w-full" />
                </div>
              </a>
              <div class="flex justify-between mt-4">
                <div class="flex items-center w-11/12">
                  <p class="pt-2 text-lg font-semibold truncate text-gray-6">${c.name}</p>
                </div>
              </div>
            </div>
          `).join('')
        } catch (err) {
          console.error('Search failed:', err)
        }
      }

      searchInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer)
        debounceTimer = setTimeout(searchRarity, 300)
      })
      sortSelect?.addEventListener('change', searchRarity)
    }
  </script>
@endsection
