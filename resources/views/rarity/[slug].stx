<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
const collectionSlug = slug || ''
let collection = null
let topRanked = []
let rarityBars = []
let hasMore = false
let error = null

const colorMap = {
  legendary: { bg: 'bg-yellow-100', text: 'text-yellow-800', bar: 'bg-yellow-500' },
  epic: { bg: 'bg-purple-100', text: 'text-purple-800', bar: 'bg-purple-500' },
  rare: { bg: 'bg-blue-100', text: 'text-blue-800', bar: 'bg-blue-500' },
  uncommon: { bg: 'bg-green-100', text: 'text-green-800', bar: 'bg-green-500' },
  common: { bg: 'bg-gray-100', text: 'text-gray-800', bar: 'bg-gray-400' },
}

try {
  const res = await fetch(`${API_URL}/marketplace/rarity/${collectionSlug}`)
  if (res.ok) {
    const data = await res.json()
    collection = data.collection
    const ranked = data.rankedNfts?.data || data.collection?.topRanked || []
    const dist = data.collection?.rarityDistribution || {}
    hasMore = (data.rankedNfts?.page || 1) < (data.rankedNfts?.totalPages || 1)

    // Pre-process top ranked with flattened color classes
    topRanked = ranked.map(nft => {
      const key = (nft.rarity || 'common').toLowerCase()
      const colors = colorMap[key] || colorMap.common
      return {
        ...nft,
        badgeBg: colors.bg,
        badgeText: colors.text,
      }
    })

    // Pre-process rarity distribution into a simple array
    const order = ['legendary', 'epic', 'rare', 'uncommon', 'common']
    rarityBars = order
      .filter(key => dist[key])
      .map(key => {
        const colors = colorMap[key] || colorMap.common
        return {
          label: key.charAt(0).toUpperCase() + key.slice(1),
          count: dist[key].count,
          percentage: dist[key].percentage,
          barColor: colors.bar,
        }
      })
  } else {
    error = 'Collection not found'
  }
} catch (err) {
  console.error('Failed to fetch rarity data:', err)
  error = 'Failed to load rarity data'
}

const pageTitle = `${collection?.name || 'Collection'} Rarity | Naked NFTs`
</script>

<style>
  .progress-bar {
    transition: width 0.5s ease-in-out;
  }
</style>

@layout('default')
@section('title', pageTitle)
