          </svg>
          <p class="mt-4 text-gray-5">No ranked NFTs found for this collection</p>
        </div>
      @endif
    </div>

    <script client>
      {
        var RARITY_DETAIL_API = window.API_BASE || 'http://localhost:3008'
        var _rarityDetailSlug = window.location.pathname.split('/').pop()
        var _rarityNftPage = 1
        var _rarityNftHasMore = true
        var _rarityNftLoading = false
        var _rarityNftSort = 'rank_asc'

        var _rarityColorMap = {
          legendary: { bg: 'bg-yellow-100', text: 'text-yellow-800' },
          epic: { bg: 'bg-purple-100', text: 'text-purple-800' },
          rare: { bg: 'bg-blue-100', text: 'text-blue-800' },
          uncommon: { bg: 'bg-green-100', text: 'text-green-800' },
          common: { bg: 'bg-gray-100', text: 'text-gray-800' }
        }

        function rarityNftCardHtml(nft) {
          var key = (nft.rarity || 'common').toLowerCase()
          var colors = _rarityColorMap[key] || _rarityColorMap.common
          var html = '<div class="bg-gray-0.25 rounded-lg overflow-hidden transition duration-150 hover:shadow-lg cursor-pointer" onclick="NFTModal.open(' + nft.id + ')">'
            + '<div class="aspect-square"><img src="' + (nft.imageUrl || nft.image_url || '/assets/images/anonymouse.png') + '" alt="' + (nft.name || '') + '" class="w-full h-full object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" /></div>'
            + '<div class="p-3"><p class="font-semibold text-gray-9 truncate">' + (nft.name || '') + '</p>'
            + '<div class="flex items-center justify-between mt-1"><span class="text-xs text-gray-5">Rank #' + (nft.rank || nft.rarity_rank || '?') + '</span>'
          if (nft.rarity) {
            html += '<span class="text-xs font-medium px-2 py-0.5 rounded-full ' + colors.bg + ' ' + colors.text + '">' + nft.rarity + '</span>'
          }
          html += '</div></div></div>'
          return html
        }

        window.rarityNftSortChanged = function(el) {
          _rarityNftSort = el.value
          _rarityNftPage = 1
          _rarityNftHasMore = true
          var grid = el.parentNode.nextElementSibling
          if (!grid) return
          fetch(RARITY_DETAIL_API + '/marketplace/rarity/' + _rarityDetailSlug + '?page=1&sort=' + _rarityNftSort)
            .then(function(res) { return res.json() })
            .then(function(data) {
              var ranked = (data.collection && data.collection.topRanked) || []
              if (ranked.length < (data.perPage || 20)) _rarityNftHasMore = false
              var html = ''
              for (var i = 0; i < ranked.length; i++) html += rarityNftCardHtml(ranked[i])
              grid.innerHTML = html
              var loadMoreWrap = grid.nextElementSibling
              if (loadMoreWrap && loadMoreWrap.children.length > 0) {
                loadMoreWrap.style.display = _rarityNftHasMore ? '' : 'none'
              }
            })
            .catch(function(err) { console.error('Sort failed:', err) })
        }

        window.rarityNftLoadMore = async function(btn) {
          if (_rarityNftLoading || !_rarityNftHasMore) return
          _rarityNftLoading = true
          btn.disabled = true
          btn.textContent = 'Loading...'
          _rarityNftPage++
          try {
            var res = await fetch(RARITY_DETAIL_API + '/marketplace/rarity/' + _rarityDetailSlug + '?page=' + _rarityNftPage + '&sort=' + _rarityNftSort)
            var data = await res.json()
            var ranked = (data.collection && data.collection.topRanked) || []
            if (ranked.length < (data.perPage || 20)) _rarityNftHasMore = false
            var grid = btn.parentNode.previousElementSibling
            if (grid) {
              for (var i = 0; i < ranked.length; i++) {
                grid.insertAdjacentHTML('beforeend', rarityNftCardHtml(ranked[i]))
              }
            }
            if (!_rarityNftHasMore) btn.parentNode.style.display = 'none'
          } catch (err) {
            console.error('Load more failed:', err)
            _rarityNftPage--
          }
          _rarityNftLoading = false
          btn.disabled = false
          btn.textContent = 'Load More'
        }
      }
    </script>
  @endif
@endsection
