<script server>
const API_URL = 'http://localhost:3008'
const collectionSlug = slug || ''
let collection = null
let topRanked = []
let rarityDistribution = {}
let error = null

try {
  const res = await fetch(`${API_URL}/marketplace/rarity/${collectionSlug}`)
  if (res.ok) {
    const data = await res.json()
    collection = data.collection
    topRanked = data.collection?.topRanked || []
    rarityDistribution = data.collection?.rarityDistribution || {}
  } else {
    error = 'Collection not found'
  }
} catch (err) {
  console.error('Failed to fetch rarity data:', err)
  error = 'Failed to load rarity data'
}

const pageTitle = `${collection?.name || 'Collection'} Rarity | Naked NFTs`

const rarityColors = {
  legendary: { bg: 'bg-yellow-100', text: 'text-yellow-800', bar: 'bg-yellow-500' },
  epic: { bg: 'bg-purple-100', text: 'text-purple-800', bar: 'bg-purple-500' },
  rare: { bg: 'bg-blue-100', text: 'text-blue-800', bar: 'bg-blue-500' },
  uncommon: { bg: 'bg-green-100', text: 'text-green-800', bar: 'bg-green-500' },
  common: { bg: 'bg-gray-100', text: 'text-gray-800', bar: 'bg-gray-400' },
}
</script>

<style>
  .progress-bar {
    transition: width 0.5s ease-in-out;
  }
</style>

@layout('default')
@section('content')
  @if(error)
    <div class="min-h-screen flex items-center justify-center">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-8 mb-4">{{ error }}</h1>
        <a href="/rarity" class="text-pink-8 hover:text-pink-9">Browse all collections</a>
      </div>
    </div>
  @else
    <!-- Collection Header -->
    <div class="relative">
      <div class="h-64 md:h-80 bg-gradient-to-r from-gray-9 to-gray-7 relative overflow-hidden">
        @if(collection.banner_url)
          <img src="{{ collection.banner_url }}" alt="{{ collection.name }} Banner" class="w-full h-full object-cover" />
        @endif
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative -mt-20 sm:-mt-24">
          <div class="flex flex-col sm:flex-row sm:items-end sm:space-x-6">
            <div class="shrink-0">
              <img
                src="{{ collection.image_url || '/assets/images/placeholder.png' }}"
                alt="{{ collection.name }}"
                class="h-32 w-32 sm:h-40 sm:w-40 rounded-xl border-4 border-white shadow-lg object-cover"
              />
            </div>

            <div class="mt-4 sm:mt-0 sm:pb-2">
              <div class="flex items-center space-x-3">
                <h1 class="text-3xl sm:text-4xl font-bold text-gray-9">{{ collection.name }}</h1>
                @if(collection.is_verified)
                  <svg class="h-6 w-6 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
