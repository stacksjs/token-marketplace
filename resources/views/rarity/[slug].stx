              Back to all collections
            </a>
            <a href="/collections/{{ collection.slug }}" class="text-gray-5 hover:text-pink-8 transition text-sm font-medium">
              View Collection
            </a>
          </div>
        </div>

        <!-- Stats Card -->
        <div class="bg-gray-0.25 rounded-xl p-6">
          <div class="grid grid-cols-2 gap-4">
            <div class="text-center">
              <p class="text-2xl font-bold text-gray-9">{{ collection.totalSupply || 0 }}</p>
              <p class="text-sm text-gray-5">Total Items</p>
            </div>
            @if(collection.floor_price)
              <div class="text-center">
                <p class="text-2xl font-bold text-gray-9">{{ collection.floor_price }} SOL</p>
                <p class="text-sm text-gray-5">Floor Price</p>
              </div>
            @endif
          </div>
        </div>
      </div>
    </div>

    <!-- Rarity Distribution -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
      <h2 class="text-2xl font-bold text-gray-9 mb-6">Rarity Distribution</h2>
      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
        @foreach(Object.entries(rarityDistribution) as [rarity, data])
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-sm font-semibold capitalize text-gray-7">{{ rarity }}</span>
              <span class="text-sm text-gray-5">{{ data.count }} ({{ data.percentage }}%)</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3">
              <div
                class="progress-bar h-3 rounded-full {{ rarityColors[rarity]?.bar || 'bg-gray-400' }}"
                style="width: {{ data.percentage }}%"
              ></div>
            </div>
          </div>
        @endforeach
      </div>
    </div>

    <!-- Top Ranked NFTs -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <h2 class="text-2xl font-bold text-gray-9 mb-6">Top Ranked</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          @foreach(topRanked as nft)
            <div class="bg-gray-0.25 rounded-lg overflow-hidden transition duration-150 hover:shadow-lg">
              <div class="aspect-square">
                <img
                  src="{{ nft.imageUrl || '/assets/images/placeholder.png' }}"
                  alt="{{ nft.name }}"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-3">
                <p class="font-semibold text-gray-9 truncate">{{ nft.name }}</p>
                <div class="flex items-center justify-between mt-1">
                  <span class="text-xs text-gray-5">Rank #{{ nft.rank }}</span>
                  @if(nft.rarity)
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full {{ rarityColors[nft.rarity?.toLowerCase()]?.bg || 'bg-gray-100' }} {{ rarityColors[nft.rarity?.toLowerCase()]?.text || 'text-gray-800' }}">
                      {{ nft.rarity }}
                    </span>
                  @endif
                </div>
              </div>
            </div>
          @endforeach
        </div>
      @if(topRanked.length == 0)
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <p class="mt-4 text-gray-5">No ranked NFTs found for this collection</p>
        </div>
      @endif
    </div>
  @endif
@endsection
