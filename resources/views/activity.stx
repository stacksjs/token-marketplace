<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
let events = []
let collections = []
let error = null

try {
  const [eventsRes, collectionsRes] = await Promise.all([
    fetch(`${API_URL}/marketplace/activity?limit=50`),
    fetch(`${API_URL}/marketplace/collections?limit=100`),
  ])
  if (eventsRes.ok) {
    const data = await eventsRes.json()
    events = data.data || data.events || []
  }
  if (collectionsRes.ok) {
    const data = await collectionsRes.json()
    collections = data.data || data.collections || []
  }
} catch (err) {
  console.error('Failed to fetch activity:', err)
  error = 'Failed to load activity feed'
}

function formatAddress(addr) {
  if (!addr) return '—'
  return addr.slice(0, 4) + '...' + addr.slice(-4)
}

function formatSol(val) {
  if (!val) return ''
  const sol = typeof val === 'number' && val > 1000 ? val / 1e9 : val
  return sol.toFixed(2) + ' SOL'
}

function timeAgo(dateStr) {
  if (!dateStr) return ''
  const diff = Date.now() - new Date(dateStr).getTime()
  const mins = Math.floor(diff / 60000)
  if (mins < 1) return 'just now'
  if (mins < 60) return `${mins}m ago`
  const hours = Math.floor(mins / 60)
  if (hours < 24) return `${hours}h ago`
  const days = Math.floor(hours / 24)
  return `${days}d ago`
}

const eventIcons = {
  sale: '💰', listing: '📋', delisting: '❌', offer: '🤝',
  transfer: '↗️', bid: '🔨', auction_settled: '🏆', mint: '✨',
}

const eventColors = {
  sale: 'bg-green-1 text-green-7', listing: 'bg-blue-1 text-blue-7',
  delisting: 'bg-red-1 text-red-7', offer: 'bg-purple-1 text-purple-7',
  transfer: 'bg-yellow-1 text-yellow-8', bid: 'bg-orange-1 text-orange-7',
  auction_settled: 'bg-pink-1 text-pink-7', mint: 'bg-pink-1 text-pink-7',
}
</script>

