  <script>
    let activeFilters = new Set(['all'])
    let currentCursor = null

    function toggleFilter(type, btn) {
      if (type === 'all') {
        activeFilters = new Set(['all'])
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'))
        btn.classList.add('active')
      } else {
        activeFilters.delete('all')
        document.querySelector('.filter-chip.active[onclick*="all"]')?.classList.remove('active')
        btn.classList.toggle('active')
        if (btn.classList.contains('active')) activeFilters.add(type)
        else activeFilters.delete(type)
        if (activeFilters.size === 0) {
          activeFilters.add('all')
          document.querySelector('.filter-chip[onclick*="all"]')?.classList.add('active')
        }
      }
      applyFilters()
    }

    function applyFilters() {
      document.querySelectorAll('#activity-body tr').forEach(row => {
        const type = row.dataset.type
        const visible = activeFilters.has('all') || activeFilters.has(type)
        row.style.display = visible ? '' : 'none'
      })
    }

    function filterByCollection(slug) {
      const url = new URL(window.location)
      if (slug) url.searchParams.set('collection', slug)
      else url.searchParams.delete('collection')
      window.location = url
    }

    function loadMore() {
      // In production, fetch next page and append rows
      const btn = document.getElementById('load-more-btn')
      btn.textContent = 'Loading...'
      setTimeout(() => { btn.textContent = 'No more events' ; btn.disabled = true }, 1000)
    }
  </script>
@endsection
