<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <title>Home | Naked NFTs - Cross-Chain NFT Marketplace</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }
    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
  </style>
  <script>
    import MainLayout from './components/MainLayout.stx'

    // Featured Collections Data
    const featuredCollections = [
      {
        name: "Hoodratz",
        slug: "hoodratz",
        imageUrl: "/assets/images/king-hoodrat.png",
        description: "A collection of 10,000 unique Hoodratz NFTs",
        isMinting: true,
        isFeatured: false
      },
      {
        name: "Crypto Punks",
        slug: "crypto-punks",
        imageUrl: "/assets/images/hoodie.png",
        description: "The original pixel art NFT collection",
        isMinting: false,
        isFeatured: true
      }
    ]

    // Popular Collections Data
    const popularCollections = [
      {
        name: "Bored Apes",
        slug: "bored-apes",
        imageUrl: "/assets/images/anonymouse.png",
        description: "A collection of 10,000 unique Bored Apes",
        website: "https://boredapeyachtclub.com"
      },
      {
        name: "Cool Cats",
        slug: "cool-cats",
        imageUrl: "/assets/images/hoodie.png",
        description: "Cool Cats is a collection of 9,999 randomly generated cats",
        website: "https://coolcatsnft.com"
      }
    ]

    // Available NFTs Data
    const availableNfts = [
      {
        id: 1,
        name: "King Hoodrat",
        imageUrl: "/assets/images/king-hoodrat.png",
        collectionName: "Hoodratz",
        isMinting: true,
        mintUrl: "https://hoodratz.nakednfts.io/"
      },
      {
        id: 2,
        name: "Hoodie #1234",
        imageUrl: "/assets/images/hoodie.png",
        collectionName: "Hoodratz",
        isMinting: true,
        mintUrl: "https://hoodratz.nakednfts.io/"
      },
      {
        id: 3,
        name: "Anonymouse",
        imageUrl: "/assets/images/anonymouse.png",
        collectionName: "Hoodratz",
        isMinting: true,
        mintUrl: "https://hoodratz.nakednfts.io/"
      }
    ]
  </script>
</head>
<body class="antialiased font-sans bg-white text-gray-9">
  <MainLayout>
    <!-- Hero Section - Desktop -->
    <section id="hero" class="hidden lg:block">
      <div class="min-w-screen relative h-bg-height bg-nft-hero bg-cover bg-center bg-no-repeat text-white">
        <div class="relative top-28 ml-10 max-w-3xl xl:ml-32">
          <h1 class="text-5xl font-semibold leading-relaxed lg:px-2">
            Discover & collect NFTs in the world's first cross-chain marketplace
          </h1>

          <div class="flex items-center space-x-8 pt-8">
            <a href="/collections">
              <button type="button" class="inline-flex items-center justify-center rounded-md border border-transparent bg-pink-8 px-12 py-3 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9 focus:outline-none focus:ring-2 focus:ring-pink-700 focus:ring-offset-2">
                Explore collections
              </button>
            </a>

            <button type="button" disabled class="inline-flex items-center justify-center rounded-md border-2 border-gray-5 bg-transparent px-12 py-3 text-base font-semibold text-gray-5 cursor-not-allowed" data-tippy-content="Coming soon">
              Learn more
            </button>
          </div>
        </div>
        <img class="relative top-44 ml-10 h-36 object-cover xl:ml-16" src="/assets/images/naked-group.png" alt="" />
      </div>
    </section>

    <!-- Hero Section - Mobile -->
    <section id="hero-mobile" class="block lg:hidden">
      <div class="bg-hero-gradient relative flex flex-col items-center text-white">
        <div class="relative top-5 max-w-xl md:top-24">
          <h1 class="text-center text-2xl md:text-5xl">
            Discover & collect NFTs in the world's first cross-chain marketplace
          </h1>

          <div class="mt-5 flex items-center justify-center space-x-8">
            <a href="/collections">
              <button type="button" class="inline-flex items-center justify-center rounded-md border border-transparent bg-pink-8 px-8 py-3 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9">
                Explore collections
              </button>
            </a>

            <button type="button" disabled class="inline-flex items-center justify-center rounded-md border-2 border-gray-5 bg-transparent px-8 py-3 text-base font-semibold text-gray-5 cursor-not-allowed">
              Learn more
            </button>
          </div>
        </div>

        <img class="h-full w-full object-center" src="/assets/images/simon-group.png" alt="Image of NFT For Sale" />
      </div>
    </section>

    <!-- Featured Collections -->
    <section id="featured-collections">
      <div class="mx-auto max-w-7xl overflow-hidden px-4 sm:px-6 lg:px-12">
        <div class="mx-auto max-w-2xl py-8 sm:py-12 md:max-w-none lg:py-14">
          <div class="flex items-center justify-between">
            <h2 id="collections-heading" class="text-3xl font-semibold text-gray-9">Featured Collections</h2>
            <a href="/collections">
              <button type="button" class="inline-flex items-center justify-center rounded-md border border-gray-3 bg-transparent px-4 py-2 text-sm font-medium text-gray-9 transition duration-150 ease-in-out hover:bg-gray-9 hover:text-white">
                See All
                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </button>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            @foreach(featuredCollections as collection)
              <div class="group relative mb-6 sm:mb-0">
                <div class="relative mb-3 aspect-square w-full overflow-hidden rounded-lg bg-white">
                  <img src="{{ collection.imageUrl }}" alt="{{ collection.name }} Profile Image" class="h-full w-full object-cover object-center" />
                </div>

                <h3 class="mt-2 text-2xl font-semibold text-gray-9">
                  <a href="/collections/{{ collection.slug }}" class="duration-150 ease-in-out focus:outline-none group-hover:text-pink-9">
                    <span class="absolute inset-0"></span>
                    {{ collection.name }}
                  </a>
                </h3>

                @if(collection.isMinting)
                  <div class="mt-2 flex items-center text-emerald-500">
                    <div class="blink h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></div>
                    <span class="ml-2 cursor-pointer text-sm font-semibold uppercase text-emerald-500">Minting Live</span>
                  </div>
                @elseif(collection.isFeatured)
                  <div class="mt-2 flex items-center">
                    <span class="text-sm font-semibold uppercase text-violet-8">Featured</span>
                  </div>
                @endif

                <p class="mt-2 text-base text-gray-400">{{ collection.description }}</p>

                @if(collection.isMinting)
                  <div class="mt-2">
                    <a href="/collections/{{ collection.slug }}/mint">
                      <button type="button" class="inline-flex w-full items-center justify-center rounded-md border border-transparent bg-pink-8 px-4 py-3 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9 focus:outline-none focus:ring-2 focus:ring-pink-700 focus:ring-offset-2">
                        Mint Now
                      </button>
                    </a>
                  </div>
                @endif
              </div>
            @endforeach

            <!-- Get Featured Card -->
            <div class="group relative mb-6 sm:mb-0">
              <div class="relative mb-3 h-80 w-full overflow-hidden rounded-lg bg-white duration-500 group-hover:shadow-lg group-hover:transition-all sm:aspect-w-2 sm:aspect-h-1 sm:h-64 md:aspect-w-1 md:aspect-h-1">
                <a href="mailto:chris@meema.io">
                  <div class="flex flex-row justify-center">
                    <img src="/assets/images/get-listed.png" alt="" class="h-full w-full object-cover object-center" />
                    <div class="absolute inset-y-40 mt-12">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-pink-8 group-hover:text-pink-9" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
              <h3 class="mt-2 text-2xl font-semibold text-gray-9">
                <a href="mailto:chris@meema.io" class="focus:outline-none group-hover:text-pink-9">Get Featured</a>
              </h3>
              <p class="mt-2 text-base text-gray-400">Are you interested in getting featured here?</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Collections -->
    <section id="popular-collections">
      <div class="mx-auto max-w-7xl overflow-hidden px-4 sm:px-6 lg:px-12">
        <div class="mx-auto max-w-2xl py-8 sm:py-12 md:max-w-none lg:py-14">
          <div class="flex items-center justify-between">
            <h2 id="collections-heading" class="flex items-center text-3xl font-semibold text-gray-9">
              Popular Collections
              <span data-tippy-content="Do you want to see these collections verified? We do, too! Help us reach out to your favorite collections!">
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-4 h-6 w-6 text-gray-3 transition duration-150 ease-in-out hover:text-gray-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
            </h2>
            <a href="/collections">
              <button type="button" class="inline-flex items-center justify-center rounded-md border border-gray-3 bg-transparent px-4 py-2 text-sm font-medium text-gray-9 transition duration-150 ease-in-out hover:bg-gray-9 hover:text-white">
                See All
                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </button>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            @foreach(popularCollections as collection)
              <div class="group relative mb-6 sm:mb-0">
                <div class="relative mb-3 aspect-square w-full overflow-hidden rounded-lg bg-white">
                  <a href="{{ collection.website }}" target="_blank">
                    <img src="{{ collection.imageUrl }}" alt="{{ collection.name }}" class="h-full w-full object-cover object-center" />
                  </a>
                </div>

                <a href="/collections/{{ collection.slug }}" class="mt-2 text-2xl font-semibold text-gray-9 duration-150 ease-in-out focus:outline-none group-hover:text-pink-9">
                  <span class="absolute inset-0"></span>
                  {{ collection.name }}
                </a>

                <p class="mt-2 text-base text-gray-400">{{ collection.description }}</p>
              </div>
            @endforeach

            <!-- Get Featured Card -->
            <div class="group relative mb-6 sm:mb-0">
              <div class="relative mb-3 h-80 w-full overflow-hidden rounded-lg bg-white duration-500 group-hover:shadow-lg group-hover:transition-all sm:aspect-w-2 sm:aspect-h-1 sm:h-64 md:aspect-w-1 md:aspect-h-1">
                <a href="mailto:chris@meema.io">
                  <div class="flex flex-row justify-center">
                    <img src="/assets/images/get-listed.png" alt="" class="h-full w-full object-cover object-center" />
                    <div class="absolute inset-y-40 mt-12">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-pink-8 group-hover:text-pink-9" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
              <h3 class="mt-2 text-2xl font-semibold text-gray-9">
                <a href="mailto:chris@meema.io" class="focus:outline-none group-hover:text-pink-9">Get Featured</a>
              </h3>
              <p class="mt-2 text-base text-gray-400">Are you interested in getting listed here?</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section - Create NFT -->
    <section id="create-nft" class="pt-16">
      <div class="bg-cta-gradient h-116 w-full py-12 md:h-100 md:py-24">
        <div class="absolute ml-16 -mt-12">
          <img src="/assets/images/bubble1.png" alt="" />
        </div>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="items-start justify-between md:flex">
            <div class="mt-4 flex flex-col justify-center md:w-7/12 md:pt-0 lg:block">
              <h1 class="pb-8 text-center text-3xl font-semibold text-white md:text-left">Let's create your NFT/s!</h1>
              <p class="pb-12 text-center font-bold text-gray-5 md:text-left">
                Are you an artist? A collector? Join our community-driven marketplace &amp; distribute your creative
                work to countless of NFT lovers. Reach out to us via Discord, chat, or e-mail, and we will help you get
                started with our <strong class="text-white">Launchpad</strong>.
              </p>

              <div data-tippy-content="Coming Soon" class="flex justify-center md:justify-start lg:w-1/2 xl:w-3/12">
                <button type="button" disabled class="inline-flex w-full items-center justify-center rounded-md border border-transparent bg-gray-5 px-6 py-3 text-base font-semibold text-white cursor-not-allowed">
                  Get Started
                </button>
              </div>
            </div>
            <div class="md:w-3/5">
              <img class="w-full md:-mt-28 lg:-mt-48 xl:-mt-64" src="/assets/images/hand-infinity.png" alt="" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Available NFTs -->
    <section id="available-items">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl py-8 sm:py-12 md:max-w-none lg:py-16">
          <div class="flex items-center justify-between">
            <h2 id="collections-heading" class="pt-32 text-3xl font-semibold text-gray-9 lg:pt-0">Available NFTs</h2>
            <a href="/collections">
              <button type="button" class="inline-flex items-center justify-center rounded-md border border-gray-3 bg-transparent px-4 py-2 text-sm font-medium text-gray-9 transition duration-150 ease-in-out hover:bg-gray-9 hover:text-white">
                See All
                <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </button>
            </a>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            @foreach(availableNfts as nft)
              <div class="relative mb-6 sm:mb-0">
                <div class="relative mb-3 aspect-square w-full overflow-hidden rounded-lg bg-white">
                  <img src="{{ nft.imageUrl }}" alt="{{ nft.name }}" class="h-full w-full object-cover object-center" />
                </div>
                <h3 class="mt-2 text-2xl font-semibold text-gray-9">
                  <a href="/nfts/{{ nft.id }}" class="focus:outline-none">{{ nft.collectionName }}</a>
                </h3>
                @if(nft.isMinting)
                  <div class="mt-2 flex items-center text-emerald-500">
                    <div class="blink h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></div>
                    <span class="ml-2 cursor-pointer text-sm font-semibold uppercase text-emerald-500">Minting Live</span>
                  </div>
                  <div class="mt-2">
                    <a href="{{ nft.mintUrl }}" target="_blank">
                      <button type="button" class="inline-flex w-full items-center justify-center rounded-md border border-transparent bg-pink-8 px-4 py-3 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9 focus:outline-none focus:ring-2 focus:ring-pink-700 focus:ring-offset-2">
                        Mint Now
                      </button>
                    </a>
                  </div>
                @endif
              </div>
            @endforeach
          </div>
        </div>
      </div>
    </section>
  </MainLayout>
</body>
</html>
