    <script client>
      {
        var HOME_API = window.API_BASE || 'http://localhost:3008'

        window.buyNow = async function(btn) {
          var nftId = btn.dataset.nftId
          var walletAddr = localStorage.getItem('wallet_addr')
          if (!walletAddr) {
            if (window.Toast) Toast.error('Please connect your wallet first')
            else alert('Please connect your wallet first')
            return
          }
          btn.disabled = true
          btn.textContent = 'Buying...'
          try {
            var res = await fetch(HOME_API + '/nfts/buy', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ nftId: Number(nftId), buyerWalletAddress: walletAddr })
            })
            var data = await res.json()
            if (data.error) {
              if (window.Toast) Toast.error(data.error)
              else alert(data.error)
            } else {
              if (window.Toast) Toast.success('Purchase successful!')
              else alert('Purchase successful!')
            }
          } catch (err) {
            if (window.Toast) Toast.error('Failed to buy NFT')
            else alert('Failed to buy NFT')
          }
          btn.disabled = false
          btn.textContent = 'Buy Now'
        }
      }
    </script>
@endsection