<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
let featuredCollections = []
let popularCollections = []
let availableNfts = []
let stats = {}

try {
  const res = await fetch(`${API_URL}/marketplace/home`)
  const data = await res.json()
  featuredCollections = data.featuredCollections || []
  popularCollections = data.popularCollections || []
  availableNfts = data.availableNfts || []
  stats = data.stats || {}
} catch (err) {
  console.error('Failed to fetch marketplace data:', err)
}
</script>

