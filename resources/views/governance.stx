      <div>
        <h1 class="text-3xl font-bold text-gray-9">Governance</h1>
        <p class="text-gray-5 mt-1">Vote on proposals with your NFTs — 1 NFT = 1 vote</p>
      </div>
      <button class="bg-pink-7 hover:bg-pink-8 text-white font-semibold px-5 py-2.5 rounded-lg transition text-sm" onclick="openCreateProposal()">
        Create Proposal
      </button>
    </div>

    <!-- Treasury Card -->
    @if(treasury)
      <div class="bg-gradient-to-r from-gray-9 to-gray-7 rounded-xl p-6 text-white mb-8">
        <div class="text-sm opacity-70 mb-1">{{ treasury.dao?.name || 'DAO' }} Treasury</div>
