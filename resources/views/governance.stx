  <!-- Create Proposal Modal -->
  <div id="create-proposal-modal" class="fixed inset-0 z-40 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeCreateProposal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full p-6 relative">
        <button class="absolute top-4 right-4 text-gray-4 hover:text-gray-6" onclick="closeCreateProposal()">✕</button>
        <h3 class="text-xl font-bold text-gray-9 mb-4">Create Proposal</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-7 mb-1">Title</label>
            <input id="proposal-title" type="text" placeholder="Proposal title" class="w-full border border-gray-3 rounded-lg px-4 py-2.5 text-gray-8 outline-none focus:ring-2 focus:ring-pink-5" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-7 mb-1">Description</label>
            <textarea id="proposal-desc" rows="3" placeholder="Describe the proposal..." class="w-full border border-gray-3 rounded-lg px-4 py-2.5 text-gray-8 outline-none focus:ring-2 focus:ring-pink-5 resize-none"></textarea>
          </div>
          <button class="w-full bg-pink-7 hover:bg-pink-8 text-white font-semibold py-3 rounded-lg transition" onclick="submitProposal()">
            Submit Proposal
          </button>
          <div id="proposal-status" class="text-sm text-center hidden"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function openCreateProposal() { document.getElementById('create-proposal-modal').classList.remove('hidden') }
    function closeCreateProposal() { document.getElementById('create-proposal-modal').classList.add('hidden') }

    async function submitProposal() {
      const title = document.getElementById('proposal-title').value.trim()
      const desc = document.getElementById('proposal-desc').value.trim()
      const status = document.getElementById('proposal-status')
      const wallet = window.connectedWallet || localStorage.getItem('wallet_addr')

      if (!title) { status.classList.remove('hidden'); status.textContent = 'Title required'; status.className = 'text-sm text-center text-red-6'; return }
      if (!wallet) { status.classList.remove('hidden'); status.textContent = 'Connect wallet first'; status.className = 'text-sm text-center text-red-6'; return }

      const API = window.API_BASE || 'http://localhost:3008'
      try {
        const res = await fetch(API + '/governance/proposals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ daoId: 1, title, description: desc, proposerWallet: wallet })
        })
        const data = await res.json()
        if (data.success) { location.reload() }
        else { status.classList.remove('hidden'); status.textContent = data.error || 'Failed'; status.className = 'text-sm text-center text-red-6' }
      } catch { status.classList.remove('hidden'); status.textContent = 'Network error'; status.className = 'text-sm text-center text-red-6' }
    }

    async function castVote(proposalId, optionIndex) {
      const wallet = window.connectedWallet || localStorage.getItem('wallet_addr')
      if (!wallet) { alert('Connect wallet first'); return }

      const API = window.API_BASE || 'http://localhost:3008'
      try {
        const res = await fetch(API + '/governance/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ proposalId, voterWallet: wallet, optionIndex })
        })
        const data = await res.json()
        if (data.success) { location.reload() }
        else { alert(data.error || 'Vote failed') }
      } catch { alert('Network error') }
    }
  </script>
@endsection
