                      <div class="vote-bar-fill {{ tally.option === 'For' ? 'vote-for' : tally.option === 'Against' ? 'vote-against' : 'bg-blue-5' }}" style="width: {{ proposal.totalVotes > 0 ? (tally.count / proposal.totalVotes * 100) : 0 }}%"></div>
