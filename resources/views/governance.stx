<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
let proposals = []
let treasury = null
let error = null

try {
  const [proposalsRes, treasuryRes] = await Promise.all([
    fetch(`${API_URL}/governance/proposals?limit=50`),
    fetch(`${API_URL}/governance/treasury`),
  ])
  if (proposalsRes.ok) {
    const data = await proposalsRes.json()
    proposals = data.data || []
  }
  if (treasuryRes.ok) {
    const data = await treasuryRes.json()
    treasury = data.treasuries?.[0] || null
  }
} catch (err) {
  console.error('Failed to fetch governance data:', err)
  error = 'Failed to load governance data'
}

function timeLeft(dateStr) {
  if (!dateStr) return ''
  const diff = new Date(dateStr).getTime() - Date.now()
  if (diff <= 0) return 'Ended'
  const hours = Math.floor(diff / 3600000)
  if (hours > 24) return Math.floor(hours / 24) + 'd left'
  return hours + 'h left'
}
</script>

<style>
  .vote-bar { height: 8px; border-radius: 4px; background: #e5e7eb; overflow: hidden; }
  .vote-bar-fill { height: 100%; border-radius: 4px; transition: width 0.5s ease; }
  .vote-for { background: #22c55e; }
  .vote-against { background: #ef4444; }
  .proposal-card { transition: box-shadow 0.15s; }
  .proposal-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
</style>

@layout('default')
@section('title', 'Governance | Naked NFTs')
@section('content')
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
