    <!-- Activity Tab (hidden by default) -->
    <div id="panel-activity" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 hidden">
      <div class="coll-activity-container">
        <div class="flex justify-center py-8">
          <div class="spinner h-6 w-6 border-4 border-pink-8 border-t-transparent rounded-full"></div>
        </div>
      </div>
    </div>

    <script client>
      {
        var COLL_API = window.API_BASE || 'http://localhost:3008'
        var _collSlug = window.location.pathname.split('/').pop()
        var _collNftPage = 1
        var _collNftHasMore = true
        var _collNftLoading = false
        var _collFilterTimer = null
        var _currentView = 'grid'
        var _currentTab = 'items'

        // Tab switching
        window.switchTab = function(tab) {
          _currentTab = tab
          document.getElementById('panel-items').classList.toggle('hidden', tab !== 'items')
          document.getElementById('panel-activity').classList.toggle('hidden', tab !== 'activity')
          document.getElementById('tab-items').className = 'px-4 py-3 text-sm ' + (tab === 'items' ? 'tab-active' : 'tab-inactive')
          document.getElementById('tab-activity').className = 'px-4 py-3 text-sm ' + (tab === 'activity' ? 'tab-active' : 'tab-inactive')
          if (tab === 'activity') loadCollectionActivity()
        }

        // View toggle
        window.setView = function(view) {
          _currentView = view
          document.getElementById('nftGrid').classList.toggle('hidden', view !== 'grid')
          document.getElementById('nftList').classList.toggle('hidden', view !== 'list')
          document.getElementById('view-grid').className = 'view-btn rounded p-1.5 ' + (view === 'grid' ? 'view-btn-active' : 'text-gray-4')
          document.getElementById('view-list').className = 'view-btn rounded p-1.5 ' + (view === 'list' ? 'view-btn-active' : 'text-gray-4')
        }

        // Stats auto-refresh
        function refreshStats() {
          fetch(COLL_API + '/marketplace/collections/' + _collSlug + '/stats')
            .then(function(r) { return r.json() })
            .then(function(s) {
              var bar = document.getElementById('statsBar')
              if (!bar) return
              var floor = bar.querySelector('.stats-floor')
              var listed = bar.querySelector('.stats-listed')
              var volume = bar.querySelector('.stats-volume')
              var owners = bar.querySelector('.stats-owners')
              var offer = bar.querySelector('.stats-best-offer')
              var supply = bar.querySelector('.stats-supply')
              if (floor && s.floorPrice !== null) floor.innerHTML = Number(s.floorPrice).toFixed(2) + ' <span class="text-xs font-normal text-gray-5">SOL</span>'
              if (listed) listed.textContent = s.listedCount + ' / ' + s.totalSupply
              if (volume && s.totalVolume) volume.innerHTML = Number(s.totalVolume).toFixed(1) + ' <span class="text-xs font-normal text-gray-5">SOL</span>'
              if (owners) owners.textContent = s.ownersCount || '--'
              if (offer && s.bestOffer) offer.innerHTML = Number(s.bestOffer).toFixed(2) + ' <span class="text-xs font-normal text-gray-5">SOL</span>'
              if (supply) supply.textContent = s.totalSupply || '--'
            })
            .catch(function() {})
        }
        refreshStats()
        setInterval(refreshStats, 30000)

        // Filter helpers
        function getCollFilters() {
          return {
            status: (document.querySelector('.coll-filter-status') || {}).value || 'all',
            minPrice: (document.querySelector('.coll-filter-min') || {}).value || '',
            maxPrice: (document.querySelector('.coll-filter-max') || {}).value || '',
            rarity: (document.querySelector('.coll-filter-rarity') || {}).value || '',
            sort: (document.querySelector('.coll-filter-sort') || {}).value || 'recent'
          }
        }

        function buildFilterQuery(page) {
          var f = getCollFilters()
          var q = '?page=' + page + '&limit=50'
          if (f.status !== 'all') q += '&forSale=' + (f.status === 'listed' ? 'true' : 'false')
          if (f.minPrice) q += '&minPrice=' + f.minPrice
          if (f.maxPrice) q += '&maxPrice=' + f.maxPrice
          if (f.rarity) q += '&rarity=' + encodeURIComponent(f.rarity)
          if (f.sort) q += '&sort=' + f.sort
          return q
        }

        function rarityClass(r) {
          if (!r) return 'rarity-common'
          return 'rarity-' + r.toLowerCase()
        }

        function nftCardHtml(nft) {
          var price = nft.listing_price ? (Number(nft.listing_price) / 1e9).toFixed(2) : (nft.price ? Number(nft.price).toFixed(2) : null)
          var html = '<div class="nft-card bg-white rounded-lg overflow-hidden border border-gray-100 hover:border-gray-300 hover:shadow-md transition cursor-pointer" onclick="NFTModal.open(' + nft.id + ')">'
            + '<div class="aspect-square relative"><img src="' + (nft.image_url || '/assets/images/anonymouse.png') + '" alt="' + (nft.name || '') + '" class="w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" />'
          if (nft.rarity) html += '<span class="absolute top-2 left-2 text-[10px] font-bold px-1.5 py-0.5 rounded ' + rarityClass(nft.rarity) + '">' + nft.rarity + '</span>'
          if (nft.is_for_sale) html += '<div class="nft-actions absolute bottom-2 left-2 right-2"><button onclick="event.stopPropagation(); collBuyNow(this)" data-nft-id="' + nft.id + '" class="w-full bg-pink-8 hover:bg-pink-9 text-white text-xs font-semibold py-2 rounded transition shadow-lg">Buy Now</button></div>'
          html += '</div><div class="p-2.5"><p class="font-semibold text-sm text-gray-9 truncate">' + (nft.name || '') + '</p><div class="flex items-center justify-between mt-1">'
          if (price) html += '<p class="text-sm font-bold text-gray-9">' + price + ' <span class="text-xs font-normal text-gray-4">SOL</span></p>'
          else html += '<p class="text-xs text-gray-4">Not Listed</p>'
          if (nft.rarity_rank) html += '<p class="text-[10px] text-gray-4">#' + nft.rarity_rank + '</p>'
          html += '</div>'
          html += '<button onclick="event.stopPropagation(); collToggleOffer(this)" data-nft-id="' + nft.id + '" class="mt-1.5 w-full bg-gray-100 hover:bg-gray-200 text-gray-7 text-xs font-medium py-1.5 rounded transition">Offer</button>'
          html += '<div style="display:none" class="mt-1.5 coll-offer-form"><input type="number" step="0.01" min="0" placeholder="SOL" class="w-full h-7 rounded border border-gray-200 px-2 text-xs coll-offer-amount" onclick="event.stopPropagation()" /><button onclick="event.stopPropagation(); collSubmitOffer(this)" data-nft-id="' + nft.id + '" class="mt-1 w-full bg-pink-8 hover:bg-pink-9 text-white text-xs font-semibold py-1.5 rounded transition">Submit</button></div>'
          html += '</div></div>'
          return html
        }

        function nftRowHtml(nft) {
          var price = nft.listing_price ? (Number(nft.listing_price) / 1e9).toFixed(2) + ' SOL' : (nft.price ? nft.price + ' SOL' : '--')
          var owner = nft.owner_wallet_address ? nft.owner_wallet_address.slice(0,4) + '...' + nft.owner_wallet_address.slice(-4) : ''
          return '<tr class="border-b border-gray-50 hover:bg-gray-50 cursor-pointer" onclick="NFTModal.open(' + nft.id + ')">'
            + '<td class="py-2 px-2 flex items-center gap-2"><img src="' + (nft.image_url || '/assets/images/anonymouse.png') + '" class="h-8 w-8 rounded object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" /><span class="font-medium text-gray-9 truncate max-w-[120px]">' + (nft.name || '') + '</span></td>'
            + '<td class="py-2 px-2">' + (nft.rarity ? '<span class="text-[10px] font-bold px-1.5 py-0.5 rounded ' + rarityClass(nft.rarity) + '">' + nft.rarity + '</span>' : '') + '</td>'
            + '<td class="py-2 px-2 text-right font-semibold text-gray-9">' + price + '</td>'
            + '<td class="py-2 px-2 text-right text-gray-5">' + (nft.rarity_rank || '--') + '</td>'
            + '<td class="py-2 px-2 text-right text-gray-4 font-mono text-xs">' + owner + '</td>'
            + '</tr>'
        }

        window.collNftFilterChanged = function() {
          clearTimeout(_collFilterTimer)
          _collFilterTimer = setTimeout(function() {
            _collNftPage = 1
            _collNftHasMore = true
            var grid = document.getElementById('nftGrid')
            var listBody = document.getElementById('nftListBody')
            var skeleton = document.getElementById('nftSkeleton')
            if (skeleton) skeleton.classList.remove('hidden')
            if (grid) grid.classList.add('hidden')

            fetch(COLL_API + '/marketplace/collections/' + _collSlug + buildFilterQuery(1))
              .then(function(res) { return res.json() })
              .then(function(data) {
                var nfts = data.nfts || []
                if (nfts.length < 50) _collNftHasMore = false
                var gridHtml = '', listHtml = ''
                for (var i = 0; i < nfts.length; i++) {
                  gridHtml += nftCardHtml(nfts[i])
                  listHtml += nftRowHtml(nfts[i])
                }
                if (grid) { grid.innerHTML = gridHtml; grid.classList.remove('hidden') }
                if (listBody) listBody.innerHTML = listHtml
                if (skeleton) skeleton.classList.add('hidden')
                var loadMore = document.getElementById('loadMoreWrap')
                if (loadMore) loadMore.style.display = _collNftHasMore ? '' : 'none'
              })
              .catch(function(err) {
                console.error('Filter failed:', err)
                if (skeleton) skeleton.classList.add('hidden')
                if (grid) grid.classList.remove('hidden')
              })
          }, 300)
        }

        window.collNftLoadMore = async function(btn) {
          if (_collNftLoading || !_collNftHasMore) return
          _collNftLoading = true
          btn.disabled = true
          btn.textContent = 'Loading...'
          _collNftPage++
          try {
            var res = await fetch(COLL_API + '/marketplace/collections/' + _collSlug + buildFilterQuery(_collNftPage))
            var data = await res.json()
            var nfts = data.nfts || []
            if (nfts.length < 50) _collNftHasMore = false
            var grid = document.getElementById('nftGrid')
            var listBody = document.getElementById('nftListBody')
            for (var i = 0; i < nfts.length; i++) {
              if (grid) grid.insertAdjacentHTML('beforeend', nftCardHtml(nfts[i]))
              if (listBody) listBody.insertAdjacentHTML('beforeend', nftRowHtml(nfts[i]))
            }
            if (!_collNftHasMore) btn.parentNode.style.display = 'none'
          } catch (err) {
            console.error('Load more failed:', err)
            _collNftPage--
          }
          _collNftLoading = false
          btn.disabled = false
          btn.textContent = 'Load More'
        }

        // Activity
        function collActivityIcon(type) {
          if (type === 'mint') return '<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>'
          if (type === 'sale' || type === 'buy') return '<svg class="h-5 w-5 text-pink-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" /></svg>'
          if (type === 'offer') return '<svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>'
          if (type === 'list') return '<svg class="h-5 w-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>'
          return '<svg class="h-5 w-5 text-gray-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>'
        }

        function collActivityLabel(type) {
          var labels = { mint: 'Minted', sale: 'Sold', buy: 'Sold', offer: 'Offer', list: 'Listed', delist: 'Delisted', transfer: 'Transfer' }
          return labels[type] || type || 'Activity'
        }

        function loadCollectionActivity() {
          var containers = document.getElementsByClassName('coll-activity-container')
          var container = containers[0]
          if (!container) return
          fetch(COLL_API + '/marketplace/activity?collectionSlug=' + _collSlug + '&limit=20')
            .then(function(res) { return res.json() })
            .then(function(data) {
              var events = data.events || data.activity || []
              if (events.length === 0) {
                container.innerHTML = '<p class="text-center text-gray-5 py-12">No activity for this collection yet</p>'
                return
              }
              var html = '<div class="space-y-2">'
              for (var i = 0; i < events.length; i++) {
                var e = events[i]
                var addr = e.wallet_address || e.address || ''
                var shortAddr = addr ? addr.slice(0, 4) + '...' + addr.slice(-4) : ''
                var nftName = e.nft_name || e.name || 'NFT #' + (e.nft_id || '')
                var timeAgo = e.created_at ? new Date(e.created_at).toLocaleDateString() : ''
                var amount = e.amount || e.price ? Number(e.amount || e.price).toFixed(2) + ' SOL' : ''
                html += '<div class="flex items-center justify-between bg-white rounded-lg p-3 border border-gray-100 hover:border-gray-200 transition">'
                  + '<div class="flex items-center space-x-3"><div class="shrink-0">' + collActivityIcon(e.type || e.event_type) + '</div>'
                  + '<div><p class="font-medium text-sm text-gray-8">' + nftName + '</p>'
                  + '<p class="text-xs text-gray-4">' + collActivityLabel(e.type || e.event_type) + (shortAddr ? ' by ' + shortAddr : '') + '</p></div></div>'
                  + '<div class="text-right">' + (amount ? '<p class="font-semibold text-sm text-gray-9">' + amount + '</p>' : '') + (timeAgo ? '<p class="text-[10px] text-gray-4">' + timeAgo + '</p>' : '') + '</div></div>'
              }
              html += '</div>'
              container.innerHTML = html
            })
            .catch(function() { container.innerHTML = '<p class="text-center text-gray-5 py-12">Failed to load activity</p>' })
        }

        // Buy / Offer actions
        window.collBuyNow = async function(btn) {
          var nftId = btn.dataset.nftId
          var walletAddr = localStorage.getItem('wallet_addr')
          if (!walletAddr) {
            if (window.Toast) Toast.error('Connect your wallet first')
            else alert('Connect your wallet first')
            return
          }
          btn.disabled = true; btn.textContent = 'Buying...'
          try {
            var res = await fetch(COLL_API + '/nfts/buy', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nftId: Number(nftId), buyerWalletAddress: walletAddr }) })
            var data = await res.json()
            if (data.error) { if (window.Toast) Toast.error(data.error); else alert(data.error) }
            else {
              if (data.transaction && data.transaction.serializedTransaction) {
                if (window.Toast) Toast.info('Approve in your wallet...')
                var sig = await WalletManager.signAndSend(data.transaction.serializedTransaction)
                await fetch(COLL_API + '/nfts/confirm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ signature: sig, nftId: Number(nftId), action: 'buy' }) })
              }
              if (window.Toast) Toast.success('Purchase successful!')
              else alert('Purchase successful!')
              setTimeout(function() { window.location.reload() }, 2000)
            }
          } catch (err) { if (window.Toast) Toast.error('Failed to buy'); else alert('Failed to buy') }
          btn.disabled = false; btn.textContent = 'Buy Now'
        }

        window.collToggleOffer = function(btn) {
          var form = btn.nextElementSibling
          if (form) form.style.display = form.style.display === 'none' ? '' : 'none'
        }

        window.collSubmitOffer = async function(btn) {
          var nftId = btn.dataset.nftId
          var walletAddr = localStorage.getItem('wallet_addr')
          if (!walletAddr) { if (window.Toast) Toast.error('Connect your wallet first'); else alert('Connect wallet'); return }
          var amountInput = btn.previousElementSibling
          var amount = amountInput ? amountInput.value : ''
          if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) { if (window.Toast) Toast.error('Enter valid amount'); else alert('Enter valid amount'); return }
          btn.disabled = true; btn.textContent = 'Submitting...'
          try {
            var res = await fetch(COLL_API + '/nfts/offer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nftId: Number(nftId), amount: Number(amount), buyerWalletAddress: walletAddr }) })
            var data = await res.json()
            if (data.error) { if (window.Toast) Toast.error(data.error); else alert(data.error) }
            else { if (window.Toast) Toast.success('Offer submitted!'); else alert('Offer submitted!'); btn.parentNode.style.display = 'none'; if (amountInput) amountInput.value = '' }
          } catch (err) { if (window.Toast) Toast.error('Failed'); else alert('Failed') }
          btn.disabled = false; btn.textContent = 'Submit'
        }
      }
    </script>
  @endif
@endsection
