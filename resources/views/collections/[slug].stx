<script server>
// Fetch collection data from API
const API_URL = process.env.API_URL || 'http://localhost:3008'
const collectionSlug = slug || ''
let collection = null
let nfts = []
let hasMore = false
let error = null

try {
  const res = await fetch(`${API_URL}/marketplace/collections/${collectionSlug}`)
  if (res.ok) {
    const data = await res.json()
    collection = data.collection
    nfts = data.nfts || data.collection?.nfts || []
    hasMore = (data.page || 1) < (data.totalPages || 1)
  } else {
    error = 'Collection not found'
  }
} catch (err) {
  console.error('Failed to fetch collection:', err)
  error = 'Failed to load collection'
}

const pageTitle = `${collection?.name || 'Collection'} | Naked NFTs`
</script>

<style>
  .progress-bar { transition: width 0.5s ease-in-out; }
  .stat-delta-up { color: #059669; }
  .stat-delta-down { color: #dc2626; }
  .tab-active { border-bottom: 2px solid #E50570; color: #1E2321; font-weight: 600; }
  .tab-inactive { border-bottom: 2px solid transparent; color: #9ca3af; }
  .tab-inactive:hover { color: #6b7280; border-color: #e5e7eb; }
  .skeleton { background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
  @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
  .nft-card:hover .nft-actions { opacity: 1; }
  .nft-actions { opacity: 0; transition: opacity 0.15s; }
  .view-btn-active { background: #1E2321; color: white; }
  .rarity-legendary { background: #fef3c7; color: #92400e; }
  .rarity-epic { background: #ede9fe; color: #6d28d9; }
  .rarity-rare { background: #dbeafe; color: #1d4ed8; }
  .rarity-uncommon { background: #d1fae5; color: #065f46; }
  .rarity-common { background: #f3f4f6; color: #6b7280; }
</style>

@layout('default')
@section('title', pageTitle)
@section('content')
