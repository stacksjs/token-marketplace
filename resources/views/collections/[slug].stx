      @endif

      <!-- Mint NFT (devnet) -->
      <div class="mt-8 border-t border-gray-100 pt-6" data-mint-section>
        <button onclick="var f=this.nextElementSibling;f.style.display=f.style.display==='none'?'':'none'" class="text-sm text-gray-5 hover:text-gray-8 transition">+ Mint New NFT (devnet)</button>
        <div data-mint-form style="display:none" class="mt-4 max-w-md space-y-3">
          <input id="mintName" type="text" placeholder="NFT Name *" class="w-full h-9 rounded-lg border border-gray-200 px-3 text-sm" />
          <input id="mintDesc" type="text" placeholder="Description" class="w-full h-9 rounded-lg border border-gray-200 px-3 text-sm" />
          <input id="mintImage" type="url" placeholder="Image URL" class="w-full h-9 rounded-lg border border-gray-200 px-3 text-sm" />
          <input id="mintSymbol" type="text" placeholder="Symbol" maxlength="10" class="w-full h-9 rounded-lg border border-gray-200 px-3 text-sm" />
          <button onclick="window.__doMint(this,'{{ collection.mint_address }}')" class="w-full bg-pink-8 hover:bg-pink-9 text-white font-semibold py-2.5 rounded-lg transition text-sm">Mint NFT On-Chain</button>
