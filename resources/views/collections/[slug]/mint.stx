    <script client>
      function mintComponent() {
        return {
          view: 0,
          qty: 1,
          walletAddr: '',
          walletBal: '',
          minting: false,
          mintResult: null,
          canMint: false,
          mintStatus: '',
          _mintPriceSol: 0,
          _candyMachineId: null,
          _presaleId: null,
          _apiUrl: 'http://localhost:3008',
          get isConnectView() { return this.view === 0 },
          get isMintView() { return this.view === 1 },
          get isSuccessView() { return this.view === 2 },
          get totalPrice() {
            return (this._mintPriceSol * this.qty).toFixed(4) + ' SOL'
          },
          get mintBtnText() {
            if (this.minting) return 'Minting...'
            if (!this.canMint) return this.mintStatus === 'sold_out' ? 'Sold Out' : 'Minting Not Available'
            return 'Mint Now'
          },
          get explorerUrl() {
            if (!this.mintResult?.mintAddress) return '#'
            return 'https://explorer.solana.com/address/' + this.mintResult.mintAddress + '?cluster=devnet'
          },
          get shortMintAddr() {
            if (!this.mintResult?.mintAddress) return ''
            return this.mintResult.mintAddress.slice(0, 8) + '...' + this.mintResult.mintAddress.slice(-8)
          },
          get shortWalletAddr() {
            if (!this.walletAddr) return ''
            return this.walletAddr.slice(0, 4) + '...' + this.walletAddr.slice(-4)
          },
          init() {
            this.canMint = this.$el.dataset.canMint === 'true'
            this.mintStatus = this.$el.dataset.mintStatus || ''
            this._mintPriceSol = Number(this.$el.dataset.mintPriceSol) || 0
            this._candyMachineId = this.$el.dataset.candyMachineId ? Number(this.$el.dataset.candyMachineId) : null
            this._presaleId = this.$el.dataset.presaleId ? Number(this.$el.dataset.presaleId) : null
            this._apiUrl = this.$el.dataset.apiUrl || 'http://localhost:3008'
            if (WalletManager.isConnected()) {
              this.onWalletConnect(WalletManager.getAddress())
            }
          },
          async onWalletConnect(addr) {
            this.view = 1
            this.walletAddr = addr
            await this.updateBalance()
          },
          onWalletDisconnect() {
            this.view = 0
          },
          mintAnother() {
            this.view = 1
            this.qty = 1
          },
          async updateBalance() {
            const bal = await WalletManager.getBalance()
            this.walletBal = bal ? 'Balance: ' + bal + ' SOL' : 'Balance: — SOL'
          },
          async doMint() {
            if (!this.canMint || this.minting) return
            const walletAddress = WalletManager.getAddress()
            if (!walletAddress || !this._candyMachineId) return
            this.minting = true
            try {
              const response = await fetch(this._apiUrl + '/mint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ candyMachineId: this._candyMachineId, walletAddress: walletAddress, presaleId: this._presaleId })
              })
              const result = await response.json()
              if (result.success) {
                this.mintResult = result.mint
                this.view = 2
              } else {
                Toast.error(result.error || 'Mint failed')
              }
            } catch (err) {
              console.error('Mint error:', err)
              Toast.error('Failed to mint. Please try again.')
            } finally {
              this.minting = false
            }
          }
        }
      }
    </script>
  @endif
@endsection
