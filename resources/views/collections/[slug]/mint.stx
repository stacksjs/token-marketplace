    <script client>
      {
        var _mintRoot = document.currentScript.previousElementSibling
        var _configEl = _mintRoot ? (function() {
          var cards = _mintRoot.children[0].children[1]
          if (!cards) return null
          var inner = cards.children[0]
          if (!inner) return null
          var rows = inner.children
          for (var i = 0; i < rows.length; i++) {
            if (rows[i].dataset && rows[i].dataset.apiUrl) return rows[i]
          }
          return null
        })() : null

        // Read config from data attributes
        var apiUrl = _configEl ? (_configEl.dataset.apiUrl || 'http://localhost:3008') : 'http://localhost:3008'
        var candyMachineId = _configEl && _configEl.dataset.candyMachineId ? Number(_configEl.dataset.candyMachineId) : null
        var mintPriceSol = _configEl ? Number(_configEl.dataset.mintPriceSol) || 0 : 0
        var presaleId = _configEl && _configEl.dataset.presaleId ? Number(_configEl.dataset.presaleId) : null
        var canMintFlag = _configEl ? _configEl.dataset.canMint === 'true' : false
        var mintStatusVal = _configEl ? (_configEl.dataset.mintStatus || '') : ''

        // State
        var mintQty = 1
        var mintWalletAddress = ''
        var isMinting = false

        // The 3 state divs are children of _configEl
        function getMintStates() {
          if (!_configEl) return null
          return {
            connect: _configEl.children[0],
            mint: _configEl.children[1],
            success: _configEl.children[2]
          }
        }

        function showMintState(state) {
          var s = getMintStates()
          if (!s) return
          if (s.connect) s.connect.style.display = state === 0 ? '' : 'none'
          if (s.mint) s.mint.style.display = state === 1 ? '' : 'none'
          if (s.success) s.success.style.display = state === 2 ? '' : 'none'
        }

        function getMintEls() {
          var s = getMintStates()
          if (!s || !s.mint) return {}
          // mint state: walletRow > left > avatar + info(ml-3) > p.addr, p.bal
          var walletRow = s.mint.children[0]
          var infoDiv = walletRow ? walletRow.children[0].children[1] : null
          // qty row: children[1] > btn, span, btn
          var qtyRow = s.mint.children[1]
          // total row: children[2] > span, span
          var totalRow = s.mint.children[2]
          // mint button: children[3]
          var mintBtn = s.mint.children[3]
          // success: explorer link is in s.success.children[3].children[1] (the <a>)
          var explorerP = s.success ? s.success.children[3] : null
          var explorerLink = explorerP ? explorerP.children[0] : null

          return {
            addrEl: infoDiv ? infoDiv.children[0] : null,
            balEl: infoDiv ? infoDiv.children[1] : null,
            qtyEl: qtyRow ? qtyRow.children[1] : null,
            totalEl: totalRow ? totalRow.children[1] : null,
            mintBtn: mintBtn,
            explorerLink: explorerLink
          }
        }

        function updateTotal() {
          var els = getMintEls()
          if (els.totalEl) els.totalEl.textContent = (mintPriceSol * mintQty).toFixed(4) + ' SOL'
        }

        function updateMintBtn() {
          var els = getMintEls()
          if (!els.mintBtn) return
          if (isMinting) {
            els.mintBtn.textContent = 'Minting...'
            els.mintBtn.disabled = true
          } else if (!canMintFlag) {
            els.mintBtn.textContent = mintStatusVal === 'sold_out' ? 'Sold Out' : 'Minting Not Available'
            els.mintBtn.disabled = true
          } else {
            els.mintBtn.textContent = 'Mint Now'
            els.mintBtn.disabled = false
          }
        }

        function getMintProvider() {
          if (window.phantom?.solana) return window.phantom.solana
          if (window.solana?.isPhantom) return window.solana
          if (window.solflare) return window.solflare
          if (window.backpack) return window.backpack
          if (window.solana) return window.solana
          return null
        }

        window.mintPageConnect = async function(btn) {
          var provider = getMintProvider()
          if (!provider) {
            window.open('https://phantom.app/', '_blank')
            return
          }
          try {
            var resp = await provider.connect()
            var addr = resp.publicKey.toString()
            var res = await fetch(apiUrl + '/wallet/connect', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ walletAddress: addr }),
            })
            var data = await res.json()
            if (data.success) {
              mintWalletAddress = data.address
              var els = getMintEls()
              if (els.addrEl) els.addrEl.textContent = addr.slice(0, 4) + '...' + addr.slice(-4)
              if (els.balEl) els.balEl.textContent = 'Balance: — SOL'
              showMintState(1)
            }
          } catch (err) {
            console.error('Mint wallet connect failed:', err)
          }
        }

        window.mintPageDisconnect = async function(btn) {
          try {
            await fetch(apiUrl + '/wallet/disconnect', { method: 'POST' })
          } catch (_) {}
          var provider = getMintProvider()
          if (provider) { try { await provider.disconnect() } catch (_) {} }
          mintWalletAddress = ''
          showMintState(0)
        }

        window.mintDecQty = function(btn) {
          if (mintQty > 1) {
            mintQty--
            var qtyEl = btn.nextElementSibling
            if (qtyEl) qtyEl.textContent = mintQty
            updateTotal()
          }
        }

        window.mintIncQty = function(btn) {
          if (mintQty < 10) {
            mintQty++
            var qtyEl = btn.previousElementSibling
            if (qtyEl) qtyEl.textContent = mintQty
            updateTotal()
          }
        }

        window.doMint = async function(btn) {
          if (!canMintFlag || isMinting) return
          if (!mintWalletAddress || !candyMachineId) return
          isMinting = true
          updateMintBtn()
          try {
            var res = await fetch(apiUrl + '/mint', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ candyMachineId: candyMachineId, walletAddress: mintWalletAddress, presaleId: presaleId })
            })
            var result = await res.json()
            if (result.success) {
              var mintAddr = result.mint?.mintAddress || ''
              var els = getMintEls()
              if (els.explorerLink) {
                els.explorerLink.href = 'https://explorer.solana.com/address/' + mintAddr + '?cluster=devnet'
                els.explorerLink.textContent = mintAddr.slice(0, 8) + '...' + mintAddr.slice(-8)
              }
              showMintState(2)
            } else {
              console.error('Mint failed:', result.error || 'Unknown error')
            }
          } catch (err) {
            console.error('Mint error:', err)
          } finally {
            isMinting = false
            updateMintBtn()
          }
        }

        window.mintAnother = function(btn) {
          mintQty = 1
          var els = getMintEls()
          if (els.qtyEl) els.qtyEl.textContent = '1'
          updateTotal()
          showMintState(1)
        }

        // Initialize
        updateTotal()
        updateMintBtn()

        // Check if wallet already connected (e.g. from Header)
        var initProvider = getMintProvider()
        if (initProvider && initProvider.isConnected && initProvider.publicKey) {
          mintWalletAddress = initProvider.publicKey.toString()
          var els = getMintEls()
          if (els.addrEl) els.addrEl.textContent = mintWalletAddress.slice(0, 4) + '...' + mintWalletAddress.slice(-4)
          if (els.balEl) els.balEl.textContent = 'Balance: — SOL'
          showMintState(1)
        }
      }
    </script>
  @endif
@endsection
