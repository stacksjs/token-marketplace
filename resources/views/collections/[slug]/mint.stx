                      <span class="text-gray-8 text-xs">{{ new Date(mintData.candyMachine.guardsConfig.endDate.date * 1000).toLocaleString() }}</span>
                    </div>
                  @endif
                  @if(mintData.candyMachine.guardsConfig.mintLimit)
                    <div class="flex items-center justify-between text-sm text-gray-5 mt-1">
