                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <p class="text-white font-semibold mint-wallet-addr"></p>
                        <p class="text-sm text-gray-5 mint-wallet-bal"></p>
                      </div>
                    </div>
                    <button onclick="mintPageDisconnect(this)" class="text-gray-5 hover:text-white text-sm">Disconnect</button>
