        <select id="auction-type-filter" class="border border-gray-3 rounded-lg px-3 py-2 text-sm text-gray-7 outline-none" onchange="filterAuctions(this.value)">
          <option value="all">All Types</option>
          <option value="english">English Auctions</option>
