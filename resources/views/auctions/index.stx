<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
let activeAuctions = []
let endedAuctions = []
let error = null

try {
  const [activeRes, endedRes] = await Promise.all([
    fetch(`${API_URL}/marketplace/auctions/active?limit=50`),
    fetch(`${API_URL}/marketplace/auctions/ended?limit=10`),
  ])
  if (activeRes.ok) {
    const data = await activeRes.json()
    activeAuctions = data.data || []
  }
  if (endedRes.ok) {
    const data = await endedRes.json()
    endedAuctions = data.data || []
  }
} catch (err) {
  console.error('Failed to fetch auctions:', err)
  error = 'Failed to load auctions'
}

function formatSol(lamports) {
  if (!lamports && lamports !== 0) return '—'
  const sol = typeof lamports === 'number' && lamports > 1000 ? lamports / 1e9 : lamports
  return sol.toFixed(2) + ' SOL'
}

function formatAddress(addr) {
  if (!addr) return '—'
  return addr.slice(0, 4) + '...' + addr.slice(-4)
}
</script>

<style>
  .countdown { font-variant-numeric: tabular-nums; }
  .auction-card { transition: transform 0.15s, box-shadow 0.15s; }
  .auction-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
  .badge-english { background: #dbeafe; color: #1d4ed8; }
  .badge-dutch { background: #fef3c7; color: #92400e; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
</style>

@layout('default')
@section('title', 'Auctions | Naked NFTs')
@section('content')
