<!-- Drawer panel - shown/hidden via window.DrawerManager -->
<div>
  <!-- Backdrop -->
  <div onclick="DrawerManager.close()" style="display:none" class="fixed inset-0 z-50 bg-black/60"></div>

  <!-- Panel -->
  <div style="display:none; transform:translateX(100%)" class="fixed right-0 top-0 h-full w-full max-w-lg bg-white shadow-2xl overflow-y-auto z-50" data-drawer-panel>
    <!-- Close Button -->
    <button onclick="DrawerManager.close()" type="button" class="absolute top-4 right-4 z-10 h-8 w-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-5 hover:text-gray-8 transition">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Content -->
    <div></div>
  </div>
</div>

<script client>
  {
    var _drawerRoot = document.currentScript.previousElementSibling

    window.DrawerManager = {
      open: function() {
        if (!_drawerRoot) return
        var backdrop = _drawerRoot.children[0]
        var panel = _drawerRoot.children[1]
        if (backdrop) backdrop.style.display = ''
        if (panel) {
          panel.style.display = ''
          panel.style.transform = 'translateX(0)'
        }
      },
      close: function() {
        if (!_drawerRoot) return
        var backdrop = _drawerRoot.children[0]
        var panel = _drawerRoot.children[1]
        if (backdrop) backdrop.style.display = 'none'
        if (panel) {
          panel.style.transform = 'translateX(100%)'
          setTimeout(function() { panel.style.display = 'none' }, 300)
        }
      },
      setContent: function(html) {
        if (!_drawerRoot) return
        var panel = _drawerRoot.children[1]
        if (panel) {
          var content = panel.children[1]
          if (content) content.innerHTML = html
        }
      }
    }
  }
</script>
