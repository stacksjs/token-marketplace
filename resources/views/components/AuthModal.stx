<!-- Auth Modal - wallet-only authentication -->
<div>
  <!-- Backdrop -->
  <div onclick="AuthManager.closeModal()" style="display:none" class="fixed inset-0 z-[55] bg-black/60"></div>

  <!-- Panel -->
  <div style="display:none" class="fixed inset-0 z-[55] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden relative">
      <!-- Close -->
      <button onclick="AuthManager.closeModal()" class="absolute top-4 right-4 h-8 w-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-5 hover:text-gray-8 transition">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="p-8 text-center">
        <!-- Connect Wallet View -->
        <div>
          <div class="mx-auto mb-4 h-16 w-16 flex items-center justify-center rounded-full bg-pink-100">
            <svg class="h-8 w-8 text-pink-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-9 mb-2">Connect Your Wallet</h2>
          <p class="text-gray-5 mb-6">Connect your Solana wallet to sign in. Your wallet is your identity.</p>
          <button onclick="AuthManager.connectWallet(this)" class="w-full bg-pink-8 hover:bg-pink-9 text-white font-semibold py-3 rounded-lg transition text-sm">
            Connect Wallet
          </button>
          <p class="mt-4 text-xs text-gray-4">Supports Phantom, Solflare, Backpack, and other Solana wallets</p>
        </div>

        <!-- Signing View (shown during auth flow) -->
        <div style="display:none">
          <div class="mx-auto mb-4 h-16 w-16 flex items-center justify-center rounded-full bg-blue-100">
            <svg class="h-8 w-8 text-blue-600 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-9 mb-2">Sign Message</h2>
          <p class="text-gray-5 mb-4">Please approve the signature request in your wallet to verify ownership.</p>
        </div>

        <!-- Success View -->
        <div style="display:none">
          <div class="mx-auto mb-4 h-16 w-16 flex items-center justify-center rounded-full bg-emerald-100">
            <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-9 mb-2">Connected!</h2>
          <p class="text-gray-5 mb-4">Your wallet is connected and authenticated.</p>
          <button onclick="AuthManager.closeModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-lg transition text-sm">
            Continue
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script client>
  {
    var _authRoot = document.currentScript.previousElementSibling
    var AUTH_API = window.API_BASE || 'http://localhost:3008'

    function getAuthViews() {
      if (!_authRoot) return null
      var panel = _authRoot.children[1]
      if (!panel) return null
      var inner = panel.children[0]
      if (!inner) return null
      var content = inner.children[1]
      if (!content) return null
      return {
        backdrop: _authRoot.children[0],
        panel: panel,
        connect: content.children[0],
        signing: content.children[1],
        success: content.children[2]
      }
    }

    function showAuthStep(step) {
      var v = getAuthViews()
      if (!v) return
      if (v.connect) v.connect.style.display = step === 0 ? '' : 'none'
      if (v.signing) v.signing.style.display = step === 1 ? '' : 'none'
      if (v.success) v.success.style.display = step === 2 ? '' : 'none'
    }

    window.AuthManager = {
      _token: localStorage.getItem('auth_token'),

      isLoggedIn: function() { return !!this._token },
      getToken: function() { return this._token },

      open: function() {
        var v = getAuthViews()
        if (!v) return
        if (v.backdrop) v.backdrop.style.display = ''
        if (v.panel) v.panel.style.display = ''
        showAuthStep(0)
      },

      closeModal: function() {
        var v = getAuthViews()
        if (!v) return
        if (v.backdrop) v.backdrop.style.display = 'none'
        if (v.panel) v.panel.style.display = 'none'
      },

      connectWallet: async function(btn) {
        var provider = null
        if (window.phantom && window.phantom.solana) provider = window.phantom.solana
        else if (window.solana && window.solana.isPhantom) provider = window.solana
        else if (window.solflare) provider = window.solflare
        else if (window.backpack) provider = window.backpack
        else if (window.solana) provider = window.solana

        if (!provider) {
          window.open('https://phantom.app/', '_blank')
          return
        }

        try {
          showAuthStep(1)
          var resp = await provider.connect()
          var addr = resp.publicKey.toString()

          // Get challenge
          var challengeRes = await fetch(AUTH_API + '/auth/wallet/challenge', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ walletAddress: addr })
          })
          var challengeData = await challengeRes.json()

          if (challengeData.nonce && challengeData.message) {
            // Sign message
            var encodedMsg = new TextEncoder().encode(challengeData.message)
            var signResult = await provider.signMessage(encodedMsg, 'utf8')
            var sigArr = new Uint8Array(signResult.signature)
            var sigStr = ''
            for (var i = 0; i < sigArr.length; i++) {
              sigStr += String.fromCharCode(sigArr[i])
            }
            var sigBase64 = btoa(sigStr)

            // Verify
            var verifyRes = await fetch(AUTH_API + '/auth/wallet/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                walletAddress: addr,
                signature: sigBase64,
                nonce: challengeData.nonce
              })
            })
            var verifyData = await verifyRes.json()

            if (verifyData.token) {
              this._token = verifyData.token
              localStorage.setItem('auth_token', verifyData.token)
              localStorage.setItem('wallet_addr', addr)
              showAuthStep(2)
              if (window.Toast) Toast.success('Wallet connected and authenticated')
              setTimeout(function() { AuthManager.closeModal() }, 1500)
              return
            }
          }

          // Fallback: just store wallet addr
          localStorage.setItem('wallet_addr', addr)
          showAuthStep(2)
          setTimeout(function() { AuthManager.closeModal() }, 1500)
        } catch (err) {
          console.error('Wallet auth failed:', err)
          showAuthStep(0)
          if (window.Toast) Toast.error('Wallet connection failed')
        }
      },

      logout: function() {
        this._token = null
        localStorage.removeItem('auth_token')
        localStorage.removeItem('wallet_addr')
        if (window.Toast) Toast.success('Signed out')
      }
    }
  }
</script>
