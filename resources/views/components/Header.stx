  const navLinks = [
    { name: "Home", href: "/", active: true },
    { name: "Explore", href: "/collections", active: true },
    { name: "Rarity", href: "/rarity", active: true },
    { name: "Staking", href: "#", active: false, tooltip: "Coming soon" },
    { name: "Grassroots", href: "#", active: false, tooltip: "Our DAO & DAO framework. Coming soon." }
  ]
</script>

<header>
  <nav class="border-b border-gray-7 bg-gray-9">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-20 justify-between">
        <div class="flex justify-between">
          <div class="flex shrink-0 items-center">
            <a href="/" class="rounded-md focus:bg-pink-custom-2 focus:outline-none lg:px-2">
              <h1 class="font-serif text-xl uppercase text-gray-50 md:text-2xl font-medium">
                Naked <span class="text-pink-8"> /NFT<span class="lowercase">s</span> </span>
              </h1>
            </a>
          </div>

          <div class="font-gilroy hidden md:ml-6 md:flex md:items-center lg:space-x-4">
            @foreach(navLinks as link)
              @if(link.active)
                <a
                  href="{{ link.href }}"
                  class="rounded-md px-3 py-2 font-bold text-gray-100 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none"
                >
                  {{ link.name }}
                </a>
              @else
                <a
                  href="#"
                  data-tippy-content="{{ link.tooltip }}"
                  class="rounded-md px-3 py-2 font-bold text-gray-5 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none"
                >
                  {{ link.name }}
                </a>
              @endif
            @endforeach
          </div>
        </div>

        <div class="hidden items-center md:flex">
          <div class="shrink-0">
            <button
              onclick="connectWallet(this)"
              type="button"
              class="inline-flex items-center justify-center rounded-md border border-transparent bg-pink-8 px-4 py-2 text-base font-semibold text-white shadow-sm transition duration-150 ease-out hover:bg-pink-9 focus:outline-none focus:ring-2 focus:ring-pink-700 focus:ring-offset-2"
            >
              Connect Wallet
            </button>
            <div class="flex items-center space-x-3" style="display:none">
              <a href="/profile" class="rounded-md px-3 py-2 font-bold text-gray-100 transition duration-150 ease-in-out hover:text-pink-8 focus:bg-pink-custom-2 focus:outline-none text-sm">
                My NFTs
              </a>
              <div class="flex items-center space-x-2 bg-gray-8 rounded-md px-3 py-2">
                <div class="h-2 w-2 rounded-full bg-emerald-500"></div>
                <span class="text-sm font-medium text-gray-100 wallet-addr"></span>
              </div>
              <button
                onclick="disconnectWallet(this)"
                type="button"
                class="text-sm text-gray-5 hover:text-white transition duration-150"
              >
                Disconnect
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script client>
  var API_URL = 'http://localhost:3008'

  // Wallet detection matching ts-tokens wallets module
  function getWalletProvider() {
    if (window.phantom?.solana) return window.phantom.solana
    if (window.solana?.isPhantom) return window.solana
    if (window.solflare) return window.solflare
    if (window.backpack) return window.backpack
    if (window.coinbaseSolana) return window.coinbaseSolana
    if (window.trustwallet?.solana) return window.trustwallet.solana
    if (window.exodus?.solana) return window.exodus.solana
    if (window.braveSolana) return window.braveSolana
    if (window.glowSolana) return window.glowSolana
    if (window.solana) return window.solana
    return null
  }

  window.connectWallet = async function(btn) {
    var provider = getWalletProvider()
    if (!provider) {
      window.open('https://phantom.app/', '_blank')
      return
    }
    try {
      var resp = await provider.connect()
      var addr = resp.publicKey.toString()
      var res = await fetch(API_URL + '/wallet/connect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ walletAddress: addr }),
      })
      var data = await res.json()
      if (data.success) {
        var short = data.address.slice(0, 4) + '...' + data.address.slice(-4)
        btn.style.display = 'none'
        var panel = btn.nextElementSibling
        panel.style.display = 'flex'
        panel.children[1].children[1].textContent = short
      }
    } catch (err) {
      console.error('Wallet connect failed:', err)
    }
  }

  window.disconnectWallet = async function(btn) {
    try {
      await fetch(API_URL + '/wallet/disconnect', { method: 'POST' })
    } catch (_) {}
    var provider = getWalletProvider()
    if (provider) { try { await provider.disconnect() } catch (_) {} }
    var panel = btn.parentNode
    panel.style.display = 'none'
    panel.previousElementSibling.style.display = ''
  }
</script>
