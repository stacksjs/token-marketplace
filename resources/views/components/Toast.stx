<!-- Toast notification - shown/hidden via window.Toast -->
<div style="display:none" class="fixed top-4 right-4 z-[60] text-white px-5 py-3 rounded-lg shadow-lg text-sm font-medium">
  <span></span>
</div>

<script client>
  {
    var _toastEl = document.currentScript.previousElementSibling
    var _toastTimer = null

    window.Toast = {
      show: function(msg, type) {
        if (!_toastEl) return
        var span = _toastEl.children[0]
        if (!span) return
        span.textContent = msg
        _toastEl.className = 'fixed top-4 right-4 z-[60] text-white px-5 py-3 rounded-lg shadow-lg text-sm font-medium '
          + (type === 'error' ? 'bg-red-600' : type === 'warning' ? 'bg-yellow-500' : 'bg-emerald-600')
        _toastEl.style.display = ''
        clearTimeout(_toastTimer)
        _toastTimer = setTimeout(function() { _toastEl.style.display = 'none' }, 3500)
      },
      success: function(msg) { this.show(msg, 'success') },
      error: function(msg) { this.show(msg, 'error') },
      warning: function(msg) { this.show(msg, 'warning') }
    }
  }
</script>
