<style>
  .mobile-wallet-qr { display: none; }
  .mobile-wallet-links { display: none; }

  @media (max-width: 768px) {
    .mobile-wallet-links { display: block; }
    .mobile-wallet-qr { display: none; }
  }
  @media (min-width: 769px) {
    .mobile-wallet-qr { display: block; }
  }

  .wallet-option { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 12px; cursor: pointer; transition: all 0.15s; width: 100%; text-align: left; background: white; }
  .wallet-option:hover { border-color: #E50570; background: #fdf2f8; }
  .wallet-option img { width: 36px; height: 36px; border-radius: 8px; }
  .wallet-option .name { font-weight: 600; font-size: 14px; color: #1E2321; }
  .wallet-option .desc { font-size: 12px; color: #9ca3af; }

  .pull-refresh { position: fixed; top: 0; left: 0; right: 0; height: 60px; display: flex; align-items: center; justify-content: center; transform: translateY(-100%); transition: transform 0.3s; z-index: 50; background: white; border-bottom: 1px solid #e5e7eb; }
  .pull-refresh.active { transform: translateY(0); }
  .pull-spinner { width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #E50570; border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Touch-optimized styles */
  @media (max-width: 768px) {
    .nft-card { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
    .modal-content { border-radius: 16px 16px 0 0; position: fixed; bottom: 0; left: 0; right: 0; max-height: 85vh; overflow-y: auto; }
  }
</style>

<!-- Pull to refresh indicator -->
<div id="pull-refresh" class="pull-refresh">
  <div class="pull-spinner"></div>
  <span style="margin-left: 8px; font-size: 14px; color: #9ca3af;">Refreshing...</span>
</div>

<!-- Mobile wallet deep links -->
<div id="mobile-wallet-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" onclick="closeMobileWalletModal()"></div>
  <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl p-6 max-h-[80vh] overflow-y-auto">
    <div class="w-12 h-1 bg-gray-3 rounded-full mx-auto mb-4"></div>
    <h3 class="text-lg font-bold text-gray-9 mb-4">Connect Wallet</h3>
    <div class="space-y-3">
      <button class="wallet-option" onclick="connectMobileWallet('phantom')">
        <img src="https://phantom.app/img/phantom-icon-purple.svg" alt="Phantom" onerror="this.style.display='none'" />
        <div>
          <div class="name">Phantom</div>
          <div class="desc">Popular Solana wallet</div>
        </div>
      </button>
      <button class="wallet-option" onclick="connectMobileWallet('solflare')">
        <img src="https://solflare.com/favicon.ico" alt="Solflare" onerror="this.style.display='none'" />
        <div>
          <div class="name">Solflare</div>
          <div class="desc">Feature-rich wallet</div>
        </div>
      </button>
      <button class="wallet-option" onclick="connectMobileWallet('backpack')">
        <div style="width:36px;height:36px;border-radius:8px;background:#1E2321;display:flex;align-items:center;justify-content:center;color:white;font-size:18px;">B</div>
        <div>
          <div class="name">Backpack</div>
          <div class="desc">Multi-chain wallet</div>
        </div>
      </button>
    </div>
    <button class="w-full mt-4 py-3 text-sm text-gray-5 hover:text-gray-7" onclick="closeMobileWalletModal()">Cancel</button>
  </div>
</div>

<script>
  // Mobile wallet deep links
  function connectMobileWallet(wallet) {
    const currentUrl = encodeURIComponent(window.location.href)
    const deepLinks = {
      phantom: `https://phantom.app/ul/browse/${currentUrl}`,
      solflare: `https://solflare.com/ul/v1/browse/${currentUrl}`,
      backpack: `https://backpack.app/ul/browse/${currentUrl}`,
    }

    // Try native app first on mobile
    if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
      const nativeLinks = {
        phantom: `phantom://browse/${currentUrl}`,
        solflare: `solflare://browse/${currentUrl}`,
        backpack: `backpack://browse/${currentUrl}`,
      }
      window.location.href = nativeLinks[wallet] || deepLinks[wallet]
      // Fallback to web after timeout
      setTimeout(() => { window.location.href = deepLinks[wallet] }, 2000)
    } else {
      window.location.href = deepLinks[wallet]
    }
    closeMobileWalletModal()
  }

  function openMobileWalletModal() {
    document.getElementById('mobile-wallet-modal').classList.remove('hidden')
  }
  function closeMobileWalletModal() {
    document.getElementById('mobile-wallet-modal').classList.add('hidden')
  }

  // Pull to refresh (mobile)
  if ('ontouchstart' in window) {
    let startY = 0
    let pulling = false

    document.addEventListener('touchstart', e => {
      if (window.scrollY === 0) startY = e.touches[0].clientY
    }, { passive: true })

    document.addEventListener('touchmove', e => {
      if (window.scrollY > 0) return
      const diff = e.touches[0].clientY - startY
      if (diff > 80 && !pulling) {
        pulling = true
        document.getElementById('pull-refresh').classList.add('active')
      }
    }, { passive: true })

    document.addEventListener('touchend', () => {
      if (pulling) {
        pulling = false
        setTimeout(() => {
          location.reload()
        }, 500)
      }
    })
  }

  // Long-press on NFT cards for quick actions
  let longPressTimer = null
  document.addEventListener('touchstart', e => {
    const card = e.target.closest('.nft-card')
    if (!card) return
    longPressTimer = setTimeout(() => {
      const nftId = card.dataset.nftId
      if (nftId) showQuickActions(nftId, e.touches[0].clientX, e.touches[0].clientY)
    }, 600)
  }, { passive: true })

  document.addEventListener('touchend', () => {
    clearTimeout(longPressTimer)
  })
  document.addEventListener('touchmove', () => {
    clearTimeout(longPressTimer)
  })

  function showQuickActions(nftId, x, y) {
    // Haptic feedback if available
    if (navigator.vibrate) navigator.vibrate(50)

    // Show contextual menu (simplified)
    const actions = ['List', 'Transfer', 'Make Offer']
    const action = actions[0] // In production, show a popup menu
    console.log('Quick action on NFT', nftId, action)
  }
</script>
