<style>
  .onboard-tooltip {
    position: absolute; z-index: 30;
    background: #1E2321; color: white; padding: 10px 14px;
    border-radius: 10px; font-size: 13px; max-width: 220px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    animation: tooltipFade 0.3s ease;
    pointer-events: auto;
  }
  .onboard-tooltip::after {
    content: ''; position: absolute; width: 8px; height: 8px;
    background: #1E2321; transform: rotate(45deg);
  }
  .onboard-tooltip.bottom::after { top: -4px; left: 50%; margin-left: -4px; }
  .onboard-tooltip.top::after { bottom: -4px; left: 50%; margin-left: -4px; }
  .onboard-tooltip button { background: rgba(255,255,255,0.2); border: none; color: white; padding: 4px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; margin-top: 6px; }
  .onboard-tooltip button:hover { background: rgba(255,255,255,0.3); }
  @keyframes tooltipFade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  .onboard-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.15); z-index: 29; }

  .help-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 50; display: none; align-items: center; justify-content: center; }
  .help-modal-overlay.active { display: flex; }
  .help-modal { background: white; border-radius: 16px; max-width: 480px; width: 90%; max-height: 80vh; overflow-y: auto; padding: 24px; }
  .help-step { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f3f4f6; }
  .help-step:last-child { border-bottom: none; }
  .help-step-num { width: 28px; height: 28px; border-radius: 50%; background: #E50570; color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }
</style>

<!-- "What is an NFT?" Help Modal -->
<div id="help-modal" class="help-modal-overlay" onclick="if(event.target===this)closeHelpModal()">
  <div class="help-modal">
    <h3 style="font-size: 20px; font-weight: 700; color: #1E2321; margin-bottom: 16px;">What is an NFT?</h3>
    <p style="font-size: 14px; color: #6b7280; margin-bottom: 16px;">NFTs (Non-Fungible Tokens) are unique digital assets on the blockchain. Each one is one-of-a-kind and can represent art, collectibles, music, and more.</p>

    <h4 style="font-size: 16px; font-weight: 600; color: #1E2321; margin-bottom: 12px;">How to get started:</h4>
    <div class="help-step">
      <div class="help-step-num">1</div>
      <div><strong style="color: #1E2321;">Browse Collections</strong><br/><span style="font-size: 13px; color: #6b7280;">Explore different NFT collections without needing a wallet.</span></div>
    </div>
    <div class="help-step">
      <div class="help-step-num">2</div>
      <div><strong style="color: #1E2321;">Connect Your Wallet</strong><br/><span style="font-size: 13px; color: #6b7280;">Use Phantom, Solflare, or Backpack to connect your Solana wallet.</span></div>
    </div>
    <div class="help-step">
      <div class="help-step-num">3</div>
      <div><strong style="color: #1E2321;">Buy or Mint</strong><br/><span style="font-size: 13px; color: #6b7280;">Purchase listed NFTs or mint new ones directly from a collection.</span></div>
    </div>
    <div class="help-step">
      <div class="help-step-num">4</div>
      <div><strong style="color: #1E2321;">Trade & Earn</strong><br/><span style="font-size: 13px; color: #6b7280;">List your NFTs for sale, make offers, participate in auctions, and stake for rewards.</span></div>
    </div>

    <button onclick="closeHelpModal()" style="width: 100%; margin-top: 16px; padding: 10px; background: #E50570; color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">Got it!</button>
  </div>
</div>

<script>
  function openHelpModal() { document.getElementById('help-modal').classList.add('active') }
  function closeHelpModal() { document.getElementById('help-modal').classList.remove('active') }

  // First-time visitor tooltips
  (function() {
    if (localStorage.getItem('onboarded')) return

    // Show help modal for first-time visitors after 3 seconds
    setTimeout(() => {
      if (!localStorage.getItem('onboarded')) {
        // Don't show automatically - just mark that tooltips are available
        // Users can click "?" button in header to open
      }
    }, 3000)

    // Mark as onboarded after first interaction
    document.addEventListener('click', function onFirstClick() {
      localStorage.setItem('onboarded', 'true')
      document.removeEventListener('click', onFirstClick)
    }, { once: true })
  })()
</script>
