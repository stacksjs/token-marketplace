          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-7 mb-1">Expiry (optional)</label>
            <select id="offer-expiry" class="w-full border border-gray-3 rounded-lg px-4 py-2.5 text-gray-7 outline-none">
              <option value="">No expiry</option>
              <option value="1">1 day</option>
              <option value="3">3 days</option>
              <option value="7">7 days</option>
              <option value="30">30 days</option>
            </select>
          </div>
          <button class="w-full bg-pink-7 hover:bg-pink-8 text-white font-semibold py-3 rounded-lg transition" onclick="submitOffer()">
            Submit Offer
          </button>
          <div id="offer-status" class="mt-3 text-sm text-center hidden"></div>
        </div>
      </div>
    </div>

    <script>
      // Tab switching
      function switchTab(tab) {
        const tabs = document.querySelectorAll('#detail-tabs button')
        const panels = ['traits', 'offers', 'activity']

        tabs.forEach((t, i) => {
          if (panels[i] === tab) {
            t.className = 'tab-active py-2 text-sm'
          } else {
            t.className = 'tab-inactive py-2 text-sm'
          }
        })

        panels.forEach(p => {
          const el = document.getElementById('panel-' + p)
          if (el) el.classList.toggle('hidden', p !== tab)
        })
      }

      // Copy to clipboard
      function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
          const toast = document.getElementById('copy-toast')
          toast.classList.add('show')
          setTimeout(() => toast.classList.remove('show'), 2000)
        })
      }

      // Buy modal
      function openBuyModal() { document.getElementById('buy-modal').classList.remove('hidden') }
      function closeBuyModal() { document.getElementById('buy-modal').classList.add('hidden') }

      async function confirmBuy() {
        const btn = document.getElementById('confirm-buy-btn')
        const status = document.getElementById('buy-status')
        btn.disabled = true
        btn.textContent = 'Processing...'
        status.classList.remove('hidden')
        status.textContent = 'Preparing transaction...'
        status.className = 'mt-3 text-sm text-center text-gray-5'

        try {
          const res = await fetch('/nfts/buy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nftId: {{ nft.id }} }),
          })
          const data = await res.json()
          if (data.transaction) {
            status.textContent = 'Please approve the transaction in your wallet...'
            // Wallet signing would happen here
          } else {
            status.textContent = data.error || 'Failed to create transaction'
            status.className = 'mt-3 text-sm text-center text-red-6'
          }
        } catch (err) {
          status.textContent = 'Network error. Please try again.'
          status.className = 'mt-3 text-sm text-center text-red-6'
        } finally {
          btn.disabled = false
          btn.textContent = 'Confirm Purchase'
        }
      }

      // Offer modal
      function openOfferModal() { document.getElementById('offer-modal').classList.remove('hidden') }
      function closeOfferModal() { document.getElementById('offer-modal').classList.add('hidden') }

      async function submitOffer() {
        const amount = document.getElementById('offer-amount').value
        const expiryDays = document.getElementById('offer-expiry').value
        const status = document.getElementById('offer-status')

        if (!amount || Number(amount) <= 0) {
          status.classList.remove('hidden')
          status.textContent = 'Please enter a valid amount'
          status.className = 'mt-3 text-sm text-center text-red-6'
          return
        }

        status.classList.remove('hidden')
        status.textContent = 'Submitting offer...'
        status.className = 'mt-3 text-sm text-center text-gray-5'

        try {
          const body = { nftId: {{ nft.id }}, amount: Number(amount) }
          if (expiryDays) {
            const expiry = new Date()
            expiry.setDate(expiry.getDate() + Number(expiryDays))
            body.expiryAt = expiry.toISOString()
          }

          const res = await fetch('/nfts/offer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          })
          const data = await res.json()
          if (data.transaction || data.success) {
            status.textContent = 'Offer submitted! Please approve in your wallet.'
            status.className = 'mt-3 text-sm text-center text-green-6'
          } else {
            status.textContent = data.error || 'Failed to submit offer'
            status.className = 'mt-3 text-sm text-center text-red-6'
          }
        } catch (err) {
          status.textContent = 'Network error. Please try again.'
          status.className = 'mt-3 text-sm text-center text-red-6'
        }
      }

      // Placeholder owner action modals
      function openListModal() { alert('List for Sale flow - connect wallet first') }
      function openTransferModal() { alert('Transfer flow - connect wallet first') }
      function openBurnModal() { if (confirm('Are you sure you want to burn this NFT? This is irreversible.')) alert('Burn flow - connect wallet first') }
      function openBidModal() { alert('Place Bid flow - connect wallet first') }

      // Show owner actions if wallet matches
      document.addEventListener('DOMContentLoaded', () => {
        const ownerAddr = '{{ nft.owner_wallet_address || "" }}'
        if (ownerAddr && window.connectedWallet === ownerAddr) {
          document.getElementById('owner-actions')?.classList.remove('hidden')
          // Show accept buttons on offers
          document.querySelectorAll('.offer-accept-btn').forEach(b => b.classList.remove('hidden'))
        }
        // Show cancel buttons if offerer matches
        // This would need the offerer addresses to be checked against connectedWallet
      })
    </script>
  @endif
@endsection
