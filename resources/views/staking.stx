<script server>
const API_URL = process.env.API_URL || 'http://localhost:3008'
let pools = []
let error = null

try {
  const res = await fetch(`${API_URL}/staking/pools?limit=50`)
  if (res.ok) {
    const data = await res.json()
    pools = data.data || []
  }
} catch (err) {
  console.error('Failed to fetch staking pools:', err)
  error = 'Failed to load staking pools'
}
</script>

@layout('default')
@section('title', 'Staking | Naked NFTs')
@section('content')
