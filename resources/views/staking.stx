  <!-- Stake Modal -->
  <div id="stake-modal" class="fixed inset-0 z-40 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeStakeModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 relative">
        <button class="absolute top-4 right-4 text-gray-4 hover:text-gray-6" onclick="closeStakeModal()">✕</button>
        <h3 class="text-xl font-bold text-gray-9 mb-4">Stake NFT</h3>
        <p class="text-sm text-gray-5 mb-4" id="stake-pool-name"></p>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-7 mb-1">NFT Mint Address</label>
          <input id="stake-nft-mint" type="text" placeholder="Enter NFT mint address" class="w-full border border-gray-3 rounded-lg px-4 py-2.5 text-gray-8 outline-none focus:ring-2 focus:ring-pink-5" />
        </div>
        <button class="w-full bg-pink-7 hover:bg-pink-8 text-white font-semibold py-3 rounded-lg transition" onclick="submitStake()">
          Confirm Stake
        </button>
        <div id="stake-status" class="mt-3 text-sm text-center hidden"></div>
      </div>
    </div>
  </div>

  <script>
    let _stakePoolId = null

    function openStakeModal(poolId, poolName) {
      _stakePoolId = poolId
      document.getElementById('stake-pool-name').textContent = 'Staking to: ' + poolName
      document.getElementById('stake-modal').classList.remove('hidden')
    }

    function closeStakeModal() {
      document.getElementById('stake-modal').classList.add('hidden')
    }

    async function submitStake() {
      const mint = document.getElementById('stake-nft-mint').value.trim()
      const status = document.getElementById('stake-status')
      if (!mint) { status.classList.remove('hidden'); status.textContent = 'Enter a mint address'; status.className = 'mt-3 text-sm text-center text-red-6'; return }

      const wallet = window.connectedWallet || localStorage.getItem('wallet_addr')
      if (!wallet) { status.classList.remove('hidden'); status.textContent = 'Connect wallet first'; status.className = 'mt-3 text-sm text-center text-red-6'; return }

      status.classList.remove('hidden')
      status.textContent = 'Staking...'
      status.className = 'mt-3 text-sm text-center text-gray-5'

      const API = window.API_BASE || 'http://localhost:3008'
      try {
        const res = await fetch(API + '/staking/stake', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ poolId: _stakePoolId, nftMint: mint, stakerWallet: wallet })
        })
        const data = await res.json()
        if (data.success) {
          status.textContent = 'NFT staked successfully!'
          status.className = 'mt-3 text-sm text-center text-green-6'
          setTimeout(() => location.reload(), 1500)
        } else {
          status.textContent = data.error || 'Staking failed'
          status.className = 'mt-3 text-sm text-center text-red-6'
        }
      } catch {
        status.textContent = 'Network error'
        status.className = 'mt-3 text-sm text-center text-red-6'
      }
    }

    async function claimRewards(poolId) {
      const wallet = window.connectedWallet || localStorage.getItem('wallet_addr')
      if (!wallet) { alert('Connect wallet first'); return }

      const API = window.API_BASE || 'http://localhost:3008'
      try {
        const res = await fetch(API + '/staking/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ poolId, stakerWallet: wallet })
        })
        const data = await res.json()
        if (data.success) {
          alert('Claimed ' + data.rewards + ' rewards!')
          location.reload()
        } else {
          alert(data.error || 'Claim failed')
        }
      } catch {
        alert('Network error')
      }
    }

    // Load user stake info on page load
    document.addEventListener('DOMContentLoaded', async () => {
      const wallet = window.connectedWallet || localStorage.getItem('wallet_addr')
      if (!wallet) return

      const API = window.API_BASE || 'http://localhost:3008'
      document.querySelectorAll('.stake-user-info').forEach(async el => {
        const poolId = el.dataset.poolId
        try {
          const res = await fetch(API + '/staking/pool/' + poolId + '?wallet=' + wallet)
          if (!res.ok) return
          const data = await res.json()
          if (data.userStakes && data.userStakes.length > 0) {
            el.classList.remove('hidden')
            el.querySelector('.user-stake-count').textContent = data.userStakes.length
            el.querySelector('.user-pending-rewards').textContent = data.pendingRewards.toFixed(4)
          }
        } catch {}
      })
    })
  </script>
@endsection
