<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Browse all NFT collections on Naked NFTs marketplace">
  <title>All Collections | Naked NFTs - Cross-Chain NFT Marketplace</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <script>
    import MainLayout from './components/MainLayout.stx'

    // Collections Data
    const collections = [
      {
        name: "Hoodratz",
        slug: "hoodratz",
        description: "A collection of 10,000 unique Hoodratz NFTs",
        imageUrl: "/assets/images/hoodie.png",
        heroImageUrl: "/assets/images/king-hoodrat.png",
        isLive: true
      },
      {
        name: "Crypto Punks",
        slug: "crypto-punks",
        description: "The original pixel art NFT collection",
        imageUrl: "/assets/images/hoodie.png",
        heroImageUrl: "/assets/images/anonymouse.png",
        isLive: true
      },
      {
        name: "Bored Apes",
        slug: "bored-apes",
        description: "A collection of 10,000 unique Bored Apes",
        imageUrl: "/assets/images/anonymouse.png",
        heroImageUrl: "/assets/images/hoodie.png",
        isLive: true
      }
    ]
  </script>
</head>
<body class="antialiased font-sans bg-white text-gray-9">
  <MainLayout>
    <!-- Page Content -->
    <div class="pb-10">
      <!-- Page Header -->
      <div class="px-4 pt-24 sm:flex sm:flex-col sm:items-center sm:justify-center sm:px-6 lg:px-8 xl:px-0">
        <h1 class="mt-4 text-6xl font-bold tracking-tight text-gray-8">All Collections</h1>

        <!-- Search Bar -->
        <div class="mt-5 mb-10">
          <div class="relative mt-1 flex items-center">
            <input
              type="text"
              name="search"
              id="search"
              class="block h-12 w-full sm:w-110 rounded-md border-gray-300 border pr-12 shadow-sm focus:border-pink-8 focus:ring-pink-8 sm:text-sm px-4"
              placeholder="Search Collections..."
            />
            <div class="absolute inset-y-0 right-0 flex py-1.5 pr-1.5">
              <button class="inline-flex items-center px-2 font-sans text-sm font-medium text-gray-700 transition duration-150 ease-in-out hover:text-gray-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Collections Grid -->
      <div class="mt-10 mb-24 xl:mx-auto xl:max-w-7xl">
        <div class="grid grid-cols-1 gap-8 px-4 md:grid-cols-2 lg:grid-cols-3">
          @foreach(collections as collection)
            <a
              href="/collections/{{ collection.slug }}"
              class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden rounded-lg bg-gray-0.25 p-6 transition duration-150 ease-in-out hover:opacity-75 xl:w-auto"
            >
              <!-- Hero Image -->
              <span aria-hidden="true" class="absolute inset-0">
                <img
                  src="{{ collection.heroImageUrl }}"
                  alt="{{ collection.name }} Portrait"
                  class="h-1/2 w-full object-cover object-center"
                />
              </span>

              <!-- Profile Image -->
              <span aria-hidden="true" class="relative top-32">
                <img
                  src="{{ collection.imageUrl }}"
                  alt="{{ collection.name }} Profile"
                  class="h-36 w-36 rounded-full border-4 border-white object-cover object-center"
                />
              </span>

              <!-- Live Indicator -->
              @if(collection.isLive)
                <div class="relative top-36 flex items-center justify-center font-semibold text-gray-8">
                  <div class="flex">
                    <div class="flex items-center">
                      <div class="h-2.5 w-2.5 shrink-0 animate-pulse rounded-full bg-emerald-700" aria-hidden="true"></div>
                      <span class="ml-2 text-sm uppercase">Live</span>
                    </div>
                  </div>
                </div>
              @endif

              <!-- Collection Name -->
              <span class="relative mt-40 break-all text-center text-xl font-bold text-gray-8">{{ collection.name }}</span>

              <!-- Description -->
              <p class="relative text-center text-sm text-gray-8 mt-2">
                {{ collection.description }}
              </p>
            </a>
          @endforeach
        </div>
      </div>
    </div>
  </MainLayout>
</body>
</html>
