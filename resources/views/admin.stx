  <script client>
    {
      var _adminRoot = document.currentScript.previousElementSibling
      var ADMIN_API = window.API_BASE || 'http://localhost:3008'

      function getAdminEl(cls) {
        var els = _adminRoot.getElementsByClassName(cls)
        return els[0] || null
      }

      function getVal(cls) {
        var el = getAdminEl(cls)
        return el ? el.value : ''
      }

      function setResult(cls, msg, isError) {
        var el = getAdminEl(cls)
        if (el) {
          el.textContent = msg
          el.style.color = isError ? '#dc2626' : '#16a34a'
          setTimeout(function() { el.textContent = '' }, 6000)
        }
      }

      function adminHeaders() {
        var h = { 'Content-Type': 'application/json' }
        var token = localStorage.getItem('auth_token')
        if (token) h['Authorization'] = 'Bearer ' + token
        return h
      }

      window.adminSwitchTab = function(idx, btn) {
        var panels = btn.parentNode.nextElementSibling
        if (!panels) return
        var tabs = panels.children
        for (var i = 0; i < tabs.length; i++) {
          tabs[i].style.display = i === idx ? '' : 'none'
        }
        var tabBar = btn.parentNode
        var buttons = tabBar.children
        for (var j = 0; j < buttons.length; j++) {
          if (j === idx) {
            buttons[j].className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg bg-white text-gray-9 shadow-sm transition'
          } else {
            buttons[j].className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg text-gray-6 hover:text-gray-8 transition'
          }
        }
        if (idx === 0) loadCollectionsList()
      }

      function loadCollectionsList() {
        var els = _adminRoot.getElementsByClassName('admin-collections-list')
        var el = els[0]
        if (!el) return
        fetch(ADMIN_API + '/marketplace/collections?limit=100')
          .then(function(r) { return r.json() })
          .then(function(data) {
            var cols = data.collections || []
            if (cols.length === 0) {
              el.innerHTML = '<p class="text-gray-4">No collections found</p>'
              return
            }
            var html = '<div class="overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b border-gray-200">'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">ID</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Name</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Slug</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">NFTs</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Floor</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Minting</th>'
              + '</tr></thead><tbody>'
            for (var i = 0; i < cols.length; i++) {
              var c = cols[i]
              html += '<tr class="border-b border-gray-100 hover:bg-gray-50">'
                + '<td class="py-2 px-3 text-gray-5">' + (c.id || '-') + '</td>'
                + '<td class="py-2 px-3 font-medium text-gray-8">' + (c.name || '-') + '</td>'
                + '<td class="py-2 px-3 text-gray-5">' + (c.slug || '-') + '</td>'
                + '<td class="py-2 px-3 text-gray-6">' + (c.nft_count || c.nftCount || 0) + '</td>'
                + '<td class="py-2 px-3 text-gray-6">' + (c.floor_price || c.floorPrice ? (c.floor_price || c.floorPrice) + ' SOL' : '-') + '</td>'
                + '<td class="py-2 px-3">' + (c.is_minting || c.isMinting ? '<span class="text-emerald-600 font-semibold">Active</span>' : '<span class="text-gray-4">No</span>') + '</td>'
                + '</tr>'
            }
            html += '</tbody></table></div>'
            el.innerHTML = html
          })
          .catch(function() { el.innerHTML = '<p class="text-red-500">Failed to load collections</p>' })
      }

      window.adminCreateCollection = async function(btn) {
        var name = getVal('admin-coll-name').trim()
        if (!name) { setResult('admin-coll-result', 'Name is required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var body = {
            name: name,
            symbol: getVal('admin-coll-symbol').trim(),
            description: getVal('admin-coll-desc').trim()
          }
          var img = getVal('admin-coll-image').trim()
          if (img) body.image_url = img
          var royalty = getVal('admin-coll-royalty')
          if (royalty) body.royalty_basis_points = Math.round(Number(royalty) * 100)
          var res = await fetch(ADMIN_API + '/marketplace/collections', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-coll-result', 'Collection created! ID: ' + (data.collection ? data.collection.id : 'unknown'), false)
            loadCollectionsList()
          } else {
            setResult('admin-coll-result', data.error || 'Failed to create', true)
          }
        } catch (err) {
          setResult('admin-coll-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Collection'
      }

      window.adminDeployCM = async function(btn) {
        var collId = getVal('admin-cm-collid')
        var items = getVal('admin-cm-items')
        var symbol = getVal('admin-cm-symbol').trim()
        var creator = getVal('admin-cm-creator').trim()
        var colMint = getVal('admin-cm-colmint').trim()
        if (!collId || !items || !symbol || !creator || !colMint) {
          setResult('admin-cm-result', 'Collection ID, items, symbol, creator, and collection mint are required', true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Deploying...'
        try {
          var body = {
            collectionId: Number(collId),
            itemsAvailable: Number(items),
            symbol: symbol,
            creatorAddress: creator,
            collectionMint: colMint
          }
          var price = getVal('admin-cm-price')
          if (price) body.mintPrice = Math.floor(Number(price) * 1e9)
          var fee = getVal('admin-cm-fee')
          if (fee) body.sellerFeeBasisPoints = Number(fee)
          var treasury = getVal('admin-cm-treasury').trim()
          if (treasury) body.treasuryAddress = treasury
          var res = await fetch(ADMIN_API + '/candy-machine', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var cm = data.candyMachine || {}
            setResult('admin-cm-result', 'Deployed! ID: ' + (cm.id || '?') + ', Address: ' + (cm.candyMachineAddress || ''), false)
          } else {
            setResult('admin-cm-result', data.error || 'Failed to deploy', true)
          }
        } catch (err) {
          setResult('admin-cm-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Deploy Candy Machine'
      }

      window.adminAddConfigLines = async function(btn) {
        var cmId = getVal('admin-cl-cmid')
        var linesRaw = getVal('admin-cl-lines').trim()
        if (!cmId || !linesRaw) {
          setResult('admin-cl-result', 'Candy Machine ID and config lines are required', true)
          return
        }
        var lines
        try {
          lines = JSON.parse(linesRaw)
          if (!Array.isArray(lines)) throw new Error('Must be a JSON array')
        } catch (e) {
          setResult('admin-cl-result', 'Invalid JSON: ' + e.message, true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Adding...'
        try {
          var startIdx = Number(getVal('admin-cl-start')) || 0
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/config-lines', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ configLines: lines, startIndex: startIdx })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-cl-result', 'Added ' + (data.linesAdded || lines.length) + ' config lines', false)
          } else {
            setResult('admin-cl-result', data.error || 'Failed to add config lines', true)
          }
        } catch (err) {
          setResult('admin-cl-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Add Config Lines'
      }

      window.adminSetGuards = async function(btn) {
        var cmId = getVal('admin-guard-cmid')
        var action = getVal('admin-guard-action')
        if (!cmId) { setResult('admin-guard-result', 'Candy Machine ID is required', true); return }
        var guards = {}
        var solLamports = getVal('admin-guard-sol')
        var solDest = getVal('admin-guard-dest').trim()
        if (solLamports && solDest) {
          guards.solPayment = { lamports: Number(solLamports), destination: solDest }
        }
        var startDate = getVal('admin-guard-start')
        if (startDate) guards.startDate = { date: new Date(startDate).toISOString() }
        var endDate = getVal('admin-guard-end')
        if (endDate) guards.endDate = { date: new Date(endDate).toISOString() }
        var mintLimit = getVal('admin-guard-limit')
        if (mintLimit) guards.mintLimit = { limit: Number(mintLimit) }
        if (Object.keys(guards).length === 0) {
          setResult('admin-guard-result', 'At least one guard setting is required', true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Submitting...'
        try {
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/guards', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ guards: guards, action: action })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-guard-result', 'Guards ' + action + 'ed successfully', false)
          } else {
            setResult('admin-guard-result', data.error || 'Failed to manage guards', true)
          }
        } catch (err) {
          setResult('admin-guard-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Submit Guards'
      }

      window.adminCreatePresale = async function(btn) {
        var collId = getVal('admin-ps-collid')
        if (!collId) { setResult('admin-ps-result', 'Collection ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var walletsRaw = getVal('admin-ps-wallets').trim()
          var wallets = walletsRaw ? walletsRaw.split('\n').map(function(w) { return w.trim() }).filter(Boolean) : []
          var body = {
            collectionId: Number(collId),
            walletAddresses: wallets,
            maxMintsPerWallet: Number(getVal('admin-ps-maxmints')) || 1,
            isActive: getVal('admin-ps-active') === 'true'
          }
          var discount = getVal('admin-ps-discount')
          if (discount) body.discount = Number(discount)
          var starts = getVal('admin-ps-starts')
          if (starts) body.presaleStartsAt = new Date(starts).toISOString()
          var expires = getVal('admin-ps-expires')
          if (expires) body.presaleExpiresAt = new Date(expires).toISOString()
          var res = await fetch(ADMIN_API + '/presale', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var ps = data.presale || {}
            setResult('admin-ps-result', 'Presale created! ID: ' + (ps.id || '?') + ', UUID: ' + (ps.uuid || ''), false)
          } else {
            setResult('admin-ps-result', data.error || 'Failed to create presale', true)
          }
        } catch (err) {
          setResult('admin-ps-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Presale'
      }

      window.adminUpdatePresale = async function(btn) {
        var psId = getVal('admin-psu-id')
        if (!psId) { setResult('admin-psu-result', 'Presale ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Updating...'
        try {
          var body = {}
          var activeVal = getVal('admin-psu-active')
          if (activeVal) body.isActive = activeVal === 'true'
          var discount = getVal('admin-psu-discount')
          if (discount) body.discount = Number(discount)
          var maxMints = getVal('admin-psu-maxmints')
          if (maxMints) body.maxMintsPerWallet = Number(maxMints)
          var walletsRaw = getVal('admin-psu-wallets').trim()
          if (walletsRaw) body.walletAddresses = walletsRaw.split('\n').map(function(w) { return w.trim() }).filter(Boolean)
          if (Object.keys(body).length === 0) {
            setResult('admin-psu-result', 'At least one field must be changed', true)
            btn.disabled = false
            btn.textContent = 'Update Presale'
            return
          }
          var res = await fetch(ADMIN_API + '/presale/' + psId, {
            method: 'PATCH',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-psu-result', 'Presale updated!', false)
          } else {
            setResult('admin-psu-result', data.error || 'Failed to update', true)
          }
        } catch (err) {
          setResult('admin-psu-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Update Presale'
      }

      window.adminUpdateStatus = async function(btn) {
        var cmId = getVal('admin-status-cmid')
        var newStatus = getVal('admin-status-val')
        if (!cmId) { setResult('admin-status-result', 'Candy Machine ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Updating...'
        try {
          var body = { status: newStatus }
          var msg = getVal('admin-status-msg').trim()
          if (msg) body.message = msg
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/status', {
            method: 'PATCH',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var cm = data.candyMachine || {}
            setResult('admin-status-result', 'Status updated to: ' + (cm.status || newStatus), false)
          } else {
            setResult('admin-status-result', data.error || 'Failed to update status', true)
          }
        } catch (err) {
          setResult('admin-status-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Update Status'
      }

      window.adminUpdateStats = async function(btn) {
        var collId = getVal('admin-stats-collid')
        if (!collId) { setResult('admin-stats-result', 'Collection ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Recalculating...'
        try {
          var res = await fetch(ADMIN_API + '/marketplace/collections/stats', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ collectionId: Number(collId) })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var s = data.stats || {}
            setResult('admin-stats-result', 'Floor: ' + (s.floorPrice || 0) + ' SOL, Volume: ' + (s.volumeTraded || 0) + ' SOL, Holders: ' + (s.uniqueHolders || 0), false)
          } else {
            setResult('admin-stats-result', data.error || 'Failed to recalculate', true)
          }
        } catch (err) {
          setResult('admin-stats-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Recalculate Stats'
      }

      // Auto-load collections on page load
      loadCollectionsList()
    }
  </script>
@endsection
