              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Destination Wallet</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-mint-dest" />
              </div>
            </div>
            <button onclick="adminMintTokens(this)" class="mt-4 bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
              Mint Tokens
            </button>
            <p class="mt-2 text-sm admin-token-mint-result"></p>
          </div>

          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">Transfer Tokens</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Mint Address</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-xfer-mint" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Amount</label>
                <input type="number" min="0" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-xfer-amount" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">From Wallet</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-xfer-from" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">To Wallet</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-xfer-to" />
              </div>
            </div>
            <button onclick="adminTransferTokens(this)" class="mt-4 bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
              Transfer Tokens
            </button>
            <p class="mt-2 text-sm admin-token-xfer-result"></p>
          </div>

          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">Token Info Lookup</h2>
            <div class="flex items-end gap-4">
              <div class="flex-1">
                <label class="block text-sm font-medium text-gray-7 mb-1">Mint Address</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-token-lookup-addr" />
              </div>
              <button onclick="adminLookupToken(this)" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm h-10">
                Lookup
              </button>
            </div>
            <div class="mt-4 admin-token-lookup-result"></div>
          </div>
        </div>

        <!-- Tab 7: NFT Edit -->
        <div style="display:none">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">Update NFT Metadata</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">NFT ID</label>
                <input type="number" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-id" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Wallet Address (owner)</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-wallet" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">New Name</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-name" placeholder="Leave empty for no change" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">New Symbol</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-symbol" maxlength="10" placeholder="Leave empty for no change" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-7 mb-1">New URI</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-uri" placeholder="Leave empty for no change" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">New Royalty BPS</label>
                <input type="number" min="0" max="10000" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-nftedit-bps" placeholder="Leave empty for no change" />
              </div>
            </div>
            <button onclick="adminUpdateNft(this)" class="mt-4 bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
              Update NFT
            </button>
            <p class="mt-2 text-sm admin-nftedit-result"></p>
          </div>
        </div>

        <!-- Tab 8: Bulk Upload -->
        <div style="display:none">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">Bulk Create NFTs</h2>
            <div class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-7 mb-1">Collection ID (optional)</label>
                  <input type="number" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-bulk-collid" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-7 mb-1">Seller Fee BPS (optional)</label>
                  <input type="number" min="0" max="10000" value="500" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-bulk-fee" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">NFT Items (JSON array)</label>
                <textarea rows="10" class="w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono focus:border-pink-8 focus:ring-pink-8 admin-bulk-items" placeholder='[
  {"name": "NFT #1", "uri": "https://arweave.net/..."},
  {"name": "NFT #2", "uri": "https://arweave.net/..."}
]'></textarea>
                <p class="text-xs text-gray-4 mt-1">Each object needs "name" and "uri" fields. Maximum 100 items.</p>
              </div>
            </div>
            <button onclick="adminBulkCreate(this)" class="mt-4 bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
              Create NFTs
            </button>
            <p class="mt-2 text-sm admin-bulk-result"></p>
          </div>
        </div>

        <!-- Tab 9: Multi-sig -->
        <div style="display:none">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">Create Multisig Account</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Name</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-msig-name" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Threshold</label>
                <input type="number" min="1" max="11" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-msig-threshold" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-7 mb-1">Description</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-msig-desc" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Authority Type</label>
                <select class="w-full h-10 rounded border border-gray-300 px-3 text-sm text-gray-7 focus:border-pink-8 focus:ring-pink-8 admin-msig-authtype">
                  <option value="owner">Owner</option>
                  <option value="mint">Mint Authority</option>
                  <option value="freeze">Freeze Authority</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-7 mb-1">Target Mint (optional)</label>
                <input type="text" class="w-full h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-msig-mint" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-7 mb-1">Signer Wallet Addresses (one per line, min 2)</label>
                <textarea rows="4" class="w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono focus:border-pink-8 focus:ring-pink-8 admin-msig-signers" placeholder="WalletAddr1...&#10;WalletAddr2..."></textarea>
              </div>
            </div>
            <button onclick="adminCreateMultisig(this)" class="mt-4 bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">
              Create Multisig
            </button>
            <p class="mt-2 text-sm admin-msig-result"></p>
          </div>

          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-9 mb-4">My Pending Approvals</h2>
            <div>
              <label class="block text-sm font-medium text-gray-7 mb-1">Your Wallet Address</label>
              <div class="flex items-end gap-4">
                <input type="text" class="flex-1 h-10 rounded border border-gray-300 px-3 text-sm focus:border-pink-8 focus:ring-pink-8 admin-msig-mywallet" />
                <button onclick="adminLoadPending(this)" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm h-10">
                  Load
                </button>
              </div>
            </div>
            <div class="mt-4 admin-msig-pending text-gray-5">Enter your wallet address and click Load</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script client>
    {
      var _adminRoot = document.currentScript.previousElementSibling
      var ADMIN_API = window.API_BASE || 'http://localhost:3008'

      function getAdminEl(cls) {
        var els = _adminRoot.getElementsByClassName(cls)
        return els[0] || null
      }

      function getVal(cls) {
        var el = getAdminEl(cls)
        return el ? el.value : ''
      }

      function setResult(cls, msg, isError) {
        var el = getAdminEl(cls)
        if (el) {
          el.textContent = msg
          el.style.color = isError ? '#dc2626' : '#16a34a'
          setTimeout(function() { el.textContent = '' }, 6000)
        }
      }

      function escapeHtml(str) {
        if (!str) return ''
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
      }

      function adminHeaders() {
        var h = { 'Content-Type': 'application/json' }
        var token = localStorage.getItem('auth_token')
        if (token) h['Authorization'] = 'Bearer ' + token
        return h
      }

      window.adminSwitchTab = function(idx, btn) {
        var panels = btn.parentNode.nextElementSibling
        if (!panels) return
        var tabs = panels.children
        for (var i = 0; i < tabs.length; i++) {
          tabs[i].style.display = i === idx ? '' : 'none'
        }
        var tabBar = btn.parentNode
        var buttons = tabBar.children
        for (var j = 0; j < buttons.length; j++) {
          if (j === idx) {
            buttons[j].className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg bg-white text-gray-9 shadow-sm transition'
          } else {
            buttons[j].className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg text-gray-6 hover:text-gray-8 transition'
          }
        }
        if (idx === 0) loadCollectionsList()
      }

      function loadCollectionsList() {
        var els = _adminRoot.getElementsByClassName('admin-collections-list')
        var el = els[0]
        if (!el) return
        fetch(ADMIN_API + '/marketplace/collections?limit=100')
          .then(function(r) { return r.json() })
          .then(function(data) {
            var cols = data.collections || []
            if (cols.length === 0) {
              el.innerHTML = '<p class="text-gray-4">No collections found</p>'
              return
            }
            var html = '<div class="overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b border-gray-200">'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">ID</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Name</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Slug</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">NFTs</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Floor</th>'
              + '<th class="text-left py-2 px-3 font-semibold text-gray-7">Minting</th>'
              + '</tr></thead><tbody>'
            for (var i = 0; i < cols.length; i++) {
              var c = cols[i]
              html += '<tr class="border-b border-gray-100 hover:bg-gray-50">'
                + '<td class="py-2 px-3 text-gray-5">' + escapeHtml(c.id || '-') + '</td>'
                + '<td class="py-2 px-3 font-medium text-gray-8">' + escapeHtml(c.name || '-') + '</td>'
                + '<td class="py-2 px-3 text-gray-5">' + escapeHtml(c.slug || '-') + '</td>'
                + '<td class="py-2 px-3 text-gray-6">' + escapeHtml(c.nft_count || c.nftCount || 0) + '</td>'
                + '<td class="py-2 px-3 text-gray-6">' + (c.floor_price || c.floorPrice ? escapeHtml(c.floor_price || c.floorPrice) + ' SOL' : '-') + '</td>'
                + '<td class="py-2 px-3">' + (c.is_minting || c.isMinting ? '<span class="text-emerald-600 font-semibold">Active</span>' : '<span class="text-gray-4">No</span>') + '</td>'
                + '</tr>'
            }
            html += '</tbody></table></div>'
            el.innerHTML = html
          })
          .catch(function() { el.textContent = 'Failed to load collections' })
      }

      window.adminCreateCollection = async function(btn) {
        var name = getVal('admin-coll-name').trim()
        if (!name) { setResult('admin-coll-result', 'Name is required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var body = {
            name: name,
            symbol: getVal('admin-coll-symbol').trim(),
            description: getVal('admin-coll-desc').trim()
          }
          var img = getVal('admin-coll-image').trim()
          if (img) body.image_url = img
          var royalty = getVal('admin-coll-royalty')
          if (royalty) body.royalty_basis_points = Math.round(Number(royalty) * 100)
          var res = await fetch(ADMIN_API + '/marketplace/collections', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-coll-result', 'Collection created! ID: ' + (data.collection ? data.collection.id : 'unknown'), false)
            loadCollectionsList()
          } else {
            setResult('admin-coll-result', data.error || 'Failed to create', true)
          }
        } catch (err) {
          setResult('admin-coll-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Collection'
      }

      window.adminDeployCM = async function(btn) {
        var collId = getVal('admin-cm-collid')
        var items = getVal('admin-cm-items')
        var symbol = getVal('admin-cm-symbol').trim()
        var creator = getVal('admin-cm-creator').trim()
        var colMint = getVal('admin-cm-colmint').trim()
        if (!collId || !items || !symbol || !creator || !colMint) {
          setResult('admin-cm-result', 'Collection ID, items, symbol, creator, and collection mint are required', true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Deploying...'
        try {
          var body = {
            collectionId: Number(collId),
            itemsAvailable: Number(items),
            symbol: symbol,
            creatorAddress: creator,
            collectionMint: colMint
          }
          var price = getVal('admin-cm-price')
          if (price) body.mintPrice = Math.floor(Number(price) * 1e9)
          var fee = getVal('admin-cm-fee')
          if (fee) body.sellerFeeBasisPoints = Number(fee)
          var treasury = getVal('admin-cm-treasury').trim()
          if (treasury) body.treasuryAddress = treasury
          var res = await fetch(ADMIN_API + '/candy-machine', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var cm = data.candyMachine || {}
            setResult('admin-cm-result', 'Deployed! ID: ' + (cm.id || '?') + ', Address: ' + (cm.candyMachineAddress || ''), false)
          } else {
            setResult('admin-cm-result', data.error || 'Failed to deploy', true)
          }
        } catch (err) {
          setResult('admin-cm-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Deploy Candy Machine'
      }

      window.adminAddConfigLines = async function(btn) {
        var cmId = getVal('admin-cl-cmid')
        var linesRaw = getVal('admin-cl-lines').trim()
        if (!cmId || !linesRaw) {
          setResult('admin-cl-result', 'Candy Machine ID and config lines are required', true)
          return
        }
        var lines
        try {
          lines = JSON.parse(linesRaw)
          if (!Array.isArray(lines)) throw new Error('Must be a JSON array')
        } catch (e) {
          setResult('admin-cl-result', 'Invalid JSON: ' + e.message, true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Adding...'
        try {
          var startIdx = Number(getVal('admin-cl-start')) || 0
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/config-lines', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ configLines: lines, startIndex: startIdx })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-cl-result', 'Added ' + (data.linesAdded || lines.length) + ' config lines', false)
          } else {
            setResult('admin-cl-result', data.error || 'Failed to add config lines', true)
          }
        } catch (err) {
          setResult('admin-cl-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Add Config Lines'
      }

      window.adminSetGuards = async function(btn) {
        var cmId = getVal('admin-guard-cmid')
        var action = getVal('admin-guard-action')
        if (!cmId) { setResult('admin-guard-result', 'Candy Machine ID is required', true); return }
        var guards = {}
        var solLamports = getVal('admin-guard-sol')
        var solDest = getVal('admin-guard-dest').trim()
        if (solLamports && solDest) {
          guards.solPayment = { lamports: Number(solLamports), destination: solDest }
        }
        var startDate = getVal('admin-guard-start')
        if (startDate) guards.startDate = { date: new Date(startDate).toISOString() }
        var endDate = getVal('admin-guard-end')
        if (endDate) guards.endDate = { date: new Date(endDate).toISOString() }
        var mintLimit = getVal('admin-guard-limit')
        if (mintLimit) guards.mintLimit = { limit: Number(mintLimit) }
        if (Object.keys(guards).length === 0) {
          setResult('admin-guard-result', 'At least one guard setting is required', true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Submitting...'
        try {
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/guards', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ guards: guards, action: action })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-guard-result', 'Guards ' + action + 'ed successfully', false)
          } else {
            setResult('admin-guard-result', data.error || 'Failed to manage guards', true)
          }
        } catch (err) {
          setResult('admin-guard-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Submit Guards'
      }

      window.adminCreatePresale = async function(btn) {
        var collId = getVal('admin-ps-collid')
        if (!collId) { setResult('admin-ps-result', 'Collection ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var walletsRaw = getVal('admin-ps-wallets').trim()
          var wallets = walletsRaw ? walletsRaw.split('\n').map(function(w) { return w.trim() }).filter(Boolean) : []
          var body = {
            collectionId: Number(collId),
            walletAddresses: wallets,
            maxMintsPerWallet: Number(getVal('admin-ps-maxmints')) || 1,
            isActive: getVal('admin-ps-active') === 'true'
          }
          var discount = getVal('admin-ps-discount')
          if (discount) body.discount = Number(discount)
          var starts = getVal('admin-ps-starts')
          if (starts) body.presaleStartsAt = new Date(starts).toISOString()
          var expires = getVal('admin-ps-expires')
          if (expires) body.presaleExpiresAt = new Date(expires).toISOString()
          var res = await fetch(ADMIN_API + '/presale', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var ps = data.presale || {}
            setResult('admin-ps-result', 'Presale created! ID: ' + (ps.id || '?') + ', UUID: ' + (ps.uuid || ''), false)
          } else {
            setResult('admin-ps-result', data.error || 'Failed to create presale', true)
          }
        } catch (err) {
          setResult('admin-ps-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Presale'
      }

      window.adminUpdatePresale = async function(btn) {
        var psId = getVal('admin-psu-id')
        if (!psId) { setResult('admin-psu-result', 'Presale ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Updating...'
        try {
          var body = {}
          var activeVal = getVal('admin-psu-active')
          if (activeVal) body.isActive = activeVal === 'true'
          var discount = getVal('admin-psu-discount')
          if (discount) body.discount = Number(discount)
          var maxMints = getVal('admin-psu-maxmints')
          if (maxMints) body.maxMintsPerWallet = Number(maxMints)
          var walletsRaw = getVal('admin-psu-wallets').trim()
          if (walletsRaw) body.walletAddresses = walletsRaw.split('\n').map(function(w) { return w.trim() }).filter(Boolean)
          if (Object.keys(body).length === 0) {
            setResult('admin-psu-result', 'At least one field must be changed', true)
            btn.disabled = false
            btn.textContent = 'Update Presale'
            return
          }
          var res = await fetch(ADMIN_API + '/presale/' + psId, {
            method: 'PATCH',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-psu-result', 'Presale updated!', false)
          } else {
            setResult('admin-psu-result', data.error || 'Failed to update', true)
          }
        } catch (err) {
          setResult('admin-psu-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Update Presale'
      }

      window.adminUpdateStatus = async function(btn) {
        var cmId = getVal('admin-status-cmid')
        var newStatus = getVal('admin-status-val')
        if (!cmId) { setResult('admin-status-result', 'Candy Machine ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Updating...'
        try {
          var body = { status: newStatus }
          var msg = getVal('admin-status-msg').trim()
          if (msg) body.message = msg
          var res = await fetch(ADMIN_API + '/candy-machine/' + cmId + '/status', {
            method: 'PATCH',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var cm = data.candyMachine || {}
            setResult('admin-status-result', 'Status updated to: ' + (cm.status || newStatus), false)
          } else {
            setResult('admin-status-result', data.error || 'Failed to update status', true)
          }
        } catch (err) {
          setResult('admin-status-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Update Status'
      }

      window.adminUpdateStats = async function(btn) {
        var collId = getVal('admin-stats-collid')
        if (!collId) { setResult('admin-stats-result', 'Collection ID is required', true); return }
        btn.disabled = true
        btn.textContent = 'Recalculating...'
        try {
          var res = await fetch(ADMIN_API + '/marketplace/collections/stats', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ collectionId: Number(collId) })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var s = data.stats || {}
            setResult('admin-stats-result', 'Floor: ' + (s.floorPrice || 0) + ' SOL, Volume: ' + (s.volumeTraded || 0) + ' SOL, Holders: ' + (s.uniqueHolders || 0), false)
          } else {
            setResult('admin-stats-result', data.error || 'Failed to recalculate', true)
          }
        } catch (err) {
          setResult('admin-stats-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Recalculate Stats'
      }

      window.adminCreateToken = async function(btn) {
        var name = getVal('admin-token-name').trim()
        var symbol = getVal('admin-token-symbol').trim()
        if (!name || !symbol) { setResult('admin-token-create-result', 'Name and symbol are required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var body = {
            name: name,
            symbol: symbol,
            decimals: Number(getVal('admin-token-decimals')) || 9
          }
          var supply = getVal('admin-token-supply')
          if (supply) body.initialSupply = Number(supply)
          var uri = getVal('admin-token-uri').trim()
          if (uri) body.uri = uri
          var res = await fetch(ADMIN_API + '/token/create', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-token-create-result', 'Token created! Mint: ' + (data.mintAddress || data.mint || ''), false)
          } else {
            setResult('admin-token-create-result', data.error || 'Failed to create token', true)
          }
        } catch (err) {
          setResult('admin-token-create-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Token'
      }

      window.adminMintTokens = async function(btn) {
        var mintAddr = getVal('admin-token-mint-addr').trim()
        var amount = getVal('admin-token-mint-amount')
        var dest = getVal('admin-token-mint-dest').trim()
        if (!mintAddr || !amount || !dest) { setResult('admin-token-mint-result', 'Mint address, amount, and destination are required', true); return }
        btn.disabled = true
        btn.textContent = 'Minting...'
        try {
          var res = await fetch(ADMIN_API + '/token/mint', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ mintAddress: mintAddr, amount: Number(amount), destinationWallet: dest })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-token-mint-result', 'Tokens minted successfully!', false)
          } else {
            setResult('admin-token-mint-result', data.error || 'Failed to mint tokens', true)
          }
        } catch (err) {
          setResult('admin-token-mint-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Mint Tokens'
      }

      window.adminTransferTokens = async function(btn) {
        var mint = getVal('admin-token-xfer-mint').trim()
        var amount = getVal('admin-token-xfer-amount')
        var from = getVal('admin-token-xfer-from').trim()
        var to = getVal('admin-token-xfer-to').trim()
        if (!mint || !amount || !from || !to) { setResult('admin-token-xfer-result', 'All fields are required', true); return }
        btn.disabled = true
        btn.textContent = 'Transferring...'
        try {
          var res = await fetch(ADMIN_API + '/token/transfer', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify({ mintAddress: mint, amount: Number(amount), fromWallet: from, toWallet: to })
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-token-xfer-result', 'Tokens transferred successfully!', false)
          } else {
            setResult('admin-token-xfer-result', data.error || 'Failed to transfer tokens', true)
          }
        } catch (err) {
          setResult('admin-token-xfer-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Transfer Tokens'
      }

      window.adminLookupToken = async function(btn) {
        var mintAddr = getVal('admin-token-lookup-addr').trim()
        if (!mintAddr) { return }
        btn.disabled = true
        btn.textContent = 'Looking up...'
        var resultEl = getAdminEl('admin-token-lookup-result')
        try {
          var res = await fetch(ADMIN_API + '/token/' + encodeURIComponent(mintAddr), {
            headers: adminHeaders()
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var info = data.token || data
            var html = '<div class="bg-gray-50 rounded-lg p-4 text-sm">'
              + '<p><span class="font-semibold text-gray-7">Name:</span> ' + escapeHtml(info.name || '-') + '</p>'
              + '<p><span class="font-semibold text-gray-7">Symbol:</span> ' + escapeHtml(info.symbol || '-') + '</p>'
              + '<p><span class="font-semibold text-gray-7">Decimals:</span> ' + escapeHtml(info.decimals !== undefined ? info.decimals : '-') + '</p>'
              + '<p><span class="font-semibold text-gray-7">Supply:</span> ' + escapeHtml(info.supply !== undefined ? info.supply : '-') + '</p>'
              + '<p><span class="font-semibold text-gray-7">Mint:</span> <span class="font-mono text-gray-5">' + escapeHtml(info.mintAddress || mintAddr) + '</span></p>'
              + (info.uri ? '<p><span class="font-semibold text-gray-7">URI:</span> ' + escapeHtml(info.uri) + '</p>' : '')
              + '</div>'
            if (resultEl) resultEl.innerHTML = html
          } else {
            if (resultEl) resultEl.innerHTML = '<p class="text-red-500 text-sm">' + escapeHtml(data.error || 'Token not found') + '</p>'
          }
        } catch (err) {
          if (resultEl) resultEl.innerHTML = '<p class="text-red-500 text-sm">Error: ' + escapeHtml(err.message) + '</p>'
        }
        btn.disabled = false
        btn.textContent = 'Lookup'
      }

      window.adminUpdateNft = async function(btn) {
        var nftId = getVal('admin-nftedit-id')
        var wallet = getVal('admin-nftedit-wallet').trim()
        if (!nftId || !wallet) { setResult('admin-nftedit-result', 'NFT ID and wallet address are required', true); return }
        var body = { nftId: Number(nftId), walletAddress: wallet }
        var name = getVal('admin-nftedit-name').trim()
        if (name) body.name = name
        var symbol = getVal('admin-nftedit-symbol').trim()
        if (symbol) body.symbol = symbol
        var uri = getVal('admin-nftedit-uri').trim()
        if (uri) body.uri = uri
        var bps = getVal('admin-nftedit-bps')
        if (bps) body.sellerFeeBasisPoints = Number(bps)
        btn.disabled = true
        btn.textContent = 'Updating...'
        try {
          var res = await fetch(ADMIN_API + '/nfts/update', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-nftedit-result', 'NFT update transaction built successfully', false)
          } else {
            setResult('admin-nftedit-result', data.error || 'Failed to update', true)
          }
        } catch (err) {
          setResult('admin-nftedit-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Update NFT'
      }

      window.adminBulkCreate = async function(btn) {
        var itemsRaw = getVal('admin-bulk-items').trim()
        if (!itemsRaw) { setResult('admin-bulk-result', 'Items JSON is required', true); return }
        var items
        try {
          items = JSON.parse(itemsRaw)
          if (!Array.isArray(items)) throw new Error('Must be a JSON array')
        } catch (e) {
          setResult('admin-bulk-result', 'Invalid JSON: ' + e.message, true)
          return
        }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var body = { items: items }
          var collId = getVal('admin-bulk-collid')
          if (collId) body.collectionId = Number(collId)
          var fee = getVal('admin-bulk-fee')
          if (fee) body.sellerFeeBasisPoints = Number(fee)
          var res = await fetch(ADMIN_API + '/nfts/bulk-create', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            setResult('admin-bulk-result', 'Created: ' + (data.created || 0) + ', Failed: ' + (data.failed || 0), false)
          } else {
            setResult('admin-bulk-result', data.error || 'Failed to bulk create', true)
          }
        } catch (err) {
          setResult('admin-bulk-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create NFTs'
      }

      window.adminCreateMultisig = async function(btn) {
        var name = getVal('admin-msig-name').trim()
        var threshold = getVal('admin-msig-threshold')
        var signersRaw = getVal('admin-msig-signers').trim()
        if (!name || !threshold || !signersRaw) { setResult('admin-msig-result', 'Name, threshold, and signers are required', true); return }
        var signers = signersRaw.split('\n').map(function(s) { return s.trim() }).filter(Boolean)
        if (signers.length < 2) { setResult('admin-msig-result', 'At least 2 signers are required', true); return }
        btn.disabled = true
        btn.textContent = 'Creating...'
        try {
          var body = {
            name: name,
            threshold: Number(threshold),
            signers: signers,
            authorityType: getVal('admin-msig-authtype'),
            description: getVal('admin-msig-desc').trim() || undefined,
            targetMint: getVal('admin-msig-mint').trim() || undefined
          }
          var res = await fetch(ADMIN_API + '/multisig', {
            method: 'POST',
            headers: adminHeaders(),
            body: JSON.stringify(body)
          })
          var data = await res.json()
          if (res.ok && !data.error) {
            var ms = data.multisig || {}
            setResult('admin-msig-result', 'Multisig created! Address: ' + (ms.address || ''), false)
          } else {
            setResult('admin-msig-result', data.error || 'Failed to create', true)
          }
        } catch (err) {
          setResult('admin-msig-result', 'Error: ' + err.message, true)
        }
        btn.disabled = false
        btn.textContent = 'Create Multisig'
      }

      window.adminLoadPending = async function(btn) {
        var wallet = getVal('admin-msig-mywallet').trim()
        if (!wallet) return
        var pendingEl = getAdminEl('admin-msig-pending')
        if (!pendingEl) return
        pendingEl.textContent = 'Loading...'
        try {
          var res = await fetch(ADMIN_API + '/multisig?walletAddress=' + encodeURIComponent(wallet), {
            headers: adminHeaders()
          })
          var data = await res.json()
          var accounts = data.accounts || []
          if (accounts.length === 0) {
            pendingEl.innerHTML = '<p class="text-gray-4">No multisig accounts found for this wallet</p>'
            return
          }
          var html = ''
          for (var a = 0; a < accounts.length; a++) {
            var acc = accounts[a]
            html += '<div class="border border-gray-200 rounded-lg p-4 mb-3">'
              + '<p class="font-semibold text-gray-8">' + escapeHtml(acc.name) + ' (' + escapeHtml(acc.threshold) + '-of-' + escapeHtml(acc.totalSigners) + ')</p>'
              + '<p class="text-xs text-gray-5 font-mono">' + escapeHtml(acc.address || '') + '</p>'
              + '</div>'
          }
          pendingEl.innerHTML = html
        } catch (err) {
          pendingEl.innerHTML = '<p class="text-red-500">Error: ' + escapeHtml(err.message) + '</p>'
        }
      }

      // Auto-load collections on page load
      loadCollectionsList()
    }
  </script>
@endsection
