<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <meta name="api-url" content="http://localhost:3008">
  <title>{{ pageTitle || 'Naked NFTs' }}</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Custom Gilroy Font */
    @font-face {
      font-family: 'Gilroy';
      font-weight: 400;
      src: url(/assets/fonts/Gilroy-Regular.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 500;
      src: url(/assets/fonts/Gilroy-Medium.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 600;
      src: url(/assets/fonts/Gilroy-SemiBold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 700;
      src: url(/assets/fonts/Gilroy-Bold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 800;
      src: url(/assets/fonts/Gilroy-ExtraBold.woff) format('woff');
    }

    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }

    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Selection Color */
    ::selection {
      background-color: #E50570;
      color: white;
    }

    /* Spinner */
    .spinner {
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Mobile drawer: full screen */
    @media (max-width: 640px) {
      [data-drawer-panel] {
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body class="antialiased font-sans bg-white text-gray-dark">
  <Header />
  @yield('content')
  <Footer />
  <Drawer />
  <AuthModal />
  <Toast />

  <script client>
    // ─── API URL ───
    const API_URL = 'http://localhost:3008'

    // ─── Toast ───
    window.Toast = {
      show(msg, type = 'success') {
        window.dispatchEvent(new CustomEvent('toast', { detail: { message: msg, type } }))
      },
      success(msg) { this.show(msg, 'success') },
      error(msg) { this.show(msg, 'error') },
    }

    // ─── WalletManager ───
    window.WalletManager = {
      _address: null,

      getProvider() {
        if ('phantom' in window) return window.phantom?.solana
        if ('solflare' in window) return window.solflare
        return null
      },

      isConnected() { return !!this._address },
      getAddress() { return this._address },

      async connect() {
        const provider = this.getProvider()
        if (!provider) {
          window.open('https://phantom.app/', '_blank')
          return null
        }
        try {
          const resp = await provider.connect()
          this._address = resp.publicKey.toString()
          localStorage.setItem('wallet_address', this._address)
          window.dispatchEvent(new CustomEvent('wallet-connected', { detail: { address: this._address } }))
          return this._address
        } catch (err) {
          console.error('Wallet connect failed:', err)
          return null
        }
      },

      async disconnect() {
        const provider = this.getProvider()
        if (provider) { try { await provider.disconnect() } catch (_) {} }
        this._address = null
        localStorage.removeItem('wallet_address')
        window.dispatchEvent(new CustomEvent('wallet-disconnected'))
      },

      async getBalance() {
        try {
          const provider = this.getProvider()
          if (provider?.connection && provider?.publicKey) {
            const bal = await provider.connection.getBalance(provider.publicKey)
            return (bal / 1e9).toFixed(4)
          }
        } catch (_) {}
        return null
      },

      async restore() {
        const saved = localStorage.getItem('wallet_address')
        if (!saved) return
        const provider = this.getProvider()
        if (provider?.isConnected && provider?.publicKey) {
          this._address = provider.publicKey.toString()
          window.dispatchEvent(new CustomEvent('wallet-connected', { detail: { address: this._address } }))
        } else if (provider) {
          try {
            const resp = await provider.connect({ onlyIfTrusted: true })
            this._address = resp.publicKey.toString()
            window.dispatchEvent(new CustomEvent('wallet-connected', { detail: { address: this._address } }))
          } catch (_) {
            localStorage.removeItem('wallet_address')
          }
        }
      },
    }

    // ─── NFTModal ───
    window.NFTModal = {
      currentNft: null,

      async open(nftId) {
        window.DrawerManager?.open()
        window.DrawerManager?.setContent('<div class="flex items-center justify-center h-64"><div class="spinner h-8 w-8 border-4 border-pink-8 border-t-transparent rounded-full"></div></div>')
        try {
          const res = await fetch(`${API_URL}/marketplace/nfts/${nftId}`)
          const data = await res.json()
          if (!data.nft) { Toast.error('NFT not found'); DrawerManager.close(); return }
          this.currentNft = data.nft
          this.render()
        } catch (err) {
          Toast.error('Failed to load NFT details')
          DrawerManager.close()
        }
      },

      render() {
        const nft = this.currentNft
        if (!nft) return
        const wallet = WalletManager.getAddress()
        const isOwner = wallet && nft.owner_address && wallet === nft.owner_address
        const isConnected = WalletManager.isConnected()

        const attrs = nft.attributes ? (typeof nft.attributes === 'string' ? JSON.parse(nft.attributes) : nft.attributes) : []
        const attrsHtml = Array.isArray(attrs) && attrs.length > 0
          ? `<div class="grid grid-cols-2 gap-2 mt-4">${attrs.map(a => `<div class="bg-gray-50 rounded-lg p-2 text-center"><p class="text-xs text-gray-5">${a.trait_type || a.traitType || ''}</p><p class="text-sm font-semibold text-gray-8">${a.value || ''}</p></div>`).join('')}</div>`
          : ''

        const rarityBadge = nft.rarity_rank
          ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Rank #${nft.rarity_rank}</span>`
          : ''

        const priceHtml = nft.price
          ? `<div class="flex items-center justify-between bg-gray-50 rounded-xl p-4 mb-4"><span class="text-gray-5">Price</span><span class="text-2xl font-bold text-gray-9">${nft.price} SOL</span></div>`
          : ''

        const offersHtml = nft.offers && nft.offers.length > 0
          ? `<div class="mt-4"><h4 class="text-sm font-semibold text-gray-7 mb-2">Pending Offers</h4>${nft.offers.map(o => `<div class="flex items-center justify-between bg-gray-50 rounded-lg p-3 mb-2"><div><p class="text-sm font-medium">${Number(o.amount).toFixed(4)} SOL</p><p class="text-xs text-gray-5">From ${(o.bidder_address || '').slice(0,4)}...${(o.bidder_address || '').slice(-4)}</p></div><div class="flex space-x-2">${isOwner ? `<button onclick="Marketplace.acceptOffer(${o.id})" class="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded hover:bg-emerald-200">Accept</button>` : ''}${wallet === o.bidder_address ? `<button onclick="Marketplace.cancelOffer(${o.id})" class="text-xs bg-red-100 text-red-700 px-2 py-1 rounded hover:bg-red-200">Cancel</button>` : ''}</div></div>`).join('')}</div>`
          : ''

        const auctionHtml = nft.auction
          ? (() => {
              const a = nft.auction
              const endTime = new Date(a.end_time).getTime()
              const now = Date.now()
              const ended = now >= endTime
              return `<div class="bg-purple-50 rounded-xl p-4 mb-4"><div class="flex items-center justify-between mb-2"><span class="text-sm font-semibold text-purple-800">Active Auction</span><span class="text-xs text-purple-600" data-auction-countdown data-end="${a.end_time}">${ended ? 'Ended' : ''}</span></div><div class="flex items-center justify-between"><span class="text-gray-5 text-sm">Current Bid</span><span class="text-lg font-bold text-gray-9">${Number(a.current_bid || a.starting_price).toFixed(4)} SOL</span></div>${!ended && isConnected && !isOwner ? `<div class="mt-3"><div class="flex space-x-2"><input type="number" step="0.01" placeholder="Your bid (SOL)" data-bid-input class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-8 focus:ring-pink-8"><button onclick="Marketplace._confirmBid(${a.id})" class="bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold px-4 py-2 rounded-lg">Bid</button></div></div>` : ''}${ended && isOwner ? `<button onclick="Marketplace.settleAuction(${a.id})" class="mt-3 w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 rounded-lg text-sm">Settle Auction</button>` : ''}</div>`
            })()
          : ''

        let actionsHtml = ''
        if (!isConnected) {
          actionsHtml = `<button onclick="WalletManager.connect()" class="w-full bg-gradient-to-r from-pink-8 to-purple-600 hover:from-pink-9 hover:to-purple-700 text-white font-bold py-3 px-6 rounded-xl transition text-base">Connect Wallet</button>`
        } else if (nft.is_for_sale && !isOwner && !nft.auction) {
          actionsHtml = `<button onclick="Marketplace.buyNow(${nft.id})" class="w-full bg-pink-8 hover:bg-pink-9 text-white font-bold py-3 px-6 rounded-xl transition text-base mb-2">Buy Now for ${nft.price} SOL</button><button onclick="Marketplace._showOfferForm(${nft.id})" class="w-full border-2 border-pink-8 text-pink-8 hover:bg-pink-50 font-semibold py-3 px-6 rounded-xl transition text-base">Make Offer</button>`
        } else if (nft.is_for_sale && isOwner && !nft.auction) {
          actionsHtml = `<button onclick="Marketplace.delist(${nft.id})" class="w-full border-2 border-red-500 text-red-500 hover:bg-red-50 font-semibold py-3 px-6 rounded-xl transition text-base">Delist</button>`
        } else if (!nft.is_for_sale && isOwner && !nft.auction) {
          actionsHtml = `<button onclick="Marketplace._showListForm(${nft.id})" class="w-full bg-pink-8 hover:bg-pink-9 text-white font-bold py-3 px-6 rounded-xl transition text-base mb-2">List for Sale</button><button onclick="Marketplace._showAuctionForm(${nft.id})" class="w-full border-2 border-purple-600 text-purple-600 hover:bg-purple-50 font-semibold py-3 px-6 rounded-xl transition text-base">Create Auction</button>`
        } else if (!nft.is_for_sale && !isOwner && !nft.auction) {
          actionsHtml = `<button onclick="Marketplace._showOfferForm(${nft.id})" class="w-full bg-pink-8 hover:bg-pink-9 text-white font-bold py-3 px-6 rounded-xl transition text-base">Make Offer</button>`
        }

        const html = `
          <div class="p-6">
            <div class="aspect-square rounded-xl overflow-hidden mb-4">
              <img src="${nft.image_url || nft.imageUrl || '/assets/images/placeholder.png'}" alt="${nft.name}" class="w-full h-full object-cover" />
            </div>
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-2xl font-bold text-gray-9">${nft.name}</h2>
              ${rarityBadge}
            </div>
            ${nft.collection_name ? `<p class="text-sm text-pink-8 font-medium mb-2">${nft.collection_name}</p>` : ''}
            ${nft.description ? `<p class="text-gray-5 text-sm mb-4">${nft.description}</p>` : ''}
            ${nft.owner_address ? `<p class="text-xs text-gray-4 mb-4">Owner: ${nft.owner_address.slice(0,6)}...${nft.owner_address.slice(-4)}</p>` : ''}
            ${priceHtml}
            ${auctionHtml}
            ${attrsHtml}
            ${offersHtml}
            <div class="mt-6" data-nft-actions>${actionsHtml}</div>
            <div data-nft-inline-form class="mt-4"></div>
          </div>
        `
        DrawerManager.setContent(html)

        // Start auction countdown if present
        if (nft.auction && !nft.auction._ended) {
          const endTime = new Date(nft.auction.end_time).getTime()
          const tick = () => {
            const el = DrawerManager._query('[data-auction-countdown]')
            if (!el) return
            const diff = endTime - Date.now()
            if (diff <= 0) { el.textContent = 'Ended'; return }
            const h = Math.floor(diff / 3600000)
            const m = Math.floor((diff % 3600000) / 60000)
            const s = Math.floor((diff % 60000) / 1000)
            el.textContent = `${h}h ${m}m ${s}s`
            requestAnimationFrame(tick)
          }
          tick()
        }
      },
    }

    // Re-render NFTModal actions when wallet state changes
    window.addEventListener('wallet-connected', () => { if (NFTModal.currentNft) NFTModal.render() })
    window.addEventListener('wallet-disconnected', () => { if (NFTModal.currentNft) NFTModal.render() })

    // ─── Marketplace ───
    window.Marketplace = {
      _drawerQuery(selector) {
        return DrawerManager._query(selector)
      },

      async _apiCall(url, body, successMsg) {
        if (!WalletManager.isConnected()) { Toast.error('Please connect your wallet first'); return null }
        try {
          const res = await fetch(`${API_URL}${url}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...body, walletAddress: WalletManager.getAddress() }),
          })
          const data = await res.json()
          if (data.success || res.ok) {
            Toast.success(successMsg)
            return data
          }
          Toast.error(data.error || 'Operation failed')
          return null
        } catch (err) {
          Toast.error('Network error. Please try again.')
          return null
        }
      },

      async buyNow(nftId) {
        if (!confirm('Confirm purchase?')) return
        const result = await this._apiCall('/nfts/buy', { nftId }, 'Purchase successful!')
        if (result) NFTModal.open(nftId)
      },

      async listForSale(nftId, price) {
        const result = await this._apiCall('/nfts/list', { nftId, price: Number(price) }, 'NFT listed for sale!')
        if (result) NFTModal.open(nftId)
      },

      async delist(nftId) {
        if (!confirm('Remove listing?')) return
        const result = await this._apiCall('/nfts/delist', { nftId }, 'Listing removed.')
        if (result) NFTModal.open(nftId)
      },

      async makeOffer(nftId, amount) {
        const result = await this._apiCall('/nfts/offer', { nftId, amount: Number(amount) }, 'Offer submitted!')
        if (result) NFTModal.open(nftId)
      },

      async acceptOffer(offerId) {
        if (!confirm('Accept this offer?')) return
        const result = await this._apiCall('/nfts/offer/accept', { offerId }, 'Offer accepted!')
        if (result && NFTModal.currentNft) NFTModal.open(NFTModal.currentNft.id)
      },

      async cancelOffer(offerId) {
        const result = await this._apiCall('/nfts/offer/cancel', { offerId }, 'Offer cancelled.')
        if (result && NFTModal.currentNft) NFTModal.open(NFTModal.currentNft.id)
      },

      async createAuction(nftId, config) {
        const result = await this._apiCall('/nfts/auction', { nftId, ...config }, 'Auction created!')
        if (result) NFTModal.open(nftId)
      },

      async placeBid(auctionId, amount) {
        if (!amount || Number(amount) <= 0) { Toast.error('Enter a valid bid amount'); return }
        const result = await this._apiCall('/nfts/auction/bid', { auctionId, amount: Number(amount) }, 'Bid placed!')
        if (result && NFTModal.currentNft) NFTModal.open(NFTModal.currentNft.id)
      },

      async settleAuction(auctionId) {
        if (!confirm('Settle this auction?')) return
        const result = await this._apiCall('/nfts/auction/settle', { auctionId }, 'Auction settled!')
        if (result && NFTModal.currentNft) NFTModal.open(NFTModal.currentNft.id)
      },

      // Helper methods for inline form actions
      _confirmList(nftId) {
        const price = this._drawerQuery('[data-list-price]')?.value
        if (price) this.listForSale(nftId, price)
      },

      _confirmOffer(nftId) {
        const amount = this._drawerQuery('[data-offer-amount]')?.value
        if (amount) this.makeOffer(nftId, amount)
      },

      _confirmBid(auctionId) {
        const amount = this._drawerQuery('[data-bid-input]')?.value
        if (amount) this.placeBid(auctionId, amount)
      },

      _confirmAuction(nftId) {
        const type = this._drawerQuery('[data-auction-type]')?.value
        const start = this._drawerQuery('[data-auction-start]')?.value
        const reserve = this._drawerQuery('[data-auction-reserve]')?.value
        const duration = this._drawerQuery('[data-auction-duration]')?.value
        this.createAuction(nftId, {
          auctionType: type,
          startingPrice: Number(start),
          reservePrice: Number(reserve) || null,
          duration: Number(duration)
        })
      },

      _clearForm() {
        const form = this._drawerQuery('[data-nft-inline-form]')
        if (form) form.innerHTML = ''
      },

      // Inline forms shown inside the drawer
      _showListForm(nftId) {
        const form = this._drawerQuery('[data-nft-inline-form]')
        if (!form) return
        form.innerHTML = `
          <div class="bg-gray-50 rounded-xl p-4">
            <h4 class="font-semibold text-gray-8 mb-3">List for Sale</h4>
            <div class="flex space-x-2">
              <input type="number" step="0.01" min="0" placeholder="Price in SOL" data-list-price class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-8 focus:ring-pink-8" />
              <button onclick="Marketplace._confirmList(${nftId})" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-4 py-2 rounded-lg text-sm">Confirm</button>
            </div>
            <button onclick="Marketplace._clearForm()" class="text-xs text-gray-5 hover:text-gray-7 mt-2">Cancel</button>
          </div>
        `
      },

      _showOfferForm(nftId) {
        const form = this._drawerQuery('[data-nft-inline-form]')
        if (!form) return
        form.innerHTML = `
          <div class="bg-gray-50 rounded-xl p-4">
            <h4 class="font-semibold text-gray-8 mb-3">Make an Offer</h4>
            <div class="flex space-x-2">
              <input type="number" step="0.01" min="0" placeholder="Amount in SOL" data-offer-amount class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-8 focus:ring-pink-8" />
              <button onclick="Marketplace._confirmOffer(${nftId})" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-4 py-2 rounded-lg text-sm">Submit</button>
            </div>
            <button onclick="Marketplace._clearForm()" class="text-xs text-gray-5 hover:text-gray-7 mt-2">Cancel</button>
          </div>
        `
      },

      _showAuctionForm(nftId) {
        const form = this._drawerQuery('[data-nft-inline-form]')
        if (!form) return
        form.innerHTML = `
          <div class="bg-gray-50 rounded-xl p-4">
            <h4 class="font-semibold text-gray-8 mb-3">Create Auction</h4>
            <div class="space-y-3">
              <select data-auction-type class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                <option value="english">English (Ascending)</option>
                <option value="dutch">Dutch (Descending)</option>
              </select>
              <input type="number" step="0.01" min="0" placeholder="Starting price (SOL)" data-auction-start class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-8 focus:ring-pink-8" />
              <input type="number" step="0.01" min="0" placeholder="Reserve price (SOL, optional)" data-auction-reserve class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-pink-8 focus:ring-pink-8" />
              <select data-auction-duration class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                <option value="3600">1 hour</option>
                <option value="21600">6 hours</option>
                <option value="43200">12 hours</option>
                <option value="86400" selected>24 hours</option>
                <option value="259200">3 days</option>
                <option value="604800">7 days</option>
              </select>
              <button onclick="Marketplace._confirmAuction(${nftId})" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 rounded-lg text-sm">Create Auction</button>
            </div>
            <button onclick="Marketplace._clearForm()" class="text-xs text-gray-5 hover:text-gray-7 mt-2">Cancel</button>
          </div>
        `
      },
    }

    // Auto-restore wallet on page load
    WalletManager.restore()
  </script>
</body>
</html>
