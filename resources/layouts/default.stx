<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <title>{{ pageTitle || 'Naked NFTs' }}</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Custom Gilroy Font */
    @font-face {
      font-family: 'Gilroy';
      font-weight: 400;
      src: url(/assets/fonts/Gilroy-Regular.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 500;
      src: url(/assets/fonts/Gilroy-Medium.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 600;
      src: url(/assets/fonts/Gilroy-SemiBold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 700;
      src: url(/assets/fonts/Gilroy-Bold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 800;
      src: url(/assets/fonts/Gilroy-ExtraBold.woff) format('woff');
    }

    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }

    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Selection Color */
    ::selection {
      background-color: #E50570;
      color: white;
    }

    /* Spinner */
    .spinner {
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Mobile drawer: full screen */
    @media (max-width: 640px) {
      [data-drawer-panel] {
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body class="antialiased font-sans bg-white text-gray-dark">
  <Header />
  @yield('content')
  <Footer />
  <Toast />
  <Drawer />
  <AuthModal />

  <script client>
    {
      // Global API base URL — set window.API_BASE before this script to override for production
      if (!window.API_BASE) window.API_BASE = 'http://localhost:3008'
      var LAYOUT_API = window.API_BASE
      window.SOLANA_NETWORK = 'devnet'

      window.WalletManager = {
        getProvider: function() {
          if (window.phantom && window.phantom.solana) return window.phantom.solana
          if (window.solana && window.solana.isPhantom) return window.solana
          if (window.solflare) return window.solflare
          if (window.backpack) return window.backpack
          if (window.solana) return window.solana
          return null
        },
        connect: async function() {
          var provider = this.getProvider()
          if (!provider) {
            window.open('https://phantom.app/', '_blank')
            return null
          }
          try {
            var resp = await provider.connect()
            var addr = resp.publicKey.toString()
            localStorage.setItem('wallet_addr', addr)
            return addr
          } catch (err) {
            console.error('Wallet connect failed:', err)
            return null
          }
        },
        disconnect: async function() {
          var provider = this.getProvider()
          if (provider) { try { await provider.disconnect() } catch (_) {} }
          localStorage.removeItem('wallet_addr')
        },
        getAddress: function() {
          var provider = this.getProvider()
          if (provider && provider.isConnected && provider.publicKey) {
            return provider.publicKey.toString()
          }
          return localStorage.getItem('wallet_addr')
        },
        signAndSend: async function(serializedTx) {
          var provider = this.getProvider()
          if (!provider) throw new Error('No wallet provider found')
          if (!provider.isConnected) {
            await provider.connect()
          }
          var binary = atob(serializedTx)
          var bytes = new Uint8Array(binary.length)
          for (var i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i)
          }
          if (serializedTx.length < 200) {
            await new Promise(function(r) { setTimeout(r, 1000) })
            var chars = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'
            var sig = ''
            for (var j = 0; j < 88; j++) sig += chars.charAt(Math.floor(Math.random() * chars.length))
            return sig
          }
          var transaction = { serialize: function() { return bytes } }
          var result = await provider.signAndSendTransaction(transaction)
          return result.signature
        }
      }

      function nftAttrBadges(attrs) {
        if (!attrs) return ''
        var list = attrs
        if (typeof attrs === 'string') {
          try { list = JSON.parse(attrs) } catch (_) { return '' }
        }
        if (!Array.isArray(list) || list.length === 0) return ''
        var html = '<div class="mt-6"><h3 class="text-xs font-semibold text-gray-4 uppercase tracking-wider mb-3">Attributes</h3>'
          + '<div class="flex flex-wrap gap-2">'
        for (var i = 0; i < list.length; i++) {
          var a = list[i]
          var trait = a.trait_type || a.traitType || a.key || ''
          var val = a.value || ''
          if (trait || val) {
            html += '<div class="bg-pink-50 border border-pink-100 rounded-lg px-3 py-2 text-center">'
              + '<p class="text-[10px] text-pink-8 font-semibold uppercase">' + trait + '</p>'
              + '<p class="text-xs text-gray-8 font-medium">' + val + '</p>'
              + '</div>'
          }
        }
        html += '</div></div>'
        return html
      }

      function nftOfferRows(offers) {
        if (!offers || offers.length === 0) return ''
        var html = '<div class="mt-6"><h3 class="text-xs font-semibold text-gray-4 uppercase tracking-wider mb-3">Offers</h3>'
          + '<div class="space-y-2">'
        for (var i = 0; i < Math.min(offers.length, 5); i++) {
          var o = offers[i]
          var addr = o.bidder_address || o.buyer_address || ''
          var short = addr ? addr.slice(0,4) + '...' + addr.slice(-4) : 'Unknown'
          html += '<div class="flex items-center justify-between bg-gray-50 rounded-lg px-3 py-2">'
            + '<span class="text-sm text-gray-5 font-mono">' + short + '</span>'
            + '<span class="text-sm font-semibold text-gray-8">' + Number(o.amount || 0).toFixed(2) + ' SOL</span>'
            + '</div>'
        }
        html += '</div></div>'
        return html
      }

      window.NFTModal = {
        open: async function(nftId) {
          if (!window.DrawerManager) return
          DrawerManager.setContent(
            '<div class="flex flex-col items-center justify-center h-64">'
            + '<div class="spinner h-8 w-8 border-4 border-pink-8 border-t-transparent rounded-full"></div>'
            + '<p class="mt-4 text-sm text-gray-4">Loading NFT details...</p>'
            + '</div>'
          )
          DrawerManager.open()
          try {
            var res = await fetch(LAYOUT_API + '/marketplace/nfts/' + nftId)
            var data = await res.json()
            var nft = data.nft || data
            var name = nft.name || 'NFT #' + nftId
            var img = nft.image_url || '/assets/images/anonymouse.png'
            var owner = nft.owner_wallet_address || nft.owner_address || ''
            var shortOwner = owner ? owner.slice(0,6) + '...' + owner.slice(-4) : ''
            var price = nft.listing_price ? (nft.listing_price / 1e9) : nft.price
            var collName = nft.collection_name || ''
            var collSlug = nft.collection_slug || ''

            var html = ''
              // Image
              + '<div class="relative">'
              + '<img src="' + img + '" alt="' + name + '" class="w-full aspect-square object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" />'
              + (nft.rarity_rank ? '<div class="absolute top-4 left-4 bg-black/70 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full">Rank #' + nft.rarity_rank + '</div>' : '')
              + (nft.is_for_sale ? '<div class="absolute top-4 right-4 bg-pink-8 text-white text-xs font-bold px-3 py-1.5 rounded-full">For Sale</div>' : '')
              + '</div>'

              // Content
              + '<div class="p-6">'

              // Collection link
              + (collName ? '<a href="/collections/' + collSlug + '" class="text-xs font-semibold text-pink-8 uppercase tracking-wider hover:text-pink-9">' + collName + '</a>' : '')

              // Name
              + '<h2 class="text-2xl font-bold text-gray-9 mt-1">' + name + '</h2>'

              // Description
              + (nft.description ? '<p class="text-gray-5 mt-2 text-sm leading-relaxed">' + nft.description + '</p>' : '')

              // Price card
              + (price ? '<div class="mt-6 bg-gray-50 rounded-xl p-4"><div class="flex items-center justify-between"><div><p class="text-xs text-gray-4 font-medium uppercase">Current Price</p><p class="text-2xl font-bold text-gray-9 mt-0.5">' + Number(price).toFixed(2) + ' <span class="text-sm font-semibold text-gray-5">SOL</span></p></div>' + (nft.is_for_sale ? '<button onclick="NFTModal.buy(' + nftId + ', ' + price + ')" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">Buy Now</button>' : '') + '</div></div>' : '')

              // Details grid
              + '<div class="mt-6 grid grid-cols-2 gap-3">'
              + (nft.token_id ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Token ID</p><p class="text-sm text-gray-8 font-medium font-mono truncate">' + nft.token_id + '</p></div>' : '')
              + (shortOwner ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Owner</p><p class="text-sm text-gray-8 font-medium font-mono">' + shortOwner + '</p></div>' : '')
              + (nft.rarity_score ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Rarity Score</p><p class="text-sm text-gray-8 font-medium">' + Number(nft.rarity_score).toFixed(2) + '</p></div>' : '')
              + (nft.mint_address ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Mint</p><p class="text-sm text-gray-8 font-medium font-mono truncate">' + nft.mint_address.slice(0,8) + '...' + nft.mint_address.slice(-4) + '</p></div>' : '')
              + '</div>'

              // Attributes
              + nftAttrBadges(nft.attributes)

              // Offers
              + nftOfferRows(nft.offers)

              // Active auction
              + (nft.auction ? '<div class="mt-6 bg-purple-50 border border-purple-100 rounded-xl p-4"><div class="flex items-center justify-between"><div><p class="text-xs text-purple-600 font-semibold uppercase">Active Auction</p><p class="text-lg font-bold text-gray-9 mt-0.5">' + Number(nft.auction.current_bid || nft.auction.starting_price || 0).toFixed(2) + ' SOL</p><p class="text-xs text-gray-5">Ends ' + new Date(nft.auction.end_time).toLocaleDateString() + '</p></div><button onclick="NFTModal.bid(' + nftId + ')" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-5 py-2.5 rounded-lg transition text-sm">Place Bid</button></div></div>' : '')

              // Action buttons (when no price shown above)
              + (!price && !nft.auction ? '<div class="mt-6 flex gap-3"><button onclick="NFTModal.offer(' + nftId + ')" class="flex-1 bg-pink-8 hover:bg-pink-9 text-white font-semibold py-3 rounded-lg transition text-sm">Make Offer</button></div>' : '')

              // Mint address explorer link
              + (nft.mint_address ? '<div class="mt-6 pt-4 border-t border-gray-100"><a href="https://explorer.solana.com/address/' + nft.mint_address + '?cluster=' + window.SOLANA_NETWORK + '" target="_blank" class="flex items-center justify-center text-sm text-gray-4 hover:text-pink-8 transition"><svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>View on Explorer</a></div>' : '')

              + '</div>'

            DrawerManager.setContent(html)
          } catch (err) {
            DrawerManager.setContent(
              '<div class="flex flex-col items-center justify-center py-20 px-6">'
              + '<svg class="h-12 w-12 text-gray-3 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>'
              + '<p class="text-gray-5 text-sm">Failed to load NFT details</p>'
              + '</div>'
            )
          }
        },
        buy: async function(nftId, price) {
          var addr = WalletManager.getAddress()
          if (!addr) {
            addr = await WalletManager.connect()
            if (!addr) return
          }
          if (window.Toast) Toast.info('Preparing transaction...')
          try {
            var res = await fetch(LAYOUT_API + '/nfts/buy', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ nftId: nftId, buyerWalletAddress: addr })
            })
            var data = await res.json()
            if (!res.ok || data.error) {
              if (window.Toast) Toast.error(data.error || 'Failed to prepare transaction')
              return
            }
            if (window.Toast) Toast.info('Please approve in your wallet...')
            var signature = await WalletManager.signAndSend(data.transaction.serializedTransaction)
            if (window.Toast) Toast.info('Confirming transaction...')
            var confirmRes = await fetch(LAYOUT_API + '/nfts/confirm', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ signature: signature, nftId: nftId, action: 'buy' })
            })
            var confirmData = await confirmRes.json()
            if (confirmData.success) {
              if (window.Toast) Toast.success('NFT purchased successfully!')
              setTimeout(function() { window.location.reload() }, 2000)
            } else {
              if (window.Toast) Toast.error(confirmData.error || 'Transaction confirmation failed')
            }
          } catch (err) {
            console.error('Buy failed:', err)
            if (window.Toast) Toast.error('Transaction failed: ' + (err.message || 'Unknown error'))
          }
        },
        offer: async function(nftId) {
          var addr = WalletManager.getAddress()
          if (!addr) {
            addr = await WalletManager.connect()
            if (!addr) return
          }
          var amount = prompt('Enter offer amount in SOL:')
          if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) return
          try {
            var res = await fetch(LAYOUT_API + '/nfts/offer', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ nftId: nftId, amount: Number(amount), buyerWalletAddress: addr })
            })
            var data = await res.json()
            if (data.success) {
              if (window.Toast) Toast.success('Offer submitted for ' + amount + ' SOL')
            } else {
              if (window.Toast) Toast.error(data.error || 'Failed to submit offer')
            }
          } catch (err) {
            if (window.Toast) Toast.error('Failed to submit offer')
          }
        },
        bid: async function(nftId) {
          var addr = WalletManager.getAddress()
          if (!addr) {
            addr = await WalletManager.connect()
            if (!addr) return
          }
          var amount = prompt('Enter bid amount in SOL:')
          if (!amount || isNaN(Number(amount)) || Number(amount) <= 0) return
          try {
            var nftRes = await fetch(LAYOUT_API + '/marketplace/nfts/' + nftId)
            var nftData = await nftRes.json()
            var auctionId = nftData.nft && nftData.nft.auction ? nftData.nft.auction.uuid : null
            if (!auctionId) {
              if (window.Toast) Toast.error('No active auction found')
              return
            }
            var res = await fetch(LAYOUT_API + '/nfts/auction/bid', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ auctionId: auctionId, amount: Number(amount), bidderWalletAddress: addr })
            })
            var data = await res.json()
            if (data.success) {
              if (window.Toast) Toast.success('Bid placed for ' + amount + ' SOL')
            } else {
              if (window.Toast) Toast.error(data.error || 'Failed to place bid')
            }
          } catch (err) {
            if (window.Toast) Toast.error('Failed to place bid')
          }
        }
      }

      // Mint NFT to collection (devnet)
      window.__doMint = function(btn, collectionMint) {
        var nameEl = document.getElementById('mintName')
        var descEl = document.getElementById('mintDesc')
        var imageEl = document.getElementById('mintImage')
        var symbolEl = document.getElementById('mintSymbol')
        var statusEl = document.getElementById('mintStatus')

        var nftName = nameEl ? nameEl.value.trim() : ''
        if (!nftName) {
          alert('NFT name is required')
          return
        }

        btn.disabled = true
        btn.textContent = 'Minting on-chain...'
        if (statusEl) {
          statusEl.style.display = ''
          statusEl.textContent = 'Sending transaction to Solana devnet...'
          statusEl.style.color = '#6b7280'
        }

        fetch(LAYOUT_API + '/marketplace/nfts/mint-to-collection', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            collectionMint: collectionMint,
            name: nftName,
            description: descEl ? descEl.value.trim() : '',
            imageUrl: imageEl ? imageEl.value.trim() : '',
            symbol: symbolEl ? symbolEl.value.trim() : ''
          })
        })
        .then(function(res) { return res.json() })
        .then(function(data) {
          if (data.error) {
            if (statusEl) {
              statusEl.textContent = data.error
              statusEl.style.color = '#dc2626'
            }
            alert(data.error)
          } else {
            if (statusEl) {
              statusEl.textContent = 'Minted! Address: ' + data.nft.mintAddress
              statusEl.style.color = '#059669'
            }
            if (window.Toast) Toast.success('NFT minted successfully!')
            else alert('NFT minted successfully!')
            if (nameEl) nameEl.value = ''
            if (descEl) descEl.value = ''
            if (imageEl) imageEl.value = ''
            if (symbolEl) symbolEl.value = ''
            setTimeout(function() { window.location.reload() }, 2000)
          }
          btn.disabled = false
          btn.textContent = 'Mint NFT On-Chain'
        })
        .catch(function(err) {
          console.error('Mint failed:', err)
          if (statusEl) {
            statusEl.textContent = 'Failed to mint. Check console.'
            statusEl.style.color = '#dc2626'
          }
          btn.disabled = false
          btn.textContent = 'Mint NFT On-Chain'
        })
      }
    }
  </script>
</body>
</html>
