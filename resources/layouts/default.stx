<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <title>{{ pageTitle || 'Naked NFTs' }}</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Custom Gilroy Font */
    @font-face {
      font-family: 'Gilroy';
      font-weight: 400;
      src: url(/assets/fonts/Gilroy-Regular.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 500;
      src: url(/assets/fonts/Gilroy-Medium.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 600;
      src: url(/assets/fonts/Gilroy-SemiBold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 700;
      src: url(/assets/fonts/Gilroy-Bold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 800;
      src: url(/assets/fonts/Gilroy-ExtraBold.woff) format('woff');
    }

    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }

    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Selection Color */
    ::selection {
      background-color: #E50570;
      color: white;
    }

    /* Spinner */
    .spinner {
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Mobile drawer: full screen */
    @media (max-width: 640px) {
      [data-drawer-panel] {
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body class="antialiased font-sans bg-white text-gray-dark">
  <Header />
  @yield('content')
  <Footer />
  <Toast />
  <Drawer />
  <AuthModal />

  <script client>
    {
      var LAYOUT_API = 'http://localhost:3008'

      function nftAttrBadges(attrs) {
        if (!attrs) return ''
        var list = attrs
        if (typeof attrs === 'string') {
          try { list = JSON.parse(attrs) } catch (_) { return '' }
        }
        if (!Array.isArray(list) || list.length === 0) return ''
        var html = '<div class="mt-6"><h3 class="text-xs font-semibold text-gray-4 uppercase tracking-wider mb-3">Attributes</h3>'
          + '<div class="flex flex-wrap gap-2">'
        for (var i = 0; i < list.length; i++) {
          var a = list[i]
          var trait = a.trait_type || a.traitType || a.key || ''
          var val = a.value || ''
          if (trait || val) {
            html += '<div class="bg-pink-50 border border-pink-100 rounded-lg px-3 py-2 text-center">'
              + '<p class="text-[10px] text-pink-8 font-semibold uppercase">' + trait + '</p>'
              + '<p class="text-xs text-gray-8 font-medium">' + val + '</p>'
              + '</div>'
          }
        }
        html += '</div></div>'
        return html
      }

      function nftOfferRows(offers) {
        if (!offers || offers.length === 0) return ''
        var html = '<div class="mt-6"><h3 class="text-xs font-semibold text-gray-4 uppercase tracking-wider mb-3">Offers</h3>'
          + '<div class="space-y-2">'
        for (var i = 0; i < Math.min(offers.length, 5); i++) {
          var o = offers[i]
          var addr = o.bidder_address || o.buyer_address || ''
          var short = addr ? addr.slice(0,4) + '...' + addr.slice(-4) : 'Unknown'
          html += '<div class="flex items-center justify-between bg-gray-50 rounded-lg px-3 py-2">'
            + '<span class="text-sm text-gray-5 font-mono">' + short + '</span>'
            + '<span class="text-sm font-semibold text-gray-8">' + Number(o.amount || 0).toFixed(2) + ' SOL</span>'
            + '</div>'
        }
        html += '</div></div>'
        return html
      }

      window.NFTModal = {
        open: async function(nftId) {
          if (!window.DrawerManager) return
          DrawerManager.setContent(
            '<div class="flex flex-col items-center justify-center h-64">'
            + '<div class="spinner h-8 w-8 border-4 border-pink-8 border-t-transparent rounded-full"></div>'
            + '<p class="mt-4 text-sm text-gray-4">Loading NFT details...</p>'
            + '</div>'
          )
          DrawerManager.open()
          try {
            var res = await fetch(LAYOUT_API + '/marketplace/nfts/' + nftId)
            var data = await res.json()
            var nft = data.nft || data
            var name = nft.name || 'NFT #' + nftId
            var img = nft.image_url || '/assets/images/anonymouse.png'
            var owner = nft.owner_wallet_address || nft.owner_address || ''
            var shortOwner = owner ? owner.slice(0,6) + '...' + owner.slice(-4) : ''
            var price = nft.listing_price ? (nft.listing_price / 1e9) : nft.price
            var collName = nft.collection_name || ''
            var collSlug = nft.collection_slug || ''

            var html = ''
              // Image
              + '<div class="relative">'
              + '<img src="' + img + '" alt="' + name + '" class="w-full aspect-square object-cover" onerror="this.onerror=null;this.src=\'/assets/images/anonymouse.png\'" />'
              + (nft.rarity_rank ? '<div class="absolute top-4 left-4 bg-black/70 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full">Rank #' + nft.rarity_rank + '</div>' : '')
              + (nft.is_for_sale ? '<div class="absolute top-4 right-4 bg-pink-8 text-white text-xs font-bold px-3 py-1.5 rounded-full">For Sale</div>' : '')
              + '</div>'

              // Content
              + '<div class="p-6">'

              // Collection link
              + (collName ? '<a href="/collections/' + collSlug + '" class="text-xs font-semibold text-pink-8 uppercase tracking-wider hover:text-pink-9">' + collName + '</a>' : '')

              // Name
              + '<h2 class="text-2xl font-bold text-gray-9 mt-1">' + name + '</h2>'

              // Description
              + (nft.description ? '<p class="text-gray-5 mt-2 text-sm leading-relaxed">' + nft.description + '</p>' : '')

              // Price card
              + (price ? '<div class="mt-6 bg-gray-50 rounded-xl p-4"><div class="flex items-center justify-between"><div><p class="text-xs text-gray-4 font-medium uppercase">Current Price</p><p class="text-2xl font-bold text-gray-9 mt-0.5">' + Number(price).toFixed(2) + ' <span class="text-sm font-semibold text-gray-5">SOL</span></p></div>' + (nft.is_for_sale ? '<button onclick="NFTModal.buy(' + nftId + ', ' + price + ')" class="bg-pink-8 hover:bg-pink-9 text-white font-semibold px-6 py-2.5 rounded-lg transition text-sm">Buy Now</button>' : '') + '</div></div>' : '')

              // Details grid
              + '<div class="mt-6 grid grid-cols-2 gap-3">'
              + (nft.token_id ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Token ID</p><p class="text-sm text-gray-8 font-medium font-mono truncate">' + nft.token_id + '</p></div>' : '')
              + (shortOwner ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Owner</p><p class="text-sm text-gray-8 font-medium font-mono">' + shortOwner + '</p></div>' : '')
              + (nft.rarity_score ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Rarity Score</p><p class="text-sm text-gray-8 font-medium">' + Number(nft.rarity_score).toFixed(2) + '</p></div>' : '')
              + (nft.mint_address ? '<div class="bg-gray-50 rounded-lg px-3 py-2.5"><p class="text-[10px] text-gray-4 font-semibold uppercase">Mint</p><p class="text-sm text-gray-8 font-medium font-mono truncate">' + nft.mint_address.slice(0,8) + '...' + nft.mint_address.slice(-4) + '</p></div>' : '')
              + '</div>'

              // Attributes
              + nftAttrBadges(nft.attributes)

              // Offers
              + nftOfferRows(nft.offers)

              // Active auction
              + (nft.auction ? '<div class="mt-6 bg-purple-50 border border-purple-100 rounded-xl p-4"><div class="flex items-center justify-between"><div><p class="text-xs text-purple-600 font-semibold uppercase">Active Auction</p><p class="text-lg font-bold text-gray-9 mt-0.5">' + Number(nft.auction.current_bid || nft.auction.starting_price || 0).toFixed(2) + ' SOL</p><p class="text-xs text-gray-5">Ends ' + new Date(nft.auction.end_time).toLocaleDateString() + '</p></div><button onclick="NFTModal.bid(' + nftId + ')" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-5 py-2.5 rounded-lg transition text-sm">Place Bid</button></div></div>' : '')

              // Action buttons (when no price shown above)
              + (!price && !nft.auction ? '<div class="mt-6 flex gap-3"><button onclick="NFTModal.offer(' + nftId + ')" class="flex-1 bg-pink-8 hover:bg-pink-9 text-white font-semibold py-3 rounded-lg transition text-sm">Make Offer</button></div>' : '')

              // Mint address explorer link
              + (nft.mint_address ? '<div class="mt-6 pt-4 border-t border-gray-100"><a href="https://explorer.solana.com/address/' + nft.mint_address + '?cluster=devnet" target="_blank" class="flex items-center justify-center text-sm text-gray-4 hover:text-pink-8 transition"><svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>View on Explorer</a></div>' : '')

              + '</div>'

            DrawerManager.setContent(html)
          } catch (err) {
            DrawerManager.setContent(
              '<div class="flex flex-col items-center justify-center py-20 px-6">'
              + '<svg class="h-12 w-12 text-gray-3 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" /></svg>'
              + '<p class="text-gray-5 text-sm">Failed to load NFT details</p>'
              + '</div>'
            )
          }
        },
        buy: function(nftId, price) {
          if (window.Toast) Toast.warning('Purchase flow coming soon — ' + Number(price).toFixed(2) + ' SOL')
        },
        offer: function(nftId) {
          if (window.Toast) Toast.warning('Offer flow coming soon')
        },
        bid: function(nftId) {
          if (window.Toast) Toast.warning('Bidding flow coming soon')
        }
      }
    }
  </script>
</body>
</html>
