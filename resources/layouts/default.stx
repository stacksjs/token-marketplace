<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <title>{{ pageTitle || 'Naked NFTs' }}</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Custom Gilroy Font */
    @font-face {
      font-family: 'Gilroy';
      font-weight: 400;
      src: url(/assets/fonts/Gilroy-Regular.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 500;
      src: url(/assets/fonts/Gilroy-Medium.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 600;
      src: url(/assets/fonts/Gilroy-SemiBold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 700;
      src: url(/assets/fonts/Gilroy-Bold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 800;
      src: url(/assets/fonts/Gilroy-ExtraBold.woff) format('woff');
    }

    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }

    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Selection Color */
    ::selection {
      background-color: #E50570;
      color: white;
    }

    /* Spinner */
    .spinner {
      animation: spin 1s linear infinite;
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Mobile drawer: full screen */
    @media (max-width: 640px) {
      [data-drawer-panel] {
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body class="antialiased font-sans bg-white text-gray-dark">
  <Header />
  @yield('content')
  <Footer />
  <Toast />
  <Drawer />
  <AuthModal />

  <script client>
    {
      var LAYOUT_API = 'http://localhost:3008'

      window.NFTModal = {
        open: async function(nftId) {
          if (!window.DrawerManager) return
          DrawerManager.setContent('<div class="flex justify-center py-12"><div class="spinner h-8 w-8 border-4 border-pink-8 border-t-transparent rounded-full"></div></div>')
          DrawerManager.open()
          try {
            var res = await fetch(LAYOUT_API + '/marketplace/nfts/' + nftId)
            var data = await res.json()
            var nft = data.nft || data
            var html = '<div class="p-6">'
              + '<div class="aspect-square rounded-xl overflow-hidden mb-6"><img src="' + (nft.image_url || '/assets/images/placeholder.png') + '" alt="' + (nft.name || '') + '" class="w-full h-full object-cover" /></div>'
              + '<h2 class="text-2xl font-bold text-gray-9">' + (nft.name || 'NFT #' + nftId) + '</h2>'
              + (nft.description ? '<p class="text-gray-5 mt-2">' + nft.description + '</p>' : '')
              + '<div class="mt-4 space-y-2">'
              + (nft.rarity_rank ? '<div class="flex justify-between text-sm"><span class="text-gray-5">Rarity Rank</span><span class="font-semibold text-gray-8">#' + nft.rarity_rank + '</span></div>' : '')
              + (nft.price ? '<div class="flex justify-between text-sm"><span class="text-gray-5">Price</span><span class="font-semibold text-pink-8">' + nft.price + ' SOL</span></div>' : '')
              + (nft.owner_address ? '<div class="flex justify-between text-sm"><span class="text-gray-5">Owner</span><span class="font-mono text-gray-8">' + nft.owner_address.slice(0,4) + '...' + nft.owner_address.slice(-4) + '</span></div>' : '')
              + '</div>'
            if (nft.is_for_sale && nft.price) {
              html += '<button onclick="NFTModal.buy(' + nftId + ')" class="w-full mt-6 bg-pink-8 hover:bg-pink-9 text-white font-semibold py-3 rounded-lg transition">Buy Now</button>'
            }
            html += '</div>'
            DrawerManager.setContent(html)
          } catch (err) {
            DrawerManager.setContent('<div class="p-6 text-center text-gray-5">Failed to load NFT details</div>')
          }
        },
        buy: async function(nftId) {
          if (window.Toast) Toast.warning('Purchase flow coming soon')
        }
      }
    }
  </script>
</body>
</html>
