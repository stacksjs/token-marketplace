<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Discover & collect NFTs in the world's first cross-chain marketplace">
  <title>@yield('title', 'Naked NFTs')</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    /* Custom Gilroy Font */
    @font-face {
      font-family: 'Gilroy';
      font-weight: 400;
      src: url(/fonts/Gilroy-Regular.woff2) format('woff2'),
           url(/fonts/Gilroy-Regular.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 500;
      src: url(/fonts/Gilroy-Medium.woff2) format('woff2'),
           url(/fonts/Gilroy-Medium.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 600;
      src: url(/fonts/Gilroy-SemiBold.woff2) format('woff2'),
           url(/fonts/Gilroy-SemiBold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 700;
      src: url(/fonts/Gilroy-Bold.woff2) format('woff2'),
           url(/fonts/Gilroy-Bold.woff) format('woff');
    }
    @font-face {
      font-family: 'Gilroy';
      font-weight: 800;
      src: url(/fonts/Gilroy-ExtraBold.woff2) format('woff2'),
           url(/fonts/Gilroy-ExtraBold.woff) format('woff');
    }

    /* Custom Gradients */
    .bg-hero-gradient {
      background: linear-gradient(45deg, #010123 0%, #010124 53.95%, #010125 100%);
    }
    .bg-cta-gradient {
      background: linear-gradient(95.34deg, #010120 1.04%, #07073b 93.77%);
    }

    /* Minting Live Animation */
    .blink {
      animation: blink 1.5s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    /* Selection Color */
    ::selection {
      background-color: #E50570;
      color: white;
    }
  </style>
</head>
<body class="antialiased font-sans bg-white text-gray-dark">
  @yield('content')
</body>
</html>
